#!/bin/sh
# Local registry gate for pushed commits. Activate once per clone (the same
# setting enables the pre-commit gate):
#   git config core.hooksPath scripts/git-hooks
# Runs the three repository registry tests that failed CI's validate job on
# 2026-09-27 (#416, #425-#429) against the tip commit of each pushed ref. Like
# CI, which tests one commit per pull request, it does not test the commits
# between a ref's old and new tip. It fails closed when zizmor is missing and
# there is a commit to test, because the workflow-coverage class skips without
# it, and a skip is not a pass. `git push --no-verify` is the explicit, visible
# override. CI (validate.yml) still runs the whole suite.
#
# githooks(5), pre-push: stdin carries "<local ref> <local oid> <remote ref>
# <remote oid>" lines, and a non-zero exit aborts the push. The all-zero oid and
# the read loop follow git's templates/hooks--pre-push.sample; a deletion has
# nothing to test.
#
# Each tip commit is checked out into a detached worktree under TMPDIR and
# tested there, not in this working tree: the tests read `git ls-files` and glob
# files (blueprints/**/*.json, .github/workflows/*.yml), so uncommitted edits,
# untracked or ignored files, or a pushed ref other than HEAD would test
# something other than what is pushed. Measured 2026-09-27 on the 7,910-file
# tree: 1.1 s checkout, 0.3 s tests and 0.2 s removal per commit, against
# 0.3 s for the tests alone in place. TMPDIR must be outside every repository.
# It defaults to /var/tmp, not /tmp: the checkout is about 140 MB, and
# file-hierarchy(7) keeps /tmp, usually a tmpfs, for small files and /var/tmp
# for larger ones.
set -eu
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
commits=
local_ref=
while read -r local_ref local_oid remote_ref remote_oid || [ -n "$local_ref" ]; do
  if [ -z "$local_ref" ] || [ "$local_oid" = "$zero" ]; then
    local_ref=
    continue
  fi
  if ! commit=$(git rev-parse --verify --quiet "$local_oid^{commit}"); then
    echo "pre-push: $local_ref ($local_oid) is not a commit the registry tests can check out. Push refused; \`git push --no-verify\` overrides." >&2
    exit 1
  fi
  case " $commits " in
    *" $commit "*) ;;
    *) commits="$commits $commit" ;;
  esac
  local_ref=
done
[ -n "$commits" ] || exit 0

if ! command -v zizmor >/dev/null 2>&1; then
  echo "pre-push: zizmor not on PATH; install the pinned zizmor 1.30.1 (.github/requirements-ci.txt; see blueprints/convergence-practice/ci-security/README.md). Push refused." >&2
  exit 1
fi

scratch=$(mktemp -d "${TMPDIR:-/var/tmp}/pre-push.XXXXXX")
tree="$scratch/tree"
cleanup() {
  # A reader that has gone, or a failed removal, must not stop the rest.
  set +e
  trap '' PIPE
  if [ -e "$tree" ]; then
    git worktree remove --force "$tree" ||
      echo "pre-push: could not remove the worktree $tree; delete it, then run \`git worktree prune\`." >&2
  fi
  rm -rf "$scratch"
}
# A signal that kills the shell skips the EXIT trap, so the signals that stop a
# push in practice exit through it: hangup, interrupt, quit, a closed reader
# and termination, as Autoconf's configure traps 1, 2, 13 and 15
# (lib/autoconf/general.m4). SIGPIPE comes from a reader that closed early, as
# in `git push 2>&1 | head -n 1`.
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 141' PIPE
trap 'exit 143' TERM

# Git's own discovery decides, as for any git command run under TMPDIR. An empty
# .git directory, such as the mount point a sandbox can leave in /tmp, is not a
# repository to git, so it is not refused. Git exports GIT_DIR to hooks
# (githooks(5); a push from a linked worktree gets it), and GIT_DIR turns
# discovery off, so the subshell drops it first.
if gitdir=$(unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR; cd "$scratch" && git rev-parse --absolute-git-dir 2>/dev/null); then
  echo "pre-push: the temporary directory $scratch is inside the git repository $gitdir; set TMPDIR to a directory outside every repository. Push refused." >&2
  exit 1
fi
mkdir "$scratch/tmp"

# All three tests must run and pass: a skip or an expected failure is not a pass.
# The runner puts the checked-out tree first on sys.path itself: under -P or
# PYTHONSAFEPATH, `python3 -c` leaves the working directory off, and a
# PYTHONPATH naming another checkout would then supply the tests.
runner='import os, sys, unittest
sys.path.insert(0, os.getcwd())
names = sys.argv[1:]
result = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromNames(names))
passed = result.testsRun == len(names) and result.wasSuccessful() and not result.skipped and not result.expectedFailures
sys.exit(0 if passed else 1)'
status=0
for commit in $commits; do
  echo "pre-push: running the registry tests on $commit in $tree" >&2
  git -c core.hooksPath=/dev/null worktree add --quiet --detach "$tree" "$commit"
  if ! (cd "$tree" && TMPDIR="$scratch/tmp" PYTHONDONTWRITEBYTECODE=1 python3 -c "$runner" \
    tests.test_osv_lockfile_coverage.LockfileInventoryTests.test_every_tracked_lockfile_and_manifest_is_listed \
    tests.test_blind_checkout.RepositoryClassificationTests.test_every_blueprint_value_under_a_label_key_is_classified \
    tests.test_workflow_security_coverage.NewWorkflowSecurityCoverageTests.test_all_published_workflows_are_listed_and_covered \
    </dev/null); then
    echo "pre-push: the registry tests failed or skipped on $commit. Push refused; \`git push --no-verify\` overrides." >&2
    status=1
  fi
  git worktree remove --force "$tree"
done
exit "$status"
