# hcom integration - auto-approve safe commands
prefix_rule(pattern=["hcom", "send"], decision="allow")
prefix_rule(pattern=["hcom", "start"], decision="allow")
prefix_rule(pattern=["hcom", "help"], decision="allow")
prefix_rule(pattern=["hcom", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "list"], decision="allow")
prefix_rule(pattern=["hcom", "events"], decision="allow")
prefix_rule(pattern=["hcom", "listen"], decision="allow")
prefix_rule(pattern=["hcom", "relay"], decision="allow")
prefix_rule(pattern=["hcom", "config"], decision="allow")
prefix_rule(pattern=["hcom", "transcript"], decision="allow")
prefix_rule(pattern=["hcom", "archive"], decision="allow")
prefix_rule(pattern=["hcom", "bundle"], decision="allow")
prefix_rule(pattern=["hcom", "status"], decision="allow")
prefix_rule(pattern=["hcom", "term"], decision="allow")
prefix_rule(pattern=["hcom", "hooks"], decision="allow")
prefix_rule(pattern=["hcom", "--version"], decision="allow")
prefix_rule(pattern=["hcom", "-v"], decision="allow")
prefix_rule(pattern=["hcom", "--new-terminal"], decision="allow")
prefix_rule(pattern=["hcom", "claude", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "claude", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "gemini", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "gemini", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "codex", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "codex", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "opencode", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "opencode", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "antigravity", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "antigravity", "-h"], decision="allow")
prefix_rule(pattern=["hcom", "agy", "--help"], decision="allow")
prefix_rule(pattern=["hcom", "agy", "-h"], decision="allow")
