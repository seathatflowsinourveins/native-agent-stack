HEN NEW.workspace_id IS NOT (SELECT workspace_id FROM projects WHERE id = NEW.project_id)\nBEGIN\n    SELECT RAISE(ABORT, 'auto_improve_proposals.workspace_id does not match the project''s workspace');\nEND;\n",
