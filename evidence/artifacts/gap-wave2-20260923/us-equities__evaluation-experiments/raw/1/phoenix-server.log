CREATE TABLE _alembic_tmp_refresh_tokens (
	id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, 
	user_id INTEGER NOT NULL, 
	created_at TIMESTAMP DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	expires_at TIMESTAMP NOT NULL, 
	oauth2_grant_id INTEGER, 
	scopes JSONB, 
	audience JSONB, 
	consumed_at TIMESTAMP, 
	CONSTRAINT fk_refresh_tokens_user_id_users FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE, 
	CONSTRAINT fk_refresh_tokens_oauth2_grant_id_oauth2_grants FOREIGN KEY(oauth2_grant_id) REFERENCES oauth2_grants (id) ON DELETE CASCADE
)


