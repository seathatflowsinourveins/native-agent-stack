## narrow config (2026-09-25)
[hooks]
exclude_commands = ['^git show [^ ]*:', "diff"]
## wide config (2026-09-26)
[hooks]
exclude_commands = ['^git(\s+\S+)*\s+show(\s+\S+)*\s+(:\S|[^\s-]\S*:)', "diff"]
tomllib read-back: ['^git(\\s+\\S+)*\\s+show(\\s+\\S+)*\\s+(:\\S|[^\\s-]\\S*:)', 'diff']
