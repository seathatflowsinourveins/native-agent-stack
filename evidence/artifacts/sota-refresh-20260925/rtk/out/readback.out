--- ~/.config/rtk/config.toml
[hooks]
exclude_commands = ["^git show [^ ]*:", "diff"]
---
rtk hook check rc=1 [git show HEAD:x | tail -n 5] :: No rewrite for: git show HEAD:x | tail -n 5
rtk hook check rc=1 [diff a.txt missing.txt] :: No rewrite for: diff a.txt missing.txt
rtk hook check rc=0 [git show HEAD~1] :: rtk git show HEAD~1
rtk hook check rc=0 [git diff] :: rtk git diff
