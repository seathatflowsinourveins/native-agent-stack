+/**
+ * #8940 OAuth session-occupancy re-pick, moved from getProviderCredentials (auth.ts)
+ * with the same logic, like the rest of this leaf, so that auth.ts shrinks and the
+ * fresh-pin path below can apply it before the pin is written. Returns `selected`
+ * unless it is OAuth and an OAuth candidate with priority <= selected + 1 has
+ * strictly higher availability (fewer foreign sessions).
+ */
+export function pickMoreAvailableOAuthPeer<T extends SessionAffinityConnection>(
+  selected: T,
+  candidates: T[],
+  sessionKey: string | null | undefined
+): T {
+  if (selected.authType !== "oauth") return selected;
+  const selectedPriority = selected.priority || 999;
+  const selectedAvailability = getOAuthSessionAvailability(selected.id, sessionKey);
+  const moreAvailablePeer = [...candidates]
+    .filter(
+      (candidate) =>
+        candidate.authType === "oauth" && (candidate.priority || 999) <= selectedPriority + 1
+    )
+    .sort(
+      (a, b) =>
+        getOAuthSessionAvailability(b.id, sessionKey) -
+        getOAuthSessionAvailability(a.id, sessionKey)
+    )
+    .find(
+      (candidate) => getOAuthSessionAvailability(candidate.id, sessionKey) > selectedAvailability
+    );
+  return moreAvailablePeer ?? selected;
+}
+
 /**
  * Session-affinity account selection (moved from auth.ts alongside the #5903
  * pin-override so all session-affinity logic lives in one leaf). Reuses an
- * active pin when its connection is in the pool; otherwise picks the LRU
- * connection and creates a fresh pin. Behavior byte-identical to the original.
+ * active pin when its connection is in the pool, and getProviderCredentials
+ * then skips its occupancy re-pick (#8939/#8940: same-session affinity outranks
+ * occupancy). Otherwise it picks the LRU connection, lets the occupancy re-pick
+ * replace that pick, and pins the result; the read, that decision and the pin
+ * write run without an intervening await, so the pin names the account
+ * selected for dispatch.
  */
 export async function selectSessionAffinityConnection<T extends SessionAffinityConnection>(
   provider: string,
@@ -303,8 +340,9 @@ export async function selectSessionAffinityConnection<T extends SessionAffinityC
     );
   }
 
-  const connection = [...connections].sort(compareLruConnections)[0] ?? null;
-  if (!connection) return null;
+  const lruPick = [...connections].sort(compareLruConnections)[0] ?? null;
+  if (!lruPick) return null;
+  const connection = pickMoreAvailableOAuthPeer(lruPick, connections, sessionKey);
 
   upsertSessionAccountAffinity(sessionKey, provider, connection.id, Date.now(), ttlMs);
   await touchConnectionLastUsed(connection.id, 1);
diff --git a/tests/unit/affinity-outranks-occupancy-8940.test.ts b/tests/unit/affinity-outranks-occupancy-8940.test.ts
new file mode 100644
index 0000000000..8ab5b5c1e8
--- /dev/null
+++ b/tests/unit/affinity-outranks-occupancy-8940.test.ts
@@ -0,0 +1,270 @@
+// #8940 follow-up: same-session affinity must stay stronger than OAuth session
+// occupancy (#8939/#8940). getProviderCredentials picks the session's connection
+// through selectSessionAffinityConnection and, with reserveOAuthSession (set on
+// chat.ts's dispatch call, chat.ts:1711, not on the combo availability check,
+// chat.ts:1096-1108, or on preselected API-key credentials, chat.ts:1701-1703 and
+// 1119-1121), then re-picked any OAuth peer with fewer foreign sessions. That
+// re-pick also moved REUSED pins, so a pinned session was served off-pin while
+// the pin itself stayed put.
+//
+// Fix under test:
+// - src/sse/services/sessionAffinityPin.ts: a fresh pin takes the occupancy
+//   re-pick (pickMoreAvailableOAuthPeer) before it is written, with no await
+//   between the pin read, that decision and the pin write, so the pin names the
+//   account selected for dispatch for every non-lease caller, the combo
+//   availability check included;
+// - src/sse/services/auth.ts: after a non-lease affinity selection the occupancy
+//   re-pick is skipped (flag-and-skip adapted from #13102), so a reused eligible
+//   pin is served; an ineligible pin is not in the pool, so it is not reused.
+//   auth.ts itself neither reads nor writes pins.
+//
+// Drives auth.getProviderCredentials directly with the call shapes chat.ts uses
+// (sessionKey + reserveOAuthSession: true for the dispatch, sessionKey alone for
+// the combo availability check), like the #5903 affinity test; the chat.ts,
+// quota-preflight and combo layers are not exercised.
+// Fixture note: createProviderConnection does not persist lastUsedAt, so every
+// seeded connection is never-used and the affinity LRU pick falls back to
+// priority (compareLruConnections); explicit priorities make that pick exact.
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-affinity-occupancy-8940-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "affinity-occupancy-8940-test-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const settingsDb = await import("../../src/lib/db/settings.ts");
+const apiKeysDb = await import("../../src/lib/db/apiKeys.ts");
+const affinityDb = await import("../../src/lib/db/sessionAccountAffinity.ts");
+const auth = await import("../../src/sse/services/auth.ts");
+const occupancy = await import("../../open-sse/services/oauthSessionOccupancy.ts");
+
+const PROVIDER = "codex";
+const MODEL = "gpt-5.5";
+const TTL_MS = 60_000;
+
+type Selection = { connectionId?: string; releaseOAuthSession?: () => void } | null;
+type SelectionOptions = NonNullable<Parameters<typeof auth.getProviderCredentials>[4]>;
+
+async function resetStorage() {
+  core.resetDbInstance();
+  apiKeysDb.resetApiKeyState();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+async function seedConnection(name: string, priority: number): Promise<{ id: string }> {
+  const connection = await providersDb.createProviderConnection({
+    provider: PROVIDER,
+    authType: "oauth",
+    name,
+    accessToken: `at-${Math.random().toString(16).slice(2, 10)}`,
+    isActive: true,
+    testStatus: "active",
+    priority,
+    providerSpecificData: {},
+  });
+  assert.ok(connection, "createProviderConnection returned no connection");
+  assert.equal(typeof connection.id, "string");
+  return { id: connection.id as string };
+}
+
+async function select(options: SelectionOptions): Promise<Selection> {
+  return (await auth.getProviderCredentials(PROVIDER, null, null, MODEL, options)) as Selection;
+}
+
+async function selectForSession(sessionKey: string): Promise<Selection> {
+  return select({ sessionKey, reserveOAuthSession: true });
+}
+
+/** One finished turn: select, then release the turn's own occupancy as chat.ts does. */
+async function turn(sessionKey: string): Promise<string | undefined> {
+  const selection = await selectForSession(sessionKey);
+  selection?.releaseOAuthSession?.();
+  return selection?.connectionId;
+}
+
+function pinnedConnectionId(sessionKey: string): string | undefined {
+  return affinityDb.getSessionAccountAffinity(sessionKey, PROVIDER, TTL_MS)?.connectionId;
+}
+
+test.beforeEach(async () => {
+  occupancy._clearOAuthSessionOccupancyForTest();
+  await resetStorage();
+  await settingsDb.updateSettings({ sessionAffinityTtlMs: TTL_MS });
+});
+
+test.after(async () => {
+  occupancy._clearOAuthSessionOccupancyForTest();
+  core.resetDbInstance();
+  apiKeysDb.resetApiKeyState();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+test("(a) a reused eligible pin is served even when an OAuth peer is less occupied", async () => {
+  const pinned = await seedConnection("codex-8940-a-pinned", 1);
+  const peer = await seedConnection("codex-8940-a-peer", 2);
+
+  assert.equal(await turn("session-a"), pinned.id);
+  assert.equal(pinnedConnectionId("session-a"), pinned.id);
+
+  // Another session now occupies the pinned account; the peer has none and is
+  // inside the occupancy re-pick's priority window (<= selected + 1).
+  const releaseForeign = occupancy.reserveOAuthSession(pinned.id, "session-a-foreign");
+  assert.ok(
+    occupancy.getOAuthSessionAvailability(peer.id, "session-a") >
+      occupancy.getOAuthSessionAvailability(pinned.id, "session-a"),
+    "precondition: the peer is less occupied than the pinned account"
+  );
+
+  assert.equal(
+    await turn("session-a"),
+    pinned.id,
+    "the reused pin must be served, not the less-occupied peer"
+  );
+  assert.equal(pinnedConnectionId("session-a"), pinned.id);
+  releaseForeign();
+});
+
+test("(b) a rate-limited pin is not reused: the session moves and occupancy still decides", async () => {
+  const pinned = await seedConnection("codex-8940-b-pinned", 1);
+  const lru = await seedConnection("codex-8940-b-lru", 2);
+  const free = await seedConnection("codex-8940-b-free", 3);
+
+  assert.equal(await turn("session-b"), pinned.id);
+  assert.equal(pinnedConnectionId("session-b"), pinned.id);
+
+  // The pinned account is rate-limited: the pool filter drops a rate-limited
+  // connection (auth.ts:1558-1561), so the pin is not reused. Another session
+  // occupies the next LRU pick.
+  await providersDb.updateProviderConnection(pinned.id, {
+    rateLimitedUntil: new Date(Date.now() + 60_000).toISOString(),
+  });
+  const releaseForeign = occupancy.reserveOAuthSession(lru.id, "session-b-foreign");
+
+  const served = await turn("session-b");
+  assert.notEqual(served, pinned.id, "a rate-limited pin must not be served");
+  assert.equal(served, free.id, "occupancy still decides the new binding, as before the fix");
+  assert.equal(
+    pinnedConnectionId("session-b"),
+    served,
+    "the new pin names the account selected for dispatch"
+  );
+  releaseForeign();
+});
+
+/** Fresh session whose LRU pick (`lru`, lower priority number) is occupied by another session. */
+async function firstTurnOnOccupiedLru() {
+  const lru = await seedConnection("codex-8940-c-lru", 1);
+  const free = await seedConnection("codex-8940-c-free", 2);
+  const releaseForeign = occupancy.reserveOAuthSession(lru.id, "session-c-foreign");
+  const served = await turn("session-c");
+  return { lru, free, served, releaseForeign };
+}
+
+test("(c) a fresh session on an occupied LRU pick: occupancy moves it and the pin names the account selected for dispatch", async () => {
+  const { lru, free, served, releaseForeign } = await firstTurnOnOccupiedLru();
+  assert.notEqual(served, lru.id, "occupancy keeps deciding cold bindings");
+  assert.equal(served, free.id);
+  assert.equal(
+    pinnedConnectionId("session-c"),
+    served,
+    "the stored pin must name the account selected for dispatch"
+  );
+  releaseForeign();
+});
+
+test("(d) the next turn of (c) is served on the same account with no occupancy move", async () => {
+  const { lru, free, served, releaseForeign } = await firstTurnOnOccupiedLru();
+  assert.equal(served, free.id);
+
+  // Two other sessions now hold the served account, so an occupancy re-pick
+  // would move this turn back to `lru` (one foreign session); the pin must hold.
+  const releaseOthers = [
+    occupancy.reserveOAuthSession(free.id, "session-d-foreign-1"),
+    occupancy.reserveOAuthSession(free.id, "session-d-foreign-2"),
+  ];
+  assert.ok(
+    occupancy.getOAuthSessionAvailability(lru.id, "session-c") >
+      occupancy.getOAuthSessionAvailability(free.id, "session-c"),
+    "precondition: an occupancy re-pick would prefer the other account"
+  );
+
+  assert.equal(pinnedConnectionId("session-c"), served);
+  assert.equal(await turn("session-c"), served, "the next turn stays on the account served in (c)");
+  assert.equal(pinnedConnectionId("session-c"), served);
+  for (const release of releaseOthers) release();
+  releaseForeign();
+});
+
+test("(e) the combo availability check pins the less-occupied peer, and the dispatch turn serves that pin", async () => {
+  const lru = await seedConnection("codex-8940-e-lru", 1);
+  const peer = await seedConnection("codex-8940-e-peer", 2);
+  const releaseForeign = occupancy.reserveOAuthSession(lru.id, "session-e-foreign");
+
+  // The chat.ts:1096-1108 call shape: a session key and no reserveOAuthSession. The
+  // dispatch that follows (chat.ts:1704-1711) reuses the pin this check writes.
+  await select({ sessionKey: "session-e" });
+  assert.equal(
+    pinnedConnectionId("session-e"),
+    peer.id,
+    "the check's fresh pin is the less-occupied peer, not the occupied LRU pick"
+  );
+
+  assert.equal(await turn("session-e"), peer.id, "the dispatch turn serves the pinned peer");
+  assert.equal(pinnedConnectionId("session-e"), peer.id);
+  releaseForeign();
+});
+
+test("(f) concurrent first selections on different selection locks leave the newer pin in place", async () => {
+  const lru = await seedConnection("codex-8940-f-lru", 1);
+  await seedConnection("codex-8940-f-peer", 2);
+  const forced = await seedConnection("codex-8940-f-forced", 3);
+  const releaseForeign = occupancy.reserveOAuthSession(lru.id, "session-f-foreign");
+
+  // One new session, two first requests on different selection-mutex keys
+  // (getSelectionMutexKey in auth.ts): a reserving pool selection whose LRU pick is
+  // occupied, and a forcedConnectionId selection. The pin is written once per
+  // selection, inside the affinity leaf, so no later second write can replace the
+  // forced selection's newer pin.
+  const [pooled, forcedSelection] = await Promise.all([
+    select({ sessionKey: "session-f", reserveOAuthSession: true }),
+    select({ sessionKey: "session-f", forcedConnectionId: forced.id }),
+  ]);
+  pooled?.releaseOAuthSession?.();
+  forcedSelection?.releaseOAuthSession?.();
+
+  assert.equal(forcedSelection?.connectionId, forced.id);
+  assert.equal(pinnedConnectionId("session-f"), forced.id, "the stored pin is the forced account");
+  releaseForeign();
+});
+
+test("(g) an expired pin on the LRU pick is not reused: occupancy decides the fresh pin", async () => {
+  const lru = await seedConnection("codex-8940-g-lru", 1);
+  const peer = await seedConnection("codex-8940-g-peer", 2);
+
+  // Expired when written (expiresAt = now - TTL + TTL; a read treats expiresAt <= now
+  // as expired). The affinity leaf's single read decides reuse versus a fresh pin.
+  affinityDb.upsertSessionAccountAffinity(
+    "session-g",
+    PROVIDER,
+    lru.id,
+    Date.now() - TTL_MS,
+    TTL_MS
+  );
+  const releaseForeign = occupancy.reserveOAuthSession(lru.id, "session-g-foreign");
+
+  const served = await turn("session-g");
+  assert.equal(served, peer.id, "occupancy decides the binding that replaces an expired pin");
+  assert.equal(
+    pinnedConnectionId("session-g"),
+    served,
+    "the pin names the account selected for dispatch"
+  );
+  releaseForeign();
+});
