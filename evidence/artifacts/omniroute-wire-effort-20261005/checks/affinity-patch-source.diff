+/**
+ * #8940 OAuth session-occupancy re-pick, moved from getProviderCredentials (auth.ts)
+ * with the same logic, like the rest of this leaf, so that auth.ts shrinks and the
+ * fresh-pin path below can apply it before the pin is written. Returns `selected`
+ * unless it is OAuth and an OAuth candidate with priority <= selected + 1 has
+ * strictly higher availability (fewer foreign sessions).
+ */
+export function pickMoreAvailableOAuthPeer<T extends SessionAffinityConnection>(
+  selected: T,
+  candidates: T[],
+  sessionKey: string | null | undefined
+): T {
+  if (selected.authType !== "oauth") return selected;
+  const selectedPriority = selected.priority || 999;
+  const selectedAvailability = getOAuthSessionAvailability(selected.id, sessionKey);
+  const moreAvailablePeer = [...candidates]
+    .filter(
+      (candidate) =>
+        candidate.authType === "oauth" && (candidate.priority || 999) <= selectedPriority + 1
+    )
+    .sort(
+      (a, b) =>
+        getOAuthSessionAvailability(b.id, sessionKey) -
+        getOAuthSessionAvailability(a.id, sessionKey)
+    )
+    .find(
+      (candidate) => getOAuthSessionAvailability(candidate.id, sessionKey) > selectedAvailability
+    );
+  return moreAvailablePeer ?? selected;
+}
