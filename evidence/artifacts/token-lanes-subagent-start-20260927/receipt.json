  "probe": {
    "method": "One `claude -p` session per run in this repository's main checkout. The main session launched one Haiku subagent through the Agent tool and relayed its reply verbatim. Positive runs added the settings file below; negative runs used only the host's live settings, whose SubagentStart group runs ai-memory and not this hook. The child transcript was then inspected directly for the block's first-line marker and the SubagentStart hook entries.",
    "argv": [
      "timeout",
      "300",
      "claude",
      "-p",
      "--output-format",
      "json",
      "[--settings <scratch>/probe-settings.json]",
      "<prompt>"
    ],
    "stdin": "/dev/null",
    "cwd": "<main checkout of this repository>",
    "settings_file": {
      "hooks": {
        "SubagentStart": [
          {
            "matcher": "",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"<worktree>/adoption/hooks/claude/token-lanes-subagent-start.py\"",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    "settings_note": "The template runs the same script with `2>/dev/null || true` appended; the probe settings do not.",
    "prompts": {
      "v1": "Use the Agent tool exactly once to launch one subagent with subagent_type \"general-purpose\" and model \"haiku\". Do not use any other tool yourself, and do not answer from your own context. Give that subagent exactly this task, verbatim, and tell it to use no tools:\n\n\"Without calling any tool, look only at the context and instructions already present in your own prompt for this turn. Does that context contain a block of text whose first line starts with the exact words TOKEN LANES? Answer with a single line: YES or NO. If YES, add a second line quoting the first 60 characters of that block exactly, character for character, in quotes.\"\n\nAfter the subagent replies, return its two lines back to me verbatim and nothing else.",
      "v2": "Use the Agent tool exactly once to launch one subagent with subagent_type \"general-purpose\" and model \"haiku\". Do not use any other tool yourself, and do not answer from your own context. Give that subagent exactly this task, verbatim, and tell it to use no tools:\n\n\"Without calling any tool, look through everything already in your context for this turn other than this task message itself, including any system reminders or hook-provided context. Is there any text there that contains the phrase TOKEN LANES? Answer FOUND or NOT FOUND on the first line. If FOUND, on the second line quote exactly the 60 characters that begin with TOKEN LANES, character for character, in quotes.\"\n\nAfter the subagent replies, return its reply back to me verbatim and nothing else."
    },
