# Source: https://developers.openai.com/codex/rules
# Source: https://github.com/openai/codex/blob/a956835d020762cb2b570053af06f643a11c0ecc/codex-rs/core/src/exec_policy.rs#L394
# Converged posture: https://github.com/seathatflowsinourveins/native-agent-stack/pull/608#issuecomment-5972504465
# hcom.rules remains owned by hcom. This separate file supplies stricter decisions.
# Mandatory before use: codex execpolicy check --pretty --rules <this file> -- hcom term inject luna hi
# Prefix limits: reordered/equals-joined flags and numbered claude-pty launches,
# hcom claude, hcom [N] claude|codex, hcom r/f, other executable wrappers and
# unsplit shell scripts are outside this set. It is not an OS security boundary.
prefix_rule(
    pattern = ["hcom", ["term", "relay", "config", "hooks", "run", "kill", "stop", "reset", "update", "claude-pty", "--name", "--go"]],
    decision = "forbidden",
    justification = "Use hcom send, list, events, listen, start or status for peer transport; these listed prefixes forbid configuration and terminal-control verbs, with the coverage limits above.",
    match = ["hcom term inject luna hi", "hcom relay connect", "hcom config", "hcom hooks", "hcom run onidle", "hcom kill luna", "hcom stop", "hcom reset all", "hcom update", "hcom claude-pty", "hcom --name bigboss send @luna -- hi", "hcom --go send @luna -- hi"],
    not_match = ["hcom send @luna -- hi", "hcom list --json", "hcom events sub", "hcom listen", "hcom start", "hcom status"],
)
prefix_rule(
    pattern = ["uvx", "hcom", ["term", "relay", "config", "hooks", "run", "kill", "stop", "reset", "update", "claude-pty", "--name", "--go"]],
    decision = "forbidden",
    justification = "Use identity-bound hcom messaging; these listed uvx-hcom prefixes have the coverage limits above.",
    match = ["uvx hcom term inject luna hi", "uvx hcom relay connect", "uvx hcom config", "uvx hcom hooks", "uvx hcom run onidle", "uvx hcom kill luna", "uvx hcom stop", "uvx hcom reset all", "uvx hcom update", "uvx hcom claude-pty", "uvx hcom --name bigboss send @luna -- hi", "uvx hcom --go send @luna -- hi"],
    not_match = ["uvx hcom send @luna -- hi", "uvx hcom list --json", "uvx hcom events sub", "uvx hcom listen", "uvx hcom start", "uvx hcom status"],
)
prefix_rule(
    pattern = ["hcom", "send", ["-b", "--from"]],
    decision = "forbidden",
    justification = "Send under the session's own bound identity, without -b or --from.",
    match = ["hcom send -b @luna -- hi", "hcom send --from bigboss @luna -- hi"],
    not_match = ["hcom send @luna -- hi", "hcom list --json"],
)
prefix_rule(
    pattern = ["uvx", "hcom", "send", ["-b", "--from"]],
    decision = "forbidden",
    justification = "Send under the session's own bound identity, without -b or --from.",
    match = ["uvx hcom send -b @luna -- hi", "uvx hcom send --from bigboss @luna -- hi"],
    not_match = ["uvx hcom send @luna -- hi", "uvx hcom list --json"],
)
