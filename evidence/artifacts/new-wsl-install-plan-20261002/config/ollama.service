# Ollama 0.35.0 on NativeStack2604 (wave-2 localmodel step 4 with ruling changes 5 and 6). One GPU owner at a time:
# it is enabled only at the GPU handover; inside a GPU window it is started explicitly.
[Unit]
Description=Ollama 0.35.0 local model server (NativeStack2604; one GPU owner at a time)
After=network-online.target

[Service]
ExecCondition=/bin/sh -c 'out=$$(/usr/bin/ss -ltnH "( sport = :18231 or sport = :18232 or sport = :21434 )") || exit 255; test -z "$$out"'
ExecStart=%h/.local/share/mise/installs/ollama/0.35.0/bin/ollama serve
ExecStartPost=-%h/.local/share/new-wsl-native-stack/bin/ollama-warmup.sh
Environment=OLLAMA_HOST=127.0.0.1:21434
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_NO_CLOUD=1
TimeoutStartSec=600
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
