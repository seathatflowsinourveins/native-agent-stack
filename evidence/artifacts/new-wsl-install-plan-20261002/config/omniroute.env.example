# SOURCE-ONLY, UNRUN recipe. OmniRoute@23a11484862b3bb589a55e85b00e4ac53ffeb234 docs/reference/ENVIRONMENT.md:158-190.
# DATA_DIR is set by config/omniroute.service to %h/.local/share/omniroute;
# systemd EnvironmentFile lines do not expand a literal $HOME.
# Plain NAME=value lines: systemd's EnvironmentFile= drops `export NAME=value` lines (wave-2 gateway ruling,
# change 12). A shell exports them with `set -a; . <file>; set +a`.
OMNIROUTE_SERVER_HOST=127.0.0.1
API_HOST=127.0.0.1
PORT=21128
LIVE_WS_HOST=127.0.0.1
LIVE_WS_PORT=21129
EMBED_WS_PROXY_PORT=21131
