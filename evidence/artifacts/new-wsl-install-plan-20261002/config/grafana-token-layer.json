  "panels": [
    {
      "id": 1,
      "title": "Claude tokens",
      "type": "stat",
      "datasource": {
        "uid": "ns2604-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{instance!=\"unscoped\"}[$__range]))",
          "datasource": {
            "uid": "ns2604-prometheus"
          },
          "interval": "1m",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No observation"
        },
        "overrides": []
      },
      "description": "Native scoped counters; the 1m evaluation step retains the [1h] hourly lookback. A counter first observed after work began can undercount increase(); Prometheus created-timestamp-zero-ingestion is a separate service prerequisite."
    },
