{
  "uid": "paper-trading-live",
  "title": "Paper trading live",
  "tags": [
    "us-equities",
    "paper",
    "nautilus"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Sources",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Paper endpoint only. Live manifest page: [127.0.0.1:17610](http://127.0.0.1:17610/) (decisions, ledger intents, NautilusTrader engine log). Broker view: [Alpaca paper dashboard](https://app.alpaca.markets/paper/dashboard/overview). Metrics come from `live_manifest.py /metrics` (read-only ledger + run record); logs from the run's `events.jsonl` and NautilusTrader's JSON file log via the OpenTelemetry Collector into Loki. NautilusTrader 2.0.0rc5 ships no live dashboard of its own; its file logger is the upstream live record used here."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Decisions",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecosystem-prometheus"
          },
          "expr": "adaptive_paper_events{type=\"decision\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
