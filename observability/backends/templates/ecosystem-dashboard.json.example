{
  "uid": "ecosystem-native",
  "title": "Native agent ecosystem",
  "schemaVersion": 39,
  "version": 10,
  "links": [
    {
      "type": "link",
      "title": "Memory, RAG and token-saving results",
      "url": "/d/native-foundation-data",
      "targetBlank": false
    }
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ecosystem",
    "local"
  ],
  "description": "Native exported counters and local service health. Token panels are native-client telemetry, not estimates of savings. Cache/reasoning subsets must not be added again. Synthetic acceptance alerts are explicitly labeled. Raw prompt/tool bodies are omitted upstream by the collector.",
  "panels": [
    {
      "id": 1,
      "title": "Codex turn tokens per minute",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (token_type) (rate(ecosystem_codex_turn_token_usage_sum{instance!=\"unscoped\"}[$__rate_interval]))",
          "legendFormat": "{{token_type}}"
        }
      ],
      "options": {},
      "description": "Per-minute rate of the native per-turn histogram sums by token_type. A turn is recorded when it ends. Cached input is an input subset; reasoning output is an output subset; do not add all lines together. One series per writer: Claude sessions (session.id) and Codex processes (service.instance.id from the identity launcher) are summed at query time. Writers without an identity (instance=\"unscoped\") are excluded; the integrity panel counts them."
    },
    {
      "id": 2,
      "title": "Claude tokens per minute",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (type) (rate(ecosystem_claude_code_token_usage_tokens_total{instance!=\"unscoped\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "options": {},
      "description": "Per-minute rate of the native cumulative counters by type. Keep input, output, cacheRead and cacheCreation distinct; these are not a measured savings percentage or an invoice. One series per writer: Claude sessions (session.id) and Codex processes (service.instance.id from the identity launcher) are summed at query time. Writers without an identity (instance=\"unscoped\") are excluded; the integrity panel counts them."
    },
    {
      "id": 3,
      "title": "Service scrape health",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} \u00b7 {{instance}}"
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "HTTP response status (200 expected for local Dagu)",
      "type": "table",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (http_url, http_status_code) (ecosystem_httpcheck_status == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {},
      "description": "Active status class/code only. A Dagu401 proves its API is protected, not that a job can execute. Gateway200 proves local readiness, not provider access."
    },
    {
      "id": 5,
      "title": "Active alerts",
      "type": "table",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "title": "Collector rejected telemetry",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"otelcol_.*(refused|failed).*\"}"
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "title": "Sanitized client events",
      "type": "logs",
      "datasource": {
        "uid": "ecosystem-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"}"
        }
      ],
      "options": {}
    },
    {
      "id": 20,
      "type": "stat",
      "title": "SDK reported turn tokens (selected range)",
      "description": "Deduplicated per receipt ID in the selected dashboard range. Receipt totals are separate from native histograms; never add them together.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (receipt_id) (max_over_time({service_name=\"codex-sdk-receipt\"} | receipt_id != \"\" | unwrap total_token_count | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "SDK reported tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 21,
      "title": "WSL CPU load averages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"ecosystem_system_cpu_load_average_.*\"}",
          "legendFormat": "{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 22,
      "title": "WSL memory by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecosystem_system_memory_usage_bytes",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 23,
      "title": "WSL root filesystem by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecosystem_system_filesystem_usage_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 24,
      "title": "SDK receipts without reported usage (selected range)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (receipt_id) (count_over_time({service_name=\"codex-sdk-receipt\"} | receipt_id != \"\" | usage_status != \"reported\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No matching data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Counts observed receipt IDs with unreported usage. No data is not zero usage or proof that every task reached the receiver."
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Claude tokens (selected range)",
      "description": "Prometheus increase over the selected range by type. One series per writer: Claude sessions (session.id) and Codex processes (service.instance.id from the identity launcher) are summed at query time. Writers without an identity (instance=\"unscoped\") are excluded; the integrity panel counts them. increase() extrapolates at the range edges, a few percent high for short-lived writers; the exact difference is increase(...[$__range] anchored) on a Prometheus started with promql-extended-range-selectors. Loki keeps the per-request events.",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(ecosystem_claude_code_token_usage_tokens_total{instance!=\"unscoped\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Codex turn tokens (selected range)",
      "description": "Prometheus increase over the selected range by token_type; subsets are not additive. One series per writer: Claude sessions (session.id) and Codex processes (service.instance.id from the identity launcher) are summed at query time. Writers without an identity (instance=\"unscoped\") are excluded; the integrity panel counts them. increase() extrapolates at the range edges, a few percent high for short-lived writers; the exact difference is increase(...[$__range] anchored) on a Prometheus started with promql-extended-range-selectors. Loki keeps the per-request events.",
      "gridPos": {
        "x": 8,
        "y": 50,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (increase(ecosystem_codex_turn_token_usage_sum{instance!=\"unscoped\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Token telemetry integrity (selected range)",
      "description": "Resets: the most resets of any one Claude token or cost series. A resumed session resets each of its series once; many resets on one series mean several writers share it. Dropped delta points and unscoped writer series should be 0: delta_to_cumulative rejected Codex points (shared stream or stream limit), and counters without a per-process identity. See the native-telemetry-integrity alert rules.",
      "gridPos": {
        "x": 16,
        "y": 50,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(resets({__name__=~\"ecosystem_claude_code_token_usage_tokens_total|ecosystem_claude_code_cost_usage_USD_total\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Most resets of one Claude series"
        },
        {
          "refId": "B",
          "expr": "sum(increase(otelcol_deltatocumulative_datapoints{error!=\"\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Dropped delta points"
        },
        {
          "refId": "C",
          "expr": "count(last_over_time({__name__=~\"ecosystem_claude_code_token_usage_tokens_total|ecosystem_codex_turn_token_usage_count\", instance=\"unscoped\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Unscoped writer series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 28,
      "type": "row",
      "title": "Tool, MCP, skill and subagent invoke rates (Loki)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Claude tool calls per minute by family",
      "description": "Executed Claude Code tool calls (tool_result events) per minute. Families: shell = Bash/PowerShell, read = Read/Grep/Glob, edit = Edit/Write/MultiEdit/NotebookEdit, mcp = every MCP tool, skill = Skill, toolsearch = ToolSearch, web = WebFetch/WebSearch, agent = Agent/Task/Workflow, other = the rest. Includes subagents and workflow children. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (tool_family) (rate({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | keep tool_family [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{tool_family}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Codex tool calls per minute by family",
      "description": "Codex codex.tool_result events per minute, all front-ends and sub-agents. code_mode is the functions/exec and functions/wait wrapper: Codex also records every call made inside it, so do not add code_mode to the other families. mcp = tool_namespace mcp__<server>; agent = the collaboration namespace. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (tool_family) (rate({service_name=~\".+\"} | event_name=\"codex.tool_result\" | keep tool_family [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{tool_family}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "MCP calls per minute by client and server",
      "description": "MCP tool results per minute by client and server. Claude names come from tool_parameters (OTEL_LOG_TOOL_DETAILS=1); Codex names come from its native mcp_server field. Every Codex app-server front-end reports service.name codex-app-server, so client uses the thread's originator there. One app-server process gives new threads the originator of the first client that initialized it. A series without a server name is a Claude session without tool details. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (client, mcp_server_name) (rate({service_name=~\".+\"} | event_name=~\"tool_result|codex.tool_result\" | tool_family=\"mcp\" | keep client, mcp_server_name [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{client}} \u00b7 {{mcp_server_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Skill activations per minute by name",
      "description": "Claude Code skill_activated events: model-invoked (claude-proactive, nested-skill) and /skill (user-slash). User-defined skills are named custom_skill unless OTEL_LOG_TOOL_DETAILS=1. Codex loads skills as instructions and emits no skill event. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (skill_name, invocation_trigger) (rate({service_name=~\"claude-code.*\"} | event_name=\"skill_activated\" | keep skill_name, invocation_trigger [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{skill_name}} \u00b7 {{invocation_trigger}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Subagent and workflow launches per minute",
      "description": "Launches, counted when they start. Claude: accepted tool_decision events for Agent/Task (by subagent_type) and Workflow, which Claude Code logs before the tool runs; an Agent call's tool_result arrives only when its subagent finishes, and a rejected call never launches. Codex: spawn messages (codex.agent_communication kind=spawn, state=send), which carry no originator, so app-server front-ends share one series; sender and receiver thread ids stay as structured metadata for drill-down. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (subagent_type) (rate({service_name=~\"claude-code.*\"} | event_name=\"tool_decision\" | decision=\"accept\" | tool_name=~\"Agent|Task\" | keep subagent_type [$__auto]))",
          "queryType": "range",
          "legendFormat": "Claude Agent launches \u00b7 {{subagent_type}}"
        },
        {
          "refId": "B",
          "expr": "60 * sum by (service_name) (rate({service_name=~\"claude-code.*\"} | event_name=\"tool_decision\" | decision=\"accept\" | tool_name=\"Workflow\" | keep service_name [$__auto]))",
          "queryType": "range",
          "legendFormat": "Claude Workflow launches"
        },
        {
          "refId": "C",
          "expr": "60 * sum by (service_name) (rate({service_name=~\".+\"} | event_name=\"codex.agent_communication\" | kind=\"spawn\" | state=\"send\" | keep service_name [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} sub-agent spawns"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Tool calls per minute by client and actor",
      "description": "By client (the Codex originator for codex-app-server front-ends, else the service name). Codex: actor main (agent_name /root) or subagent (/root/<task>); the agent path itself is not exported. Claude: workflow children carry workflow.run_id (actor workflow); Agent-tool subagents are not marked on tool events, so their calls fall in main_or_subagent. The second query adds Claude's own per-subagent total_tool_uses, reported when a subagent completes: a lagged subset of main_or_subagent, never an addition to it. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 12,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (client, actor) (rate({service_name=~\".+\"} | event_name=~\"tool_result|codex.tool_result\" | tool_family!=\"code_mode\" | keep client, actor [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{client}} \u00b7 {{actor}}"
        },
        {
          "refId": "B",
          "expr": "60 * sum by (agent_type) (rate({service_name=~\"claude-code.*\"} | event_name=\"subagent_completed\" | keep agent_type, total_tool_uses | unwrap total_tool_uses | __error__=\"\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "Claude subagent {{agent_type}} \u00b7 tool uses at completion"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "calls/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 35,
      "type": "stat",
      "title": "MCP share of tool calls (selected range)",
      "description": "MCP tool results over all tool results in the selected range. Codex code-mode wrappers are excluded from the denominator because the calls inside them are counted.",
      "gridPos": {
        "x": 0,
        "y": 81,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | tool_family=\"mcp\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Claude"
        },
        {
          "refId": "B",
          "expr": "(sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | tool_family=\"mcp\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | tool_family!=\"code_mode\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Codex"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no calls",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 36,
      "type": "stat",
      "title": "ctx and rtk adoption (selected range)",
      "description": "ctx: context-mode MCP calls over context-mode + shell + read + web calls. rtk: shell calls whose command starts with rtk over shell calls with a known command start (shell_rtk is computed in the Collector from Claude's bash_command or Codex's exec_command cmd; the command text itself is deleted).",
      "gridPos": {
        "x": 8,
        "y": 81,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | mcp_server_name=~\"context-mode|plugin_context-mode_context-mode\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | tool_family=~\"shell|read|web\" or mcp_server_name=~\"context-mode|plugin_context-mode_context-mode\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Claude ctx"
        },
        {
          "refId": "B",
          "expr": "(sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | mcp_server_name=~\"context-mode|plugin_context-mode_context-mode\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | tool_family=~\"shell|read|web\" or mcp_server_name=~\"context-mode|plugin_context-mode_context-mode\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Codex ctx"
        },
        {
          "refId": "C",
          "expr": "(sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | shell_rtk=\"true\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | shell_rtk!=\"\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Claude rtk"
        },
        {
          "refId": "D",
          "expr": "(sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | shell_rtk=\"true\" | keep service_name [$__auto])) or vector(0)) / sum(count_over_time({service_name=~\".+\"} | event_name=\"codex.tool_result\" | shell_rtk!=\"\" | keep service_name [$__auto]))",
          "queryType": "instant",
          "legendFormat": "Codex rtk"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no calls",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Invoke-rate telemetry integrity (selected range)",
      "description": "All three should be 0. MCP calls without a server name come from Claude sessions started without OTEL_LOG_TOOL_DETAILS=1. Unparsed: tool_parameters that were not a JSON object (names lost, content still deleted). Replaced names failed the Collector's name pattern (for example text with spaces) and are exported as other. Agent types outside Claude Code's built-in agents are custom by design and are not counted here.",
      "gridPos": {
        "x": 16,
        "y": 81,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"claude-code.*\"} | event_name=\"tool_result\" | tool_family=\"mcp\" | mcp_server_name=\"\" | keep service_name [$__auto])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Claude MCP calls without a server name"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=~\".+\"} | tool_details=\"unparsed\" | keep service_name [$__auto])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Unparsed tool_parameters"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({service_name=~\".+\"} | mcp_server_name=\"other\" or mcp_tool_name=\"other\" or skill_name=\"other\" or originator=\"other\" or client=\"other\" | keep service_name [$__auto])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Names replaced by the name pattern"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "no calls",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 38,
      "type": "timeseries",
      "title": "MCP-consuming API requests per minute by actor",
      "description": "Claude api_request events that consumed an MCP tool result, by the requesting actor (query_source: main, subagent, workflow, auxiliary) and server. This is the only per-call link between an Agent-tool subagent and its MCP calls. It counts requests: several MCP results consumed by one request count once, so as a count of MCP calls it is a lower bound. Names are Loki structured metadata written by the Collector's transform/tool_names; no label is added. Claude MCP server names and subagent types need OTEL_LOG_TOOL_DETAILS=1 in Claude Code; sessions started without it show an empty name (see the integrity panel). Agent types outside Claude Code's built-in agents show as custom. client is the Codex originator for codex-app-server front-ends, else the service name.",
      "gridPos": {
        "x": 0,
        "y": 87,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (actor, mcp_server_name) (rate({service_name=~\"claude-code.*\"} | event_name=\"api_request\" | mcp_server_name!=\"\" | keep actor, mcp_server_name [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{actor}} \u00b7 {{mcp_server_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "axisLabel": "requests/min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    }
  ]
}
