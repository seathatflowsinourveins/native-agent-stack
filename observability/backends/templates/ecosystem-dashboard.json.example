{
  "uid": "ecosystem-native",
  "title": "Native agent ecosystem",
  "schemaVersion": 39,
  "version": 8,
  "links": [
    {
      "type": "link",
      "title": "Memory, RAG and token-saving results",
      "url": "/d/native-foundation-data",
      "targetBlank": false
    }
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ecosystem",
    "local"
  ],
  "description": "Native exported counters and local service health. Token panels are native-client telemetry, not estimates of savings. Cache/reasoning subsets must not be added again. Synthetic acceptance alerts are explicitly labeled. Raw prompt/tool bodies are omitted upstream by the collector.",
  "panels": [
    {
      "id": 1,
      "title": "Codex native token counters",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (ecosystem_codex_turn_token_usage_sum)",
          "legendFormat": "{{token_type}}"
        }
      ],
      "options": {},
      "description": "Native exported per-turn histogram sums by token_type. Cached input is an input subset; reasoning output is an output subset. The native total series is separate; do not add all lines together."
    },
    {
      "id": 2,
      "title": "Claude native token counters",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (ecosystem_claude_code_token_usage_tokens_total)",
          "legendFormat": "{{type}}"
        }
      ],
      "options": {},
      "description": "Native cumulative counters by type. Keep input, output, cacheRead and cacheCreation distinct; these are not a measured savings percentage or an invoice."
    },
    {
      "id": 3,
      "title": "Service scrape health",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} \u00b7 {{instance}}"
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "HTTP response status (200 expected for local Dagu)",
      "type": "table",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (http_url, http_status_code) (ecosystem_httpcheck_status == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {},
      "description": "Active status class/code only. A Dagu401 proves its API is protected, not that a job can execute. Gateway200 proves local readiness, not provider access."
    },
    {
      "id": 5,
      "title": "Active alerts",
      "type": "table",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "title": "Collector rejected telemetry",
      "type": "timeseries",
      "datasource": {
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"otelcol_.*(refused|failed).*\"}"
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "title": "Sanitized client events",
      "type": "logs",
      "datasource": {
        "uid": "ecosystem-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"}"
        }
      ],
      "options": {}
    },
    {
      "id": 20,
      "type": "stat",
      "title": "SDK reported turn tokens (selected range)",
      "description": "Deduplicated per receipt ID in the selected dashboard range. Receipt totals are separate from native histograms; never add them together.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (receipt_id) (max_over_time({service_name=\"codex-sdk-receipt\"} | receipt_id != \"\" | unwrap total_token_count | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "SDK reported tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 21,
      "title": "WSL CPU load averages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"ecosystem_system_cpu_load_average_.*\"}",
          "legendFormat": "{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 22,
      "title": "WSL memory by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecosystem_system_memory_usage_bytes",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 23,
      "title": "WSL root filesystem by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ecosystem-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecosystem_system_filesystem_usage_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Native Collector host_metrics receiver for the Linux/WSL host. Filesystem capacity is the WSL virtual root, not Windows physical backing storage."
    },
    {
      "id": 24,
      "title": "SDK receipts without reported usage (selected range)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "ecosystem-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (receipt_id) (count_over_time({service_name=\"codex-sdk-receipt\"} | receipt_id != \"\" | usage_status != \"reported\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No matching data",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Counts observed receipt IDs with unreported usage. No data is not zero usage or proof that every task reached the receiver."
    }
  ]
}
