groups:
  - name: ecosystem-local
    rules:
      - alert: EcosystemServiceUnavailable
        expr: up{job!~"acceptance-fixture|adaptive-paper"} == 0
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'Local service {{ $labels.job }} is unavailable'
          description: 'Prometheus could not scrape {{ $labels.instance }} for two minutes. The adaptive-paper job is excluded here: its targets are the paper-trial exporters that metrics.py --file-sd registers in adaptive-paper-targets.json, separate processes not started by install.py/configure.py. EquitiesPaperMetricsMissing (scope=equities-broker) alerts on a registered exporter that is not answering, with wording matched to that trial lifecycle, so this rule does not duplicate it.'
      - alert: EcosystemOmniRouteHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:20128/api/health",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: OmniRoute
        annotations:
          summary: 'Local OmniRoute health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:20128/api/health; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemFreeLLMAPIHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:31415/readyz",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: FreeLLMAPI
        annotations:
          summary: 'Local FreeLLMAPI health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:31415/readyz; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemCollectorHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:14333/",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: Collector
        annotations:
          summary: 'Local Collector health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:14333/; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemDaguDashboardHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:18525/api/v1/dags",http_status_code="200"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: DaguDashboard
        annotations:
          summary: 'Local Dagu dashboard health response is unexpected or missing'
          description: 'Expected 200 at the loopback passwordless Dagu API; DAG write/run permissions are checked separately. This is not provider or job execution evidence.'
      - alert: EcosystemAcceptanceTargetDown
        expr: up{job="acceptance-fixture"} == 0
        for: 10s
        labels:
          severity: test
          scope: synthetic-acceptance
        annotations:
          summary: 'Controlled local acceptance target is unavailable'
          description: 'Synthetic closed-port fixture only; no production service was stopped.'
      - alert: EcosystemRootFilesystemLowSpace
        expr: 'sum(ecosystem_system_filesystem_usage_bytes{mountpoint="/",state="free"}) < 5368709120'
        for: 10m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem has less than 5 GiB free'
          description: 'Local WSL filesystem only; Windows backing-disk capacity is separate.'
      - alert: EcosystemHostFilesystemMetricsMissing
        expr: 'absent(ecosystem_system_filesystem_usage_bytes{mountpoint="/"})'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem observations are missing'
          description: 'Missing data is unknown, not proof of available space.'
  - name: equities-broker-path
    rules:
      - alert: EquitiesOrderStateDivergence
        expr: 'increase(paper_order_state_divergence_total[5m]) > 0'
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper ledger recorded a broker order-state divergence'
          description: 'paper_order_state_divergence_total increased in the last 5 minutes: the durable ledger observed a broker order it never reserved (reason=external_order_detected). The runner freezes entries on this; treat as an unowned position/order until an explicit recovery run reconciles it.'
      - alert: EquitiesReconciliationFailed
        expr: |
          paper_needs_attention == 1
          or
          paper_reconciliation_status{result="needs_attention"} == 1
          or
          ((time() - paper_reconciliation_last_success_timestamp_seconds) > 120 and paper_trial_active == 1)
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper trial needs attention or has not reconciled recently'
          description: 'Fires if the durable trial.json phase is needs_attention (the last bounded run did not end flat/clean), or if trial.json status is needs_attention even though phase ended finished (runner.py sets phase from the post-recovery flat flag and status from the original run result independently, so a run that failed and was then recovered flat reports phase=finished/status=needs_attention -- the paper_needs_attention clause alone misses this, the paper_reconciliation_status clause catches it), or an active trial has gone over 120 seconds since its last successful reconciliation. paper_reconciliation_last_success_timestamp_seconds is not currently exported by metrics.py (documented schema gap); that clause is dormant until that changes -- it is also the only clause that could catch a hard-killed runner whose trial.json is stuck at phase=starting, which remains an unguarded gap until it is exported.'
      - alert: EquitiesRequestBudgetExhausted
        expr: 'paper_request_budget_remaining <= 0 or increase(paper_request_budget_wait_exceeded_total[5m]) > 0'
        for: 2m
        labels:
          severity: warning
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper Alpaca request budget is exhausted or waits are being denied'
          description: 'The rolling one-minute request budget (paper_request_budget_remaining, by kind=rest|submit) reached zero, or paper_request_budget_wait_exceeded_total increased. paper_request_budget_wait_exceeded_total is not currently exported by metrics.py (documented schema gap: it is raised only in the runner process, not recorded in the ledger); this clause is dormant until that changes, so this alert currently fires from paper_request_budget_remaining alone.'
      - alert: EquitiesLedgerFrozen
        expr: 'max by (reason) (paper_ledger_frozen) == 1'
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper ledger {{ $labels.reason }} is frozen'
          description: 'The durable ledger persisted a halted_reason ({{ $labels.reason }}); safety.Ledger blocks new buy entries until an explicit recovery run or a fresh qualified next trial clears it. This does not stop confirmed owned exits.'
      - alert: EquitiesPaperMetricsMissing
        expr: 'up{job="adaptive-paper"} unless on(job, instance) paper_trial_active'
        for: 2m
        labels:
          severity: warning
          scope: equities-broker
        annotations:
          summary: 'Registered adaptive-paper exporter {{ $labels.instance }} is not answering with paper metrics'
          description: 'An adaptive-paper exporter registered in adaptive-paper-targets.json (the file_sd list that metrics.py --file-sd writes) has returned no paper_trial_active for two minutes: the exporter is down or unreachable, or another process answers on its port. A running exporter always exports paper_trial_active whatever the ledger state, so this does not cover an unreadable ledger path (see EquitiesLedgerUnreadable). The exporter serves only when registered (--file-sd), and removes its own target only on a clean stop of a trial that finished with a passing status (passed or completed_no_signals); a crashed or killed exporter, or any other trial state, stays registered and keeps this alert firing until the trial is recovered and metrics.py --deregister runs. No registered target means no series and no alert: missing data is unknown state, not proof of no active trial.'
      - alert: EquitiesLedgerUnreadable
        expr: 'paper_ledger_readable == 0'
        for: 2m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper exporter cannot read its ledger'
          description: 'The exporter is answering scrapes (paper_ledger_readable is present) but its most recent read-only open of --ledger failed or the file is missing for two minutes straight: a wrong --ledger path, a permissions problem, or a failed sqlite mode=ro open. paper_order_state_divergence_total, paper_ledger_frozen, and paper_request_budget_remaining/limit are conditionally emitted (unlike paper_trial_active/paper_needs_attention) and go silently absent in this state with no absent()-based rule able to target them directly; this alert is the guard for that gap.'
