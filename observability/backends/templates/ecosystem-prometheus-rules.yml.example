groups:
  - name: ecosystem-local
    rules:
      - alert: EcosystemServiceUnavailable
        expr: up{job!~"acceptance-fixture|adaptive-paper"} == 0
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'Local service {{ $labels.job }} is unavailable'
          description: 'Prometheus could not scrape {{ $labels.instance }} for two minutes. The adaptive-paper job is excluded here: its targets are the paper-trial exporters that metrics.py --file-sd registers in adaptive-paper-targets.json, separate processes not started by install.py/configure.py. EquitiesPaperMetricsMissing (scope=equities-broker) alerts on a registered exporter that is not answering, with wording matched to that trial lifecycle, so this rule does not duplicate it.'
      - alert: EcosystemOmniRouteHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:20128/api/health",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: OmniRoute
        annotations:
          summary: 'Local OmniRoute health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:20128/api/health; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemFreeLLMAPIHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:31415/readyz",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: FreeLLMAPI
        annotations:
          summary: 'Local FreeLLMAPI health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:31415/readyz; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemCollectorHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:14333/",http_status_class="2xx"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: Collector
        annotations:
          summary: 'Local Collector health response is unexpected or missing'
          description: 'Expected 2xx at http://127.0.0.1:14333/; this checks transport/protection, not provider or job execution.'
      - alert: EcosystemDaguDashboardHealthUnexpected
        expr: '(max(ecosystem_httpcheck_status{http_url="http://127.0.0.1:18525/api/v1/dags",http_status_code="200"}) or vector(0)) < 1'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
          component: DaguDashboard
        annotations:
          summary: 'Local Dagu dashboard health response is unexpected or missing'
          description: 'Expected 200 at the loopback passwordless Dagu API; DAG write/run permissions are checked separately. This is not provider or job execution evidence.'
      - alert: EcosystemAcceptanceTargetDown
        expr: up{job="acceptance-fixture"} == 0
        for: 10s
        labels:
          severity: test
          scope: synthetic-acceptance
        annotations:
          summary: 'Controlled local acceptance target is unavailable'
          description: 'Synthetic closed-port fixture only; no production service was stopped.'
      - alert: EcosystemRootFilesystemLowSpace
        expr: 'sum(ecosystem_system_filesystem_usage_bytes{mountpoint="/",state="free"}) < 5368709120'
        for: 10m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem has less than 5 GiB free'
          description: 'Local WSL filesystem only; Windows backing-disk capacity is separate.'
      - alert: EcosystemHostFilesystemMetricsMissing
        expr: 'absent(ecosystem_system_filesystem_usage_bytes{mountpoint="/"})'
        for: 2m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem observations are missing'
          description: 'Missing data is unknown, not proof of available space.'
      # Port of prometheus/node_exporter v1.12.1 node-mixin filesystem alerts:
      # commit 6044da783597cc3b57aef7580ddcdcff58a4ee99, docs/node-mixin/alerts/alerts.libsonnet:7-80
      # and docs/node-mixin/config.libsonnet:67-91 (annotated tag object fc12f2c0ca65).
      # OTel contrib v0.161.0 filesystemscraper/metadata.yaml declares free/used/reserved.
      # Available is free alone; sum without(state) is size, preserving filesystem/owner labels.
      # group_left retains state="free" so the percentage and prediction vectors match.
      # mode!="ro" carries the mixin's read-only exclusion using the OTel mount mode.
      - alert: EcosystemRootFilesystemSpaceFillingUp
        expr: |
          (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}
            / ignoring(state) group_left sum without(state) (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state=~"free|used|reserved"}) * 100 < 40)
          and predict_linear(ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}[6h], 24*60*60) < 0
        for: 1h
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem is predicted to run out of space within 24 hours'
          description: 'Less than 40% of total filesystem bytes are available to ordinary writers, and the six-hour free-space trend predicts exhaustion within 24 hours, sustained for one hour. Reserved bytes count toward size, not available space.'
      - alert: EcosystemRootFilesystemSpaceFillingUp
        expr: |
          (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}
            / ignoring(state) group_left sum without(state) (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state=~"free|used|reserved"}) * 100 < 20)
          and predict_linear(ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}[6h], 4*60*60) < 0
        for: 1h
        labels:
          severity: critical
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem is predicted to run out of space within four hours'
          description: 'Less than 20% of total filesystem bytes are available to ordinary writers, and the six-hour free-space trend predicts exhaustion within four hours, sustained for one hour. Inspect active scratch writers and stop recursive checkout copies.'
      - alert: EcosystemRootFilesystemAlmostOutOfSpace
        expr: |
          ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}
            / ignoring(state) group_left sum without(state) (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state=~"free|used|reserved"}) * 100 < 5
        for: 30m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem has less than 5% available space'
          description: 'Available bytes have stayed below 5% of total filesystem bytes for 30 minutes. Available is the free state; size includes free, used and reserved states.'
      - alert: EcosystemRootFilesystemAlmostOutOfSpace
        expr: |
          ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}
            / ignoring(state) group_left sum without(state) (ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state=~"free|used|reserved"}) * 100 < 3
        for: 30m
        labels:
          severity: critical
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem has less than 3% available space'
          description: 'Available bytes have stayed below 3% of total filesystem bytes for 30 minutes. Recover headroom before the Collector and Prometheus fail to persist data.'
      # Incident-specific short-window companion, not an upstream node-mixin default.
      # 50 GiB is approximately the mixin's 5% low-space band on this ~1 TiB root.
      # Forecast semantics: prometheus/prometheus v3.15.0 docs/querying/functions.md:769-781.
      # Host cadence: collector.yaml (30s collection, 1s batch); Prometheus template (15s scrape/evaluation).
      - alert: EcosystemRootFilesystemBurstFill
        expr: |
          predict_linear(ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"}[2m], 120) < 0
          and ecosystem_system_filesystem_usage_bytes{mountpoint="/",mode!="ro",state="free"} < 53687091200
        for: 15s
        labels:
          severity: critical
          scope: local-ecosystem
        annotations:
          summary: 'WSL root filesystem is predicted to exhaust within two minutes below 50 GiB available'
          description: 'The two-minute free-space trend predicts exhaustion within two minutes and less than 50 GiB remains, sustained for 15 seconds. For a linear fill at r GiB/s the page leads exhaustion by about min(50/r, 120) s minus the observation delay minus the 15 s pending interval: fills slower than about 50 GiB per two minutes get roughly 120 s minus those delays, while faster fills page within about 76 s of crossing the floor (configured collection/batch/scrape/evaluation/pending budget, plus transport and scheduling) and can exhaust the disk first; prediction requires at least two samples. Faster fills can outrun this alert: the test TMPDIR/copy guard prevents the known recursive cause, and the coordinator runs an independent two-minute headroom guard outside this repository. Stop the offending writer and recover headroom.'
  - name: native-telemetry-integrity
    rules:
      - alert: EcosystemTokenCounterResets
        expr: 'max by (job) (resets({__name__=~"ecosystem_claude_code_token_usage_tokens_total|ecosystem_claude_code_cost_usage_USD_total"}[15m])) > 2'
        for: 5m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'Claude token or cost counters of {{ $labels.job }} keep resetting'
          description: 'Each writer needs its own series: the Collector makes session.id (OTEL_METRICS_INCLUDE_SESSION_ID=true) or a launcher service.instance.id the instance label. Repeated resets mean several processes write one cumulative series (instance="unscoped": a session started before session ids were enabled), so increase() and rate() over these counters are inflated. The rule counts the resets of each series and takes the most: a resumed session keeps its session.id in a new process, so each of its type and cost series resets once, which is expected. Use the Loki api_request events until the writers are scoped.'
      - alert: EcosystemDeltaConversionDropped
        expr: 'sum(increase(otelcol_deltatocumulative_datapoints{error!=""}[15m])) > 0'
        for: 5m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'The Collector is dropping delta metric points'
          description: 'delta_to_cumulative rejected points in the last 15 minutes (error=delta.ErrOutOfOrder or delta.ErrOlderStart when two writers share one stream, error=limit past max_streams). Shared streams come from Codex processes started without the identity launcher (instance="unscoped") or started directly from the real binary with an inherited service.instance.id (the launcher appends a fresh id to an inherited one). Codex counters in Prometheus undercount while this fires; Loki keeps the per-event usage.'
      - alert: EcosystemUnscopedTokenWriters
        expr: 'count by (job) (last_over_time({__name__=~"ecosystem_claude_code_token_usage_tokens_total|ecosystem_codex_turn_token_usage_count", instance="unscoped"}[15m])) > 0'
        for: 5m
        labels:
          severity: warning
          scope: local-ecosystem
        annotations:
          summary: 'Token counters of {{ $labels.job }} have no per-process writer identity'
          description: 'These series are labelled instance="unscoped": a Claude process without session.id (a session that started before OTEL_METRICS_INCLUDE_SESSION_ID=true, or one that disables it) or a Codex process started without the identity launcher. Concurrent unscoped writers share one series, so the dashboards exclude them; restart the session or reinstall the launcher (observability/collector/README.md). The rule keeps 15 minutes of samples, longer than its 5-minute delay: a short Codex run''s series leaves the Collector''s exporter five minutes after its last export (metric_expiration), so it fires for such a run too and resolves 15 minutes after the last unscoped sample.'
  - name: ecosystem-lanes
    rules:
      - alert: CodexLaneGoalBlocked
        expr: 'sum by (ecosystem_lane) (increase(ecosystem_codex_goal_blocked_total[15m])) > 0'
        for: 0m
        keep_firing_for: 30m
        labels:
          severity: warning
          scope: codex-lanes
        annotations:
          summary: 'A Codex goal is blocked (ecosystem_lane="{{ $labels.ecosystem_lane }}")'
          description: 'A Codex goal reported codex.goal.blocked in the last 15 minutes. Event counters reach Prometheus as delta points that delta_to_cumulative converts, and their series leave the Collector''s exporter five minutes after the last export, so the rule fires at once (for: 0m) and keeps firing for 30 minutes after the event leaves the window (keep_firing_for). Check the lane''s goal state and the requests waiting on it on the lane board. ecosystem_lane comes from the launch-time OTEL_RESOURCE_ATTRIBUTES=ecosystem.lane=<lane>; an empty value is a Codex process started without it.'
      - alert: CodexLaneToolErrorBurst
        expr: |
          (sum by (ecosystem_lane) (increase(ecosystem_codex_tool_call_total{success="false"}[1h]))
            / sum by (ecosystem_lane) (increase(ecosystem_codex_tool_call_total[1h])) > 0.10)
          and sum by (ecosystem_lane) (increase(ecosystem_codex_tool_call_total[1h])) >= 30
        for: 15m
        labels:
          severity: warning
          scope: codex-lanes
        annotations:
          summary: 'Codex tool calls are failing (ecosystem_lane="{{ $labels.ecosystem_lane }}")'
          description: 'More than 10% of at least 30 Codex tool calls (codex.tool.call, success="false") failed in the last hour, for 15 minutes. 10% is twice the root lane''s 2026-10-03 daily failure rate of 4.9%, a starting value to re-tune after 7 days of data. The value is the failed share.'
      - alert: CodexLaneMcpErrorRatio
        expr: |
          (sum by (ecosystem_lane) (increase(ecosystem_codex_mcp_call_error_total[1h]))
            / sum by (ecosystem_lane) (increase(ecosystem_codex_mcp_call_total[1h])) > 0.10)
          and sum by (ecosystem_lane) (increase(ecosystem_codex_mcp_call_total[1h])) >= 20
        for: 15m
        labels:
          severity: warning
          scope: codex-lanes
        annotations:
          summary: 'Codex MCP calls are failing (ecosystem_lane="{{ $labels.ecosystem_lane }}")'
          description: 'More than 10% of at least 20 Codex MCP calls returned an error in the last hour (codex.mcp.call.error over codex.mcp.call), for 15 minutes. The tool label on these series names the failing MCP tool. A starting value to re-tune after 7 days of data. The value is the error share.'
      - alert: CodexLaneUsageLimited
        expr: 'sum by (ecosystem_lane) (increase(ecosystem_codex_goal_usage_limited_total[15m])) > 0'
        for: 0m
        keep_firing_for: 30m
        labels:
          severity: critical
          scope: codex-lanes
        annotations:
          summary: 'A Codex goal hit a usage limit (ecosystem_lane="{{ $labels.ecosystem_lane }}")'
          description: 'A Codex goal reported codex.goal.usage_limited in the last 15 minutes; any such event is critical. Resume the lane after the limit resets. It has the same delta-event mechanics as CodexLaneGoalBlocked (for: 0m, keep_firing_for: 30m). The 80% and 95% rate-limit readings come from the rollouts and are shown on the lane board, not here.'
  - name: equities-broker-path
    rules:
      - alert: EquitiesOrderStateDivergence
        expr: 'increase(paper_order_state_divergence_total[5m]) > 0'
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper ledger recorded a broker order-state divergence'
          description: 'paper_order_state_divergence_total increased in the last 5 minutes: the durable ledger observed a broker order it never reserved (reason=external_order_detected). The runner freezes entries on this; treat as an unowned position/order until an explicit recovery run reconciles it.'
      - alert: EquitiesReconciliationFailed
        expr: |
          paper_needs_attention == 1
          or
          paper_reconciliation_status{result="needs_attention"} == 1
          or
          ((time() - paper_reconciliation_last_success_timestamp_seconds) > 120 and paper_trial_active == 1)
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper trial needs attention or has not reconciled recently'
          description: 'Fires if the durable trial.json phase is needs_attention (the last bounded run did not end flat/clean), or if trial.json status is needs_attention even though phase ended finished (runner.py sets phase from the post-recovery flat flag and status from the original run result independently, so a run that failed and was then recovered flat reports phase=finished/status=needs_attention -- the paper_needs_attention clause alone misses this, the paper_reconciliation_status clause catches it), or an active trial has gone over 120 seconds since its last successful reconciliation. paper_reconciliation_last_success_timestamp_seconds is not currently exported by metrics.py (documented schema gap); that clause is dormant until that changes -- it is also the only clause that could catch a hard-killed runner whose trial.json is stuck at phase=starting, which remains an unguarded gap until it is exported.'
      - alert: EquitiesRequestBudgetExhausted
        expr: 'paper_request_budget_remaining <= 0 or increase(paper_request_budget_wait_exceeded_total[5m]) > 0'
        for: 2m
        labels:
          severity: warning
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper Alpaca request budget is exhausted or waits are being denied'
          description: 'The rolling one-minute request budget (paper_request_budget_remaining, by kind=rest|submit) reached zero, or paper_request_budget_wait_exceeded_total increased. paper_request_budget_wait_exceeded_total is not currently exported by metrics.py (documented schema gap: it is raised only in the runner process, not recorded in the ledger); this clause is dormant until that changes, so this alert currently fires from paper_request_budget_remaining alone.'
      - alert: EquitiesLedgerFrozen
        expr: 'max by (reason) (paper_ledger_frozen) == 1'
        for: 1m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper ledger {{ $labels.reason }} is frozen'
          description: 'The durable ledger persisted a halted_reason ({{ $labels.reason }}); safety.Ledger blocks new buy entries until an explicit recovery run or a fresh qualified next trial clears it. This does not stop confirmed owned exits.'
      - alert: EquitiesPaperMetricsMissing
        expr: 'up{job="adaptive-paper"} unless on(job, instance) paper_trial_active'
        for: 2m
        labels:
          severity: warning
          scope: equities-broker
        annotations:
          summary: 'Registered adaptive-paper exporter {{ $labels.instance }} is not answering with paper metrics'
          description: 'An adaptive-paper exporter registered in adaptive-paper-targets.json (the file_sd list that metrics.py --file-sd writes) has returned no paper_trial_active for two minutes: the exporter is down or unreachable, or another process answers on its port. A running exporter always exports paper_trial_active whatever the ledger state, so this does not cover an unreadable ledger path (see EquitiesLedgerUnreadable). The exporter serves only when registered (--file-sd), and removes its own target only on a clean stop of a trial that finished with a passing status (passed or completed_no_signals); a crashed or killed exporter, or any other trial state, stays registered and keeps this alert firing until the trial is recovered and metrics.py --deregister runs. No registered target means no series and no alert: missing data is unknown state, not proof of no active trial.'
      - alert: EquitiesLedgerUnreadable
        expr: 'paper_ledger_readable == 0'
        for: 2m
        labels:
          severity: critical
          scope: equities-broker
        annotations:
          summary: 'Adaptive-paper exporter cannot read its ledger'
          description: 'The exporter is answering scrapes (paper_ledger_readable is present) but its most recent read-only open of --ledger failed or the file is missing for two minutes straight: a wrong --ledger path, a permissions problem, or a failed sqlite mode=ro open. paper_order_state_divergence_total, paper_ledger_frozen, and paper_request_budget_remaining/limit are conditionally emitted (unlike paper_trial_active/paper_needs_attention) and go silently absent in this state with no absent()-based rule able to target them directly; this alert is the guard for that gap.'
