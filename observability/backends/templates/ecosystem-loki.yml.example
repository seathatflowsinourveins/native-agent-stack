auth_enabled: false
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 13100
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 19095
  log_level: warn
common:
  instance_addr: 127.0.0.1
  path_prefix: '@DATA_ROOT@/ecosystem-loki'
  storage:
    filesystem:
      chunks_directory: '@DATA_ROOT@/ecosystem-loki/chunks'
      rules_directory: '@DATA_ROOT@/ecosystem-loki/rules'
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: '2024-01-01'
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
storage_config:
  tsdb_shipper:
    active_index_directory: '@DATA_ROOT@/ecosystem-loki/index'
    cache_location: '@DATA_ROOT@/ecosystem-loki/index-cache'
ingester:
  wal:
    enabled: true
    dir: '@DATA_ROOT@/ecosystem-loki/wal'
  chunk_idle_period: 5m
  max_chunk_age: 1h
compactor:
  working_directory: '@DATA_ROOT@/ecosystem-loki/compactor'
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 2
  delete_request_store: filesystem
limits_config:
  allow_structured_metadata: true
  retention_period: 72h
  max_query_lookback: 72h
  ingestion_rate_mb: 2
  ingestion_burst_size_mb: 4
  max_query_parallelism: 2
  max_global_streams_per_user: 1000
query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 32
analytics:
  reporting_enabled: false
