global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - '@CONFIG_ROOT@/ecosystem-prometheus-rules.yml'
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:19093']
scrape_configs:
  - job_name: collector-native
    honor_labels: true
    static_configs:
      - targets: ['127.0.0.1:18889']
  - job_name: collector-health
    static_configs:
      - targets: ['127.0.0.1:18888']
  - job_name: qdrant
    static_configs:
      - targets: ['127.0.0.1:16333']
  - job_name: vllm
    static_configs:
      - targets: ['127.0.0.1:8231']
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:19090']
  - job_name: loki
    static_configs:
      - targets: ['127.0.0.1:13100']
  - job_name: alertmanager
    static_configs:
      - targets: ['127.0.0.1:19093']
  - job_name: acceptance-fixture
    scrape_interval: 5s
    scrape_timeout: 2s
    file_sd_configs:
      - files: ['@CONFIG_ROOT@/acceptance-targets.json']
        refresh_interval: 5s
