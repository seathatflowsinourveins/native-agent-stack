global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - '@CONFIG_ROOT@/ecosystem-prometheus-rules.yml'
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:19093']
scrape_configs:
  - job_name: collector-native
    honor_labels: true
    static_configs:
      - targets: ['127.0.0.1:18889']
    # Each Codex process is its own series set (observability/collector/README.md). Keep every histogram's _sum and
    # _count and the token-usage buckets; drop the other Codex bucket series, which no dashboard or rule reads and
    # which would multiply storage per process under the shared size-based retention.
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: ecosystem_codex_turn_token_usage_bucket
        target_label: __tmp_keep_bucket
        replacement: 'yes'
      - source_labels: [__name__, __tmp_keep_bucket]
        regex: 'ecosystem_codex_.+_bucket;'
        action: drop
      - regex: __tmp_keep_bucket
        action: labeldrop
  - job_name: collector-health
    static_configs:
      - targets: ['127.0.0.1:18888']
  - job_name: qdrant
    static_configs:
      - targets: ['127.0.0.1:16333']
  - job_name: vllm
    static_configs:
      - targets: ['127.0.0.1:8231']
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:19090']
  - job_name: loki
    static_configs:
      - targets: ['127.0.0.1:13100']
  - job_name: alertmanager
    static_configs:
      - targets: ['127.0.0.1:19093']
  - job_name: adaptive-paper
    file_sd_configs:
      - files: ['@CONFIG_ROOT@/adaptive-paper-targets.json']
        refresh_interval: 30s
  - job_name: acceptance-fixture
    scrape_interval: 5s
    scrape_timeout: 2s
    file_sd_configs:
      - files: ['@CONFIG_ROOT@/acceptance-targets.json']
        refresh_interval: 5s
