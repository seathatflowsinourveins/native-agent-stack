[paths]
data = @DATA_ROOT@/ecosystem-grafana
logs = @DATA_ROOT@/ecosystem-grafana/logs
plugins = @DATA_ROOT@/ecosystem-grafana/plugins
provisioning = @CONFIG_ROOT@/ecosystem-grafana-provisioning
[server]
http_addr = 127.0.0.1
http_port = 13000
domain = localhost
root_url = http://127.0.0.1:13000
[security]
disable_gravatar = true
cookie_samesite = strict
[users]
allow_sign_up = false
[auth.anonymous]
enabled = true
org_name = Main Org.
org_role = Viewer
[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false
[news]
news_feed_enabled = false
[plugins]
preinstall_disabled = true
[log]
mode = console
level = warn
