  "tests": [
    {
      "name": "LOCAL SYNTHETIC CONFIGURATION EXPECTATION: fresh active is quiet; fresh inactive without Result is UNKNOWN-firing",
      "interval": "15s",
      "input_series": [
        {
          "series": "ns2604_user_unit_expected{host=\"fixture-host\",unit=\"stack.service\",failure_class=\"StackUnitFailed\",severity=\"warning\"}",
          "values": "1x80"
        },
        {
          "series": "ns2604_user_unit_expected{host=\"fixture-host\",unit=\"paper.service\",failure_class=\"PaperLaneUnitFailed\",severity=\"critical\"}",
          "values": "1x80"
        },
        {
          "series": "up{job=\"ns2604-user-unit-state\",instance=\"fixture-exporter\"}",
          "values": "1x80"
        },
        {
          "series": "ns2604_user_unit_state{host=\"fixture-host\",unit=\"stack.service\",state=\"active\",job=\"ns2604-user-unit-state\",instance=\"fixture-exporter\"}",
          "values": "1x80"
        },
        {
          "series": "ns2604_user_unit_state{host=\"fixture-host\",unit=\"paper.service\",state=\"inactive\",job=\"ns2604-user-unit-state\",instance=\"fixture-exporter\"}",
          "values": "1x80"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "30s",
          "alertname": "StackUnitFailed",
          "exp_alerts": []
        },
        {
          "eval_time": "6m",
          "alertname": "StackUnitFailed",
          "exp_alerts": []
        },
        {
          "eval_time": "30s",
          "alertname": "PaperLaneUnitFailed",
          "exp_alerts": [
            {
              "exp_labels": {
                "host": "fixture-host",
                "unit": "paper.service",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "User unit paper.service needs attention",
                "description": "Failed or no fresh active state observed; inactive does not prove successful completion, and exporter, bus, missing unit, or stale state may be unknown. Recovery holds for 30 seconds."
              }
            }
          ]
        },
        {
          "eval_time": "6m",
          "alertname": "PaperLaneUnitFailed",
          "exp_alerts": [
            {
              "exp_labels": {
                "host": "fixture-host",
                "unit": "paper.service",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "User unit paper.service needs attention",
                "description": "Failed or no fresh active state observed; inactive does not prove successful completion, and exporter, bus, missing unit, or stale state may be unknown. Recovery holds for 30 seconds."
              }
            }
          ]
        }
      ],
      "promql_expr_test": [
        {
          "expr": "ns2604_user_unit_recovery{unit=\"paper.service\"}",
          "eval_time": "6m",
          "exp_samples": []
        }
      ]
    },
