[Unit]
Description=Serve explicitly selected native report artifacts on loopback
After=network.target

[Service]
Type=simple
UMask=0077
NoNewPrivileges=true
WorkingDirectory=@ARTIFACT_DIRECTORY@
ExecStart=/usr/bin/python3 -m http.server 17500 --bind 127.0.0.1 --directory @ARTIFACT_DIRECTORY@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
