# Replace both absolute placeholders with this PC's adopted archive and native binary.
[Unit]
Description=AgentsView scoped archive dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/SCOPED_ARCHIVE
Environment=AGENTSVIEW_DATA_DIR=/ABSOLUTE/SCOPED_ARCHIVE
Environment=AGENTSVIEW_TELEMETRY_ENABLED=0
Environment=AGENTSVIEW_DISABLE_UPDATE_CHECK=1
ExecStart=/ABSOLUTE/AGENTSVIEW_BINARY serve --host 127.0.0.1 --port 17384 --no-sync --no-browser --no-update-check
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
