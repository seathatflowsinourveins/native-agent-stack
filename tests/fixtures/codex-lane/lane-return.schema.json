{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "codex_lane.py test fixture copy of one lane-return object",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version", "lane", "catalog", "layer_id", "packet_sha256", "model",
  "winner_keys", "why_selected", "winner_evidence_class", "winner_evidence_refs",
  "alternatives", "overturn_when", "overturn_protocol", "open_gaps", "sources_read", "limits"
 ],
 "properties": {
  "schema_version": {"const": 1},
  "lane": {"enum": ["claude", "codex"]},
  "catalog": {"type": "string"},
  "layer_id": {"type": "string"},
  "packet_sha256": {"type": "string"},
  "model": {
   "type": "object", "additionalProperties": false, "required": ["name", "effort"],
   "properties": {"name": {"type": "string"}, "effort": {"type": "string"}}
  },
  "winner_keys": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
  "why_selected": {"type": "string", "minLength": 60},
  "winner_evidence_class": {"type": "string"},
  "winner_evidence_refs": {"type": "array", "items": {"type": "string"}},
  "alternatives": {"type": "array", "minItems": 1},
  "challenger_preferred": {"type": ["object", "null"]},
  "overturn_when": {"type": "string"},
  "overturn_protocol": {"type": "object"},
  "open_gaps": {"type": "array", "items": {"type": "string"}},
  "sources_read": {"type": "array", "items": {"type": "string"}},
  "limits": {"type": "array", "items": {"type": "string"}}
 }
}
