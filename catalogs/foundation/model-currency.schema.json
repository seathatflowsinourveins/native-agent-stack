{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native model currency scaffold and inventory",
  "description": "The existing Python publication validator also enforces UTC date arithmetic, exact HF revisions, package joins and 42/7-day limits. Empty pending inventory is not an adopted/current model census.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_status",
    "policy",
    "packages",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inventory_status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_release_age_days",
        "max_landscape_age_days",
        "refresh_lead_days"
      ],
      "properties": {
        "max_release_age_days": {
          "const": 42
        },
        "max_landscape_age_days": {
          "const": 7
        },
        "refresh_lead_days": {
          "const": 2
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "latest_version",
          "release_date",
          "release_source",
          "checked_at",
          "release_line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "latest_version": {
            "type": "string",
            "minLength": 1
          },
          "release_date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "release_source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "release_line": {
            "$ref": "#/$defs/release_line"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "consumer",
          "model_id",
          "revision",
          "release_date",
          "release_source",
          "checked_at",
          "status",
          "release_line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "release_date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "release_source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "in_use",
              "held",
              "package_bound"
            ]
          },
          "release_line": {
            "$ref": "#/$defs/release_line"
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "landscape_check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "sources",
              "newer_candidates",
              "reason"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "newer_candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model_id",
                    "revision",
                    "source",
                    "reason"
                  ],
                  "properties": {
                    "model_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "overturn": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "package_bound"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "package"
              ]
            }
          },
          {
            "if": {
              "required": [
                "landscape_check"
              ]
            },
            "then": {
              "required": [
                "overturn"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "release_line": {
                  "properties": {
                    "kind": {
                      "const": "huggingface"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "release_line"
              ]
            },
            "then": {
              "properties": {
                "revision": {
                  "pattern": "^[0-9a-f]{40}$",
                  "minLength": 40,
                  "maxLength": 40
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inventory_status": {
            "const": "complete"
          }
        },
        "required": [
          "inventory_status"
        ]
      },
      "then": {
        "properties": {
          "models": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "release_line": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "huggingface"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "const": "main",
              "description": "Follow the Hub default branch for currency; keep the immutable selected SHA in revision."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository"
          ],
          "properties": {
            "kind": {
              "const": "github_release"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "package"
          ],
          "properties": {
            "kind": {
              "const": "pypi"
            },
            "package": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "vendor_page"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    }
  }
}
