{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/native-agent-stack/**)",
      "Edit(~/.config/native-agent-stack/**)",
      "Read(~/.config/ecosystem-observability/*.env)",
      "Read(~/.config/nativestack/*.key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(//proc/*/environ)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(* --show-token*)",
      "Bash(security find-generic-password *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/hooks/secret_path_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
