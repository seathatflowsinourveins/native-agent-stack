// Source: jgravelle/jcodemunch-mcp v1.108.319,
// src/jcodemunch_mcp/config.py L346-354, L536-544, L1230-1254.
// https://github.com/jgravelle/jcodemunch-mcp/blob/v1.108.319/src/jcodemunch_mcp/config.py
// UTF-8 JSONC at the indexed project root; loader rules are at L630-727.
{
  // 2026-09-27: git ls-files measured 7,883 tracked paths, 4,907 excluded,
  // 2,976 remaining: 1,024 paths (34.4%) of growth above that inventory.
  // Counting all retained extensions is conservative; this is not a reindex
  // result. This config and its new test add two paths when they are tracked.
  // tests/test_jcodemunch_config.py recomputes the count on each test run.
  // Upstream's project override replaces its default 2,000-file folder cap:
  // security.py L589-592; config.py L346, L536.
  "max_folder_files": 4000,

  // Project patterns are merged by security.py L554-577 and compiled using
  // pathspec's gitignore dialect by tools/index_folder.py L1273-1279, at
  // https://github.com/jgravelle/jcodemunch-mcp/tree/v1.108.319/src/jcodemunch_mcp
  // Keep scripts, tools, tests, docs, examples, adoption, observability and
  // catalogs intact. Mixed blueprint trees retain their source/config files.
  "extra_ignore_patterns": [
    // Retained execution artifacts and receipts dominate the tracked inventory.
    "evidence/artifacts/**",
    "evidence/receipts/**",
    // These blueprint output-only directories contain no source code.
    "blueprints/**/receipts/**",
    "blueprints/**/native-outputs/**",
    "blueprints/**/judge_results/**",
    // Data directories also contain Python: exclude only serialized datasets.
    "blueprints/**/data/**/*.json",
    "blueprints/**/data/**/*.jsonl",
    "blueprints/**/data/**/*.csv",
    "blueprints/**/data/**/*.tsv",
    // Evidence directories include observer scripts: preserve those scripts.
    "blueprints/**/evidence/**/*.json",
    "blueprints/**/evidence/**/*.jsonl",
    "blueprints/**/evidence/**/*.txt",
    "blueprints/**/evidence/**/*.log",
    // Run directories include TOML configs: retain them, omit captured output.
    "blueprints/**/runs*/**/*.json",
    "blueprints/**/runs*/**/*.txt",
    "blueprints/**/runs*/**/*.stdout",
    "blueprints/**/runs*/**/*.stderr"
  ]
}
