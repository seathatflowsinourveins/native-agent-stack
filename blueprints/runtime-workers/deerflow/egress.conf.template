# nginx/nginx@release-1.28.0 src/http/modules/ngx_http_proxy_module.c:305-358,417-457
# Fixed upstream and paths: never proxy a caller-provided host, URL or CONNECT.
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
  client_body_temp_path /tmp/body;
  proxy_temp_path /tmp/proxy;
  log_format correlation escape=json '{"correlation_id":"$upstream_http_x_correlation_id","timestamp":$msec}';
  access_log /dev/stdout correlation;
  server {
    listen 3128;
    client_max_body_size 16m;
    location = /v1/responses {
      limit_except POST { deny all; }
      proxy_pass GATEWAY_ORIGIN;
      proxy_buffering off;
      proxy_read_timeout 2100s;
    }
    location = /v1/chat/completions {
      limit_except POST { deny all; }
      proxy_pass GATEWAY_ORIGIN;
      proxy_buffering off;
      proxy_read_timeout 2100s;
    }
    location / { return 403; }
  }
}
