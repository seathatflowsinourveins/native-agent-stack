{
  "mcpServers": {
    "context-mode": {
      "enabled": true,
      "type": "stdio",
      "command": "/runtime/stdio.sh",
      "args": [
        "${ECO_ROOT}/bin/node",
        "${ECO_ROOT}/tools/context-mode-1.0.169/lib/node_modules/context-mode/start.mjs"
      ],
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "PATH": "${ECO_ROOT}/bin:${HOST_PATH}",
        "CONTEXT_MODE_PLATFORM": "codex",
        "CONTEXT_MODE_PROJECT_DIR": "/work"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 120
    },
    "serena": {
      "enabled": true,
      "type": "stdio",
      "command": "/runtime/stdio.sh",
      "args": [
        "${ECO_ROOT}/bin/serena",
        "start-mcp-server",
        "--transport",
        "stdio",
        "--project-from-cwd",
        "--context",
        "codex",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ],
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "PATH": "${ECO_ROOT}/bin:${HOST_PATH}"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 120
    },
    "jcodemunch": {
      "enabled": true,
      "type": "stdio",
      "command": "/runtime/stdio.sh",
      "args": [
        "${ECO_ROOT}/bin/jcodemunch-mcp"
      ],
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "PATH": "${ECO_ROOT}/bin:${HOST_PATH}",
        "CODE_INDEX_PATH": "/state/mcp/jcodemunch",
        "JCODEMUNCH_SHARE_SAVINGS": "0"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 120
    },
    "qmd": {
      "enabled": true,
      "type": "stdio",
      "command": "/runtime/stdio.sh",
      "args": [
        "${ECO_ROOT}/bin/qmd",
        "--index",
        "native-agent-stack-catalog",
        "mcp"
      ],
      "env": {},
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 120
    },
    "socraticode": {
      "enabled": false,
      "type": "stdio",
      "command": "/runtime/stdio.sh",
      "args": [
        "${ECO_ROOT}/bin/node",
        "${ECO_ROOT}/tools/socraticode-1.14.0/lib/node_modules/socraticode/dist/index.js"
      ],
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "PATH": "${ECO_ROOT}/bin:${HOST_PATH}",
        "QDRANT_MODE": "external",
        "QDRANT_URL": "http://${QDRANT_URL}",
        "EMBEDDING_PROVIDER": "lmstudio",
        "LMSTUDIO_URL": "http://${EMBED_URL}/v1",
        "EMBEDDING_MODEL": "nvidia/Nemotron-3-Embed-1B-BF16",
        "EMBEDDING_DIMENSIONS": "2048",
        "EMBEDDING_CONTEXT_LENGTH": "4096",
        "EMBEDDING_QUERY_PREFIX": "query: ",
        "EMBEDDING_DOCUMENT_PREFIX": "passage: ",
        "EMBEDDING_DOCUMENT_INCLUDE_PATH": "true",
        "RESPECT_GITIGNORE": "true",
        "INCLUDE_DOT_FILES": "false",
        "SOCRATICODE_WATCHER": "manual",
        "SEARCH_DEFAULT_LIMIT": "3"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 120
    },
    "ai-memory": {
      "enabled": false,
      "type": "http",
      "url": "http://10.0.2.2:49474/mcp",
      "tool_name_prefix": true,
      "session_init_timeout": 60
    }
  },
  "skills": {}
}
