set -euo pipefail
umask 077
export PYTHONDONTWRITEBYTECODE=1
recipe_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$recipe_dir/dispatch.py" "$@"
