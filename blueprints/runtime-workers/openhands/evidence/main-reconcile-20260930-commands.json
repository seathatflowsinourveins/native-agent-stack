      "id": "published-artifact-source-identity",
      "argv": [
        "rtk",
        "<PRIVATE_RESEARCH>/venv/bin/python",
        "-c",
        "import hashlib,json,sys,tarfile,zipfile\nfrom pathlib import Path\np,site=map(Path,sys.argv[1:3]); results=[]\nartifacts=json.loads((p/'fresh-caller-artifacts.json').read_text())\nartifacts += [{'filename':'openhands_sdk-1.50.0-py3-none-any.whl','name':'openhands-sdk'}, {'filename':'openhands_tools-1.50.0-py3-none-any.whl','name':'openhands-tools'}]\nfor artifact in artifacts:\n f=p/artifact['filename']; sources=[]\n if f.suffix=='.whl':\n  with zipfile.ZipFile(f) as z:\n   sources=[(n,z.read(n)) for n in z.namelist() if n.endswith('.py')]\n else:\n  with tarfile.open(f,'r:gz') as t:\n   for member in t.getmembers():\n    rel='/'.join(member.name.split('/')[1:])\n    if rel.startswith('func_timeout/') and rel.endswith('.py'):\n     sources.append((rel,t.extractfile(member).read()))\n mismatches=[]\n for rel,data in sources:\n  target=site/rel\n  if not target.is_file() or target.read_bytes()!=data: mismatches.append(rel)\n results.append({'name':artifact['name'],'artifact':f.name,'artifact_sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'python_sources_compared':len(sources),'mismatches':mismatches})\nprint(json.dumps(results,indent=2))\nassert all(r['python_sources_compared']>0 and not r['mismatches'] for r in results)\n",
        "<PRIVATE_RESEARCH>",
        "<PRIVATE_RESEARCH>/venv/lib/python3.13/site-packages"
