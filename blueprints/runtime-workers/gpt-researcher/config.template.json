{
  "FAST_LLM": "openai:${GPTR_MODEL}",
  "SMART_LLM": "openai:${GPTR_MODEL}",
  "STRATEGIC_LLM": "openai:${GPTR_MODEL}",
  "LLM_KWARGS": {
    "base_url": "http://127.0.0.1:20128/v1",
    "api_key": "local-loopback",
    "temperature": null,
    "reasoning_effort": null,
    "use_responses_api": true,
    "output_version": "v0",
    "streaming": true,
    "max_retries": 0,
    "max_tokens": 12000,
    "timeout": 180,
    "default_headers": {"x-omniroute-session": "${GPTR_SESSION}"}
  },
  "RETRIEVER": "duckduckgo",
  "CONTEXT_FILTER": "keyword",
  "FAST_TOKEN_LIMIT": 6000,
  "SMART_TOKEN_LIMIT": 12000,
  "STRATEGIC_TOKEN_LIMIT": 8000,
  "SUMMARY_TOKEN_LIMIT": 700,
  "BROWSE_CHUNK_MAX_LENGTH": 4096,
  "MAX_SEARCH_RESULTS_PER_QUERY": 5,
  "MAX_ITERATIONS": 3,
  "MAX_SUBTOPICS": 3,
  "DEEP_RESEARCH_BREADTH": 3,
  "DEEP_RESEARCH_DEPTH": 2,
  "DEEP_RESEARCH_CONCURRENCY": 2,
  "MAX_SCRAPER_WORKERS": 4,
  "SCRAPER_RATE_LIMIT_DELAY": 0.5,
  "SCRAPER": "bs",
  "CURATE_SOURCES": false,
  "TOTAL_WORDS": 1200,
  "REPORT_SOURCE": "web",
  "IMAGE_GENERATION_ENABLED": false,
  "MCP_SERVERS": [],
  "MCP_STRATEGY": "fast",
  "MCP_AUTO_TOOL_SELECTION": true,
  "VERBOSE": true
}
