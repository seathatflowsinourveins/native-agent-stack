{
  "llm": {
    "model": "cx/gpt-6-astra-max",
    "model_env": "CRAWL4AI_MODEL",
    "provider_prefix": "openai/",
    "base_url": "http://127.0.0.1:20128/v1",
    "container_base_url": "http://10.0.2.2:20128/v1",
    "api_token": "local-loopback",
    "max_tokens": 3000,
    "timeout_seconds": 180
  },
  "comparison": {
    "model": "cx/gpt-6-sol",
    "model_env": "CRAWL4AI_COMPARISON_MODEL",
    "reasoning_effort": "medium"
  },
  "content": {
    "input_format": "fit_markdown",
    "pruning_threshold": 0.35,
    "pruning_threshold_type": "fixed",
    "min_word_threshold": 1,
    "chunk_token_threshold": 4096,
    "overlap_rate": 0.0,
    "word_token_rate": 1.3,
    "max_fit_characters": 6000,
    "excluded_tags": ["nav", "footer", "aside"]
  },
  "e2e": {
    "arms": ["primary", "comparison"],
    "pages": ["beacon.html", "flask.html", "lamp.html"],
    "scope": "synthetic frozen fixture; native extraction plus container API/MCP transport checks"
  }
}
