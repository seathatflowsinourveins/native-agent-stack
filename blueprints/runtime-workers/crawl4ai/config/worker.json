{
  "llm": {
    "provider_prefix": "openai/",
    "api_token": "local-loopback",
    "max_tokens": 3000,
    "timeout_seconds": 180
  },
  "content": {
    "input_format": "fit_markdown",
    "pruning_threshold": 0.35,
    "pruning_threshold_type": "fixed",
    "min_word_threshold": 1,
    "chunk_token_threshold": 4096,
    "overlap_rate": 0.0,
    "word_token_rate": 1.3,
    "max_fit_characters": 6000,
    "excluded_tags": [
      "nav",
      "footer",
      "aside"
    ]
  },
  "e2e": {
    "arms": [
      "control",
      "engines-on"
    ],
    "pages": [
      "beacon.html",
      "flask.html",
      "lamp.html"
    ],
    "scope": "synthetic frozen fixture; native extraction plus container API/MCP transport checks"
  },
  "arms": {
    "control": {
      "model": "cx/gpt-6-astra-max",
      "model_env": "CRAWL4AI_MODEL",
      "base_url": "http://127.0.0.1:20128/v1",
      "base_url_env": "CRAWL4AI_BASE_URL",
      "container_base_url": "http://10.0.2.2:20128/v1",
      "expected_effort": "max",
      "gateway": "omniroute"
    },
    "engines-on": {
      "model": "sharedgw/gpt-6-astra-max",
      "model_env": "CRAWL4AI_MODEL",
      "base_url": "http://127.0.0.1:20129/v1",
      "base_url_env": "CRAWL4AI_BASE_URL",
      "container_base_url": "http://10.0.2.2:20129/v1",
      "expected_effort": "max",
      "gateway": "omniroute-fw"
    },
    "comparison": {
      "model": "cx/gpt-6-sol",
      "model_env": "CRAWL4AI_COMPARISON_MODEL",
      "base_url": "http://127.0.0.1:20128/v1",
      "base_url_env": "CRAWL4AI_BASE_URL",
      "container_base_url": "http://10.0.2.2:20128/v1",
      "expected_effort": "medium",
      "gateway": "omniroute"
    }
  }
}
