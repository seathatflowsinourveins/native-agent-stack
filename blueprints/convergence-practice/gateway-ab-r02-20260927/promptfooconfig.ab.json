{
  "description": "R02 gateway A/B (FW effort), arm order A-B per filing",
  "prompts": [
    "file://prompt_r02.py:build_prompt"
  ],
  "providers": [
    {
      "id": "http",
      "label": "r02-A",
      "config": {
        "url": "http://127.0.0.1:20128/v1/chat/completions",
        "method": "POST",
        "maxRetries": 0,
        "headers": {
          "Content-Type": "application/json",
          "x-omniroute-session": "r02-a-{{accession}}-r{{__repeatIndex}}-{{__evalId}}",
          "Idempotency-Key": "r02-a-{{__evalId}}-{{__evalStepId}}",
          "X-Correlation-Id": "r02-a-{{__evalId}}-{{__evalStepId}}",
          "X-OmniRoute-No-Cache": "true"
        },
        "body": {
          "model": "cx/gpt-6-astra",
          "messages": [
            {
              "role": "user",
              "content": "{{prompt}}"
            }
          ],
          "stream": true,
          "stream_options": {
            "include_usage": true
          },
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "name": "li26_filing_items",
              "strict": true,
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
