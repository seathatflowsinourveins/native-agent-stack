                        "6.05",
                        "6.06",
                        "6.10",
                        "7.01",
                        "8.01",
                        "9.01"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "transformResponse": "file://transform_r02.js"
      }
    },
