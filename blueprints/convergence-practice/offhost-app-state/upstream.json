    "test_selections": [
      {
        "id": "memory-upstream-backup",
        "command": [
          "cargo",
          "test",
          "--locked",
          "-p",
          "ai-memory-mcp",
          "--lib",
          "integration::admin_backup::",
          "--",
          "--nocapture"
        ],
        "expected_tests": [
          "integration::admin_backup::backup_returns_application_gzip_content_type",
          "integration::admin_backup::backup_body_is_valid_gzip_and_contains_seeded_page",
          "integration::admin_backup::backup_empty_store_still_succeeds",
          "integration::admin_backup::backup_does_not_dereference_wiki_symlinks"
        ]
      },
      {
        "id": "memory-upstream-restore",
        "command": [
          "cargo",
          "test",
          "--locked",
          "-p",
          "ai-memory-cli",
          "--lib",
          "commands::restore::tests::",
          "--",
          "--nocapture"
        ],
        "expected_tests": [
          "commands::restore::tests::restore_accepts_expected_backup_paths",
          "commands::restore::tests::restore_rejects_link_entries",
          "commands::restore::tests::validate_restore_entry_accepts_gnu_sparse_for_the_sqlite_path",
          "commands::restore::tests::validate_restore_entry_still_rejects_gnu_sparse_at_an_unexpected_path",
          "commands::restore::tests::restore_rejects_unexpected_or_unsafe_paths",
          "commands::restore::tests::restore_round_trips_a_real_gnu_sparse_sqlite_snapshot"
        ]
      }
    ]
