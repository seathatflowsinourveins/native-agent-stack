{
  "mcpServers": {
    "serena": {
      "command": "@ECO_ROOT@/bin/serena",
      "args": [
        "start-mcp-server",
        "--transport",
        "stdio",
        "--project-from-cwd",
        "--context",
        "codex",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ],
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "SERENA_HOME": "@STATE@/arms/stack/serena-home"
      },
      "cwd": ".",
      "timeout": 120,
      "exposure": "deferred"
    },
    "jcodemunch": {
      "command": "@ECO_ROOT@/bin/jcodemunch-mcp",
      "env": {
        "RTK_TELEMETRY_DISABLED": "1",
        "CODE_INDEX_PATH": "@STATE@/arms/stack/jcodemunch-index",
        "JCODEMUNCH_SHARE_SAVINGS": "0"
      },
      "cwd": ".",
      "timeout": 120,
      "exposure": "deferred",
      "toolExposure": {
        "route": "deferred",
        "menu": "deferred",
        "order": "deferred",
        "*": "hidden"
      }
    },
    "qmd": {
      "command": "@ECO_ROOT@/bin/qmd",
      "args": [
        "--index",
        "native-agent-stack-catalog",
        "mcp"
      ],
      "cwd": ".",
      "timeout": 120,
      "exposure": "deferred",
      "toolExposure": {
        "query": "deferred",
        "get": "deferred",
        "multi_get": "deferred",
        "status": "deferred",
        "*": "hidden"
      }
    },
    "headroom": {
      "command": "@ECO_ROOT@/bin/headroom",
      "args": [
        "mcp",
        "serve",
        "--proxy-url",
        "http://127.0.0.1:1"
      ],
      "env": {
        "HEADROOM_OFFLINE": "1",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "DO_NOT_TRACK": "1"
      },
      "cwd": ".",
      "timeout": 120,
      "exposure": "deferred",
      "toolExposure": {
        "headroom_compress": "deferred",
        "headroom_retrieve": "deferred",
        "headroom_stats": "deferred",
        "*": "hidden"
      }
    }
  }
}
