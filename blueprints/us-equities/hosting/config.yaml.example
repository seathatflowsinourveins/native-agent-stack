host: 127.0.0.1
port: 18525
check_updates: false
metrics: private
# dagucloud/dagu@v2.16.6:internal/cmd/startall.go:32-45 starts both services;
# internal/cmn/config/loader.go:1311-1319 defaults this optional coordinator on.
coordinator:
  enabled: false
env_passthrough:
  - STACK_REPO
  - SDK_ENV
  - LEAN_EVENTS
  - RESEARCH_OUTPUT
auth:
  mode: none
permissions:
  write_dags: false
  run_dags: false
