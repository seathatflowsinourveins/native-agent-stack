host: 127.0.0.1
port: 18525
check_updates: false
metrics: private
env_passthrough:
  - STACK_REPO
  - SDK_ENV
  - LEAN_EVENTS
  - RESEARCH_OUTPUT
  - LEAN_RESULTS
  - RESEARCH_WORKSPACE
  - NATIVE_CODEX_HOME
  - NATIVE_CODEX_BIN
  - NATIVE_CLAUDE_BIN
  - NATIVE_RUNTIME_PATH
  - SDK_OBSERVATION_DIR
auth:
  mode: basic
  basic:
    username: local-research
    password: REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD
permissions:
  write_dags: false
  run_dags: false
