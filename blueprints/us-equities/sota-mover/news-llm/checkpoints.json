 "load_policy": {
  "weights": "torch.load(path, map_location='cpu', weights_only=True, mmap=True); pytorch_model.bin and config.pt are pickles and are never loaded any other way",
  "config": "config.json (plain JSON) is used; config.pt is downloaded and hash-verified but never unpickled",
  "code": "ChronoGPT_instruct.py is imported from the verified local file by path after its sha256 matches reviewed_code.sha256; ChronoGPT.from_pretrained (network download plus torch.load without weights_only) is never called; no remote-code loader is used",
  "network": "HF_HUB_OFFLINE=1 and TIKTOKEN_CACHE_DIR=<storage_root>/tiktoken-cache are set before the first import in the scoring process"
 },
 "reviewed_code": {
  "file": "ChronoGPT_instruct.py",
  "sha256": "60af30736d94f8db2be3da7cea5ca045430d33b8aaf384fe953a496380bdb462",
  "identical_across_revisions": true,
  "review_2026_09_25": [
   "Module-level imports: os, json, math, torch, torch.nn, torch.nn.functional, typing, huggingface_hub (PyTorchModelHubMixin, hf_hub_download). No exec, eval, compile, subprocess, socket or pickle use at import time.",
   "Network: only ChronoGPT.from_pretrained calls hf_hub_download; it is not called here.",
   "Deserialization: from_pretrained uses torch.load without weights_only; not called here. save_pretrained writes files; not called here.",
   "forward(): pure tensor math (embeddings, RMS norm, rotary, causal scaled_dot_product_attention, ReLU^2 MLP, U-net skip weights, tanh logit soft-cap at 15) under torch.inference_mode; there is no padding mask, so batched inputs are right-padded and read at each sequence's own last position (causal attention keeps earlier positions independent of later padding).",
   "Rotary buffers are created for max_seq_len=65536 unless the module is built on the meta device; score.py builds on meta and recreates them on the GPU with max_seq_len=2048 (>= the 1,792-token context)."
  ]
 },
