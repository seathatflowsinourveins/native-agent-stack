{
  "schema_version": 1,
  "kind": "canary_sink_table",
  "as_of": "2026-09-29",
  "source": "The research_sinks scan plan (49 sinks) and its verification verify_sinks (37 confirmed, 12 corrected, 13 missed items) of the D1 key-management design, 2026-09-29; design notes, not in this repository. Every row is an unverified sink fact until its positive control passes in a run: a sink whose declared control decoy is not found is reported as 'not a sink, or scanned wrongly', never as clean.",
  "path_tokens": "Paths use the templates of scripts/credential_status.py (${NAME:-default} and $HOME), plus $CHECKOUT (this repository's checkout) and $UID; a * is a glob, ** a recursive one.",
  "controls_legend": {
    "claude": "D-claude: in the fresh-claude-session prompt, echoed with `echo <decoy> && false` (a failed command: RTK recall keeps output only for those)",
    "subagent": "D-subagent: fetched by the subagent itself with `canary_e2e.py decoy`, then echoed, so only the subagent's own records hold it",
    "wf": "D-wf: fetched by the workflow child with `canary_e2e.py decoy`, then echoed, so the coordinator's transcript never holds it",
    "codex": "D-codex: in the codex-exec prompt (stdin), echoed",
    "omni": "D-omni: in the omniroute-lane prompt (stdin), echoed",
    "journal": "D-journal: written to the user journal through systemd-cat from stdin by `controls`; it cannot be deleted, so it is a decoy-only value",
    "loki": "D-loki: pushed to Loki's push API by `settle`, which times its arrival",
    "rtk": "D-rtk: the Claude run's `rtk err python3 tools/credentials/canary_e2e.py decoy ... --rtk <decoy>` fails with about 840 bytes of decoy lines, over RTK v0.50.0's 500-byte recall gate; the command text carries it into history.db and the decoded recall blob into recall.db",
    "capture": "D-capture: a line the harness writes at the start of every capture of a client's streams, so each capture it scans has its own positive control (not a sink-table control)"
  },
  "exclude": [
    "${XDG_CONFIG_HOME:-$HOME/.config}/native-agent-stack",
    "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json",
    "${CODEX_HOME:-$HOME/.codex}/auth.json",
    "$HOME/.ssh",
    "$HOME/.gnupg",
    "${XDG_CONFIG_HOME:-$HOME/.config}/gh"
  ],
  "exclude_names": ["shell_snapshots", "config.v2.json", "hostconfig.json"],
  "exclude_note": "The harness also excludes its own run directory, its receipts and keep directories, and every user-run sink's paths. By name, at any depth, every agent-run scan excludes a directory named shell_snapshots (a Codex store of `declare -x` lines, guard-denied) and Docker's config.v2.json and hostconfig.json (container environments): an agent-run process never reads a real value, so those are user-run only, with the OmniRoute data, ~/.docker/config.json and the user manager's environment.",
  "sinks": [
    {"id": "S01-claude-transcripts", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"], "path_class": "claude/projects", "persisted": true, "controls": ["claude", "subagent", "wf"], "async": false, "retention": "cleanupPeriodDays=3650 here (default 30)", "fact": "confirmed", "note": "session JSONL, subagents/*.jsonl, workflow journals and memory/*.md (S09)"},
    {"id": "S02-claude-prompt-history", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/history.jsonl"], "path_class": "claude/history.jsonl", "persisted": true, "controls": [], "async": false, "retention": "never swept (claude-directory doc)", "fact": "corrected", "note": "typed prompts; whether a -p prompt read from stdin is recorded is unverified, so no control is declared"},
    {"id": "S03-claude-file-history", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/file-history"], "path_class": "claude/file-history", "persisted": true, "controls": [], "async": false, "retention": "swept at cleanupPeriodDays; the 100 most recent checkpoints", "fact": "corrected"},
    {"id": "S04-claude-paste-cache", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/paste-cache"], "path_class": "claude/paste-cache", "persisted": true, "controls": [], "async": false, "retention": "swept at cleanupPeriodDays", "fact": "corrected"},
    {"id": "S05-claude-shell-snapshots", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/shell-snapshots"], "path_class": "claude/shell-snapshots", "persisted": true, "controls": [], "async": false, "retention": "removed on clean exit", "fact": "corrected", "note": "only PATH is exported (verified)"},
    {"id": "S06-claude-session-env", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/session-env"], "path_class": "claude/session-env", "persisted": true, "controls": [], "async": false, "retention": "swept at cleanupPeriodDays", "fact": "corrected"},
    {"id": "S07-claude-aux-state", "kind": "files", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plans", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/teams", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/tasks", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/jobs", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/daemon", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/feedback", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/cache", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/debug", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/image-cache", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/uploads", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/tool-results"], "path_class": "claude/state", "persisted": true, "controls": [], "async": false, "retention": "plans, tasks, debug, image-cache, uploads and tool-results swept at cleanupPeriodDays; jobs and daemon kept", "fact": "corrected"},
    {"id": "S08-client-config-and-backups", "kind": "files", "access": "agent", "paths": ["$HOME/.claude.json*", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json*", "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/backups"], "path_class": "claude/config", "persisted": true, "controls": [], "async": false, "retention": "backups/ keeps at most 5 (claude-directory doc)", "fact": "corrected", "note": "also verify_sinks' missed item ~/.claude/backups"},
    {"id": "S09-claude-auto-memory", "kind": "covered", "access": "agent", "paths": [], "path_class": "claude/projects/*/memory", "persisted": true, "controls": [], "async": false, "retention": "until edited", "fact": "confirmed", "note": "inside S01's root"},
    {"id": "S10-configchange-audit-log", "kind": "files", "access": "agent", "paths": ["$HOME/claude-config-audit.log"], "path_class": "claude/config-audit", "persisted": true, "controls": [], "async": false, "retention": "unbounded append", "fact": "confirmed"},
    {"id": "S11-claude-mcp-logs", "kind": "files", "access": "agent", "paths": ["${XDG_CACHE_HOME:-$HOME/.cache}/claude-cli-nodejs"], "path_class": "claude/mcp-logs", "persisted": true, "controls": [], "async": false, "retention": "unknown", "fact": "corrected"},
    {"id": "S12-codex-rollouts", "kind": "files", "access": "agent", "paths": ["${CODEX_HOME:-$HOME/.codex}/sessions", "${CODEX_HOME:-$HOME/.codex}/archived_sessions", "${CODEX_HOME:-$HOME/.codex}/history.jsonl"], "path_class": "codex/sessions", "persisted": true, "controls": ["codex", "omni"], "async": false, "retention": "no automatic deletion found", "fact": "confirmed", "note": "lane CODEX_HOMEs under the private state directory are covered by S24"},
    {"id": "S13-codex-sqlite", "kind": "sqlite", "access": "agent", "paths": ["${CODEX_HOME:-$HOME/.codex}/*.sqlite"], "path_class": "codex/sqlite", "persisted": true, "controls": ["codex", "omni"], "async": false, "retention": "unknown", "fact": "confirmed"},
    {"id": "S14-codex-shell-snapshots", "kind": "files", "access": "user_run", "paths": ["${CODEX_HOME:-$HOME/.codex}/shell_snapshots", "${XDG_STATE_HOME:-$HOME/.local/state}/native-agent-stack/**/shell_snapshots"], "path_class": "codex/shell_snapshots", "persisted": true, "controls": [], "async": false, "retention": "3 days upstream (codex-rs/core/src/shell_snapshot.rs:105 at rust-v0.157.1), yet older files remain", "retention_seconds": 259200, "fact": "corrected", "note": "guard-denied store of `declare -x` lines: user-run only. Every CODEX_HOME the consumers use must set features.shell_snapshot = false (the harness refuses otherwise), so no snapshot should be written; lane homes under /tmp are not listed"},
    {"id": "S15-codex-config-and-logs", "kind": "files", "access": "agent", "paths": ["${CODEX_HOME:-$HOME/.codex}/*.toml*", "${CODEX_HOME:-$HOME/.codex}/log"], "path_class": "codex/config", "persisted": true, "controls": [], "async": false, "retention": "backups are never pruned", "fact": "confirmed"},
    {"id": "S16-context-mode", "kind": "sqlite", "access": "agent", "paths": ["${CLAUDE_CONFIG_DIR:-$HOME/.claude}/context-mode", "${CODEX_HOME:-$HOME/.codex}/context-mode"], "path_class": "context-mode", "persisted": true, "controls": ["claude"], "async": false, "retention": "fetched URLs older than 14 days are cleaned at start; sessions unknown", "fact": "confirmed", "note": "the control rests on context-mode recording tool failures of a Claude session (unverified)"},
    {"id": "S17-ai-memory", "kind": "sqlite", "access": "agent", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/ai-memory"], "path_class": "ai-memory", "persisted": true, "controls": ["claude"], "async": true, "retention": "unknown; wiki git history is permanent", "fact": "confirmed", "note": "memory.sqlite, wiki Markdown and the hook spool; the wiki's git objects are S17-ai-memory-wiki-git"},
    {"id": "S17-ai-memory-wiki-git", "kind": "git", "access": "agent", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/ai-memory/wiki"], "path_class": "ai-memory/wiki git", "persisted": true, "controls": [], "async": false, "retention": "permanent", "fact": "confirmed"},
    {"id": "S18-rtk-history", "kind": "sqlite", "access": "agent", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/rtk/history.db*"], "path_class": "rtk/history", "persisted": true, "controls": ["rtk"], "async": false, "retention": "commands 90 days (rtk-ai/rtk@v0.50.0 src/core/tracking.rs:10)", "fact": "corrected", "note": "the commands RTK ran; a command the RTK hook does not rewrite, such as echo, never reaches it. The control is the `rtk err ... decoy --rtk <decoy>` command of the Claude run, whose text carries the RTK decoy"},
    {"id": "S18-rtk-recall", "kind": "sqlite", "access": "agent", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/rtk/recall.db*"], "path_class": "rtk/recall", "persisted": true, "controls": ["rtk"], "control_in": "decoded_blobs", "async": false, "retention": "recall 30 days (rtk-ai/rtk@v0.50.0 src/core/retriever.rs:17)", "retention_seconds": 2592000, "fact": "corrected", "note": "the raw output of a failed command of 500 bytes or more (retriever.rs:18 MIN_FAILURE_BYTES, tee.rs:61-66), gzip-coded; the control counts only in the decoded blobs, never in the command column"},
    {"id": "S19-qmd", "kind": "sqlite", "access": "agent", "paths": ["${XDG_CACHE_HOME:-$HOME/.cache}/qmd"], "path_class": "qmd", "persisted": true, "controls": [], "async": false, "retention": "until reindexed", "fact": "confirmed"},
    {"id": "S20-headroom", "kind": "sqlite", "access": "agent", "paths": ["$HOME/.headroom"], "path_class": "headroom", "persisted": true, "controls": [], "async": false, "retention": "per-entry ttl", "fact": "confirmed"},
    {"id": "S21-agentsview", "kind": "sqlite", "access": "agent", "paths": ["$HOME/.agentsview"], "path_class": "agentsview", "persisted": true, "controls": ["claude"], "async": true, "retention": "archive; unknown whether rows outlive the source transcript", "fact": "confirmed"},
    {"id": "S22-hindsight", "kind": "covered", "access": "agent", "paths": [], "path_class": "state/s3-arms/hindsight", "persisted": true, "controls": [], "async": false, "retention": "live.log never rotated; database unknown", "fact": "confirmed", "note": "inside S24's root; its pg0 files are scanned raw, and no pg_dump is run"},
    {"id": "S23-cognee-docker", "kind": "covered", "access": "agent", "paths": [], "path_class": "docker/cognee", "persisted": true, "controls": [], "async": false, "retention": "json-file logs never rotated", "fact": "confirmed", "note": "inside S37's roots"},
    {"id": "S24-private-state-dirs", "kind": "sqlite", "access": "agent", "paths": ["${XDG_STATE_HOME:-$HOME/.local/state}/native-agent-stack", "${XDG_DATA_HOME:-$HOME/.local/share}/native-agent-stack"], "path_class": "stack state", "persisted": true, "controls": [], "async": false, "retention": "manual", "fact": "confirmed", "note": "the canary's own state directory is excluded"},
    {"id": "S25-omniroute-main", "kind": "sqlite", "access": "user_run", "paths": ["$HOME/.omniroute", "${XDG_CONFIG_HOME:-$HOME/.config}/omniroute"], "path_class": "omniroute", "persisted": true, "controls": ["omni"], "async": false, "retention": "CALL_LOG_RETENTION_DAYS default 7; cleanup at server start", "retention_seconds": 604800, "fact": "corrected", "note": "holds upstream account tokens (Read-denied, guard-blocked): user-run only. If D-omni is absent the call logs keep no content, and the canary count here says nothing"},
    {"id": "S26-omniroute-fw", "kind": "sqlite", "access": "user_run", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/omniroute-fw", "${XDG_DATA_HOME:-$HOME/.local/share}/omniroute"], "path_class": "omniroute-fw", "persisted": true, "controls": [], "async": false, "retention": "as S25", "fact": "confirmed", "note": "the header-routing gateway on 20129, not on the lane's route to 20128"},
    {"id": "S27-otel-collector", "kind": "files", "access": "agent", "paths": ["${XDG_DATA_HOME:-$HOME/.local/share}/codex-ecosystem/observability/collector"], "path_class": "otel collector", "persisted": true, "controls": [], "async": false, "retention": "events.jsonl rotates at 10 MB, 3 backups", "fact": "confirmed", "note": "tool content is deleted before any exporter"},
    {"id": "S28-loki", "kind": "loki", "access": "agent", "url": "http://127.0.0.1:13100", "paths": [], "path_class": "loki", "persisted": true, "controls": ["loki"], "async": true, "retention": "retention_period 72h, delete delay 2h", "retention_seconds": 259200, "fact": "confirmed", "note": "dumped by time range and labels only; matching is local and nothing is written"},
    {"id": "S29-prometheus", "kind": "not_scanned", "access": "not_scanned", "paths": [], "path_class": "prometheus", "persisted": true, "controls": [], "async": false, "retention": "7d / 512MB", "fact": "confirmed", "note": "metrics and label values only; no consumer path writes content there"},
    {"id": "S30-journald-user", "kind": "journal", "access": "agent", "scope": "user", "paths": [], "path_class": "journal/user", "persisted": true, "controls": ["journal"], "async": false, "retention": "journald defaults (no SystemMaxUse or MaxRetentionSec)", "fact": "corrected", "note": "export format, from the run's start, so _CMDLINE and decompressed fields are read"},
    {"id": "S30-journald-system", "kind": "journal", "access": "sudo", "scope": "system", "paths": [], "path_class": "journal/system", "persisted": true, "controls": ["journal"], "async": false, "retention": "journald defaults", "fact": "corrected"},
    {"id": "S31-syslog-authlog", "kind": "files", "access": "sudo", "paths": ["/var/log/syslog*", "/var/log/auth.log*"], "path_class": "syslog", "persisted": true, "controls": ["journal"], "async": false, "retention": "weekly rotation, 4 kept", "fact": "confirmed", "note": "ForwardToSyslog=yes comes from a systemd vendor drop-in"},
    {"id": "S32-git-main-checkout", "kind": "git", "access": "agent", "paths": ["$CHECKOUT"], "path_class": "git/this repository", "persisted": true, "controls": [], "async": false, "retention": "git defaults", "fact": "confirmed", "note": "every worktree shares this object store; reflogs of each worktree are read"},
    {"id": "S33-git-other-repos", "kind": "git", "access": "agent", "paths": ["$HOME/code/*"], "path_class": "git/other repositories", "persisted": true, "controls": [], "async": false, "retention": "git defaults", "fact": "confirmed"},
    {"id": "S34-shell-history", "kind": "files", "access": "agent", "paths": ["$HOME/.bash_history", "$HOME/.zsh_history"], "path_class": "shell history", "persisted": true, "controls": [], "async": false, "retention": "HISTFILESIZE=2000", "fact": "confirmed"},
    {"id": "S35-tmp-claude", "kind": "files", "access": "agent", "paths": ["/tmp/claude-$UID"], "path_class": "tmp/claude", "persisted": true, "controls": [], "async": false, "retention": "tmpfiles 'D /tmp 1777 root root 30d'", "retention_seconds": 2592000, "fact": "confirmed"},
    {"id": "S36-tmp-other", "kind": "files", "access": "agent", "paths": ["/tmp", "/var/tmp"], "exclude": ["/tmp/claude-$UID", "/tmp/systemd-private-*", "/var/tmp/systemd-private-*", "/tmp/snap-private-tmp"], "path_class": "tmp", "persisted": true, "controls": [], "async": false, "retention": "as S35", "fact": "confirmed", "note": "root's 0700 private directories (systemd PrivateTmp, snap) are excluded by name: a process of this user cannot write there. Any other unreadable path makes the sink INCOMPLETE"},
