# One tick of the local Claude review worker (tools/claude-review-worker/README.md;
# docs/decisions/2026-10-09-claude-review-worker.md). Drafted here, installed by the command center; the timer beside
# this file starts it. It has no [Install] section, matching the timer-triggered oneshot convention of
# adoption/templates/systemd.
#
# @REPOSITORY@ is the checkout that holds this tool. On the workstation that is the live clone,
# %h/code/native-agent-stack-live, as for credential-boot-receipt.service: never a working checkout, whose revision
# moves, and never a build worktree, which a merge deletes. Substitute it before installing, then verify both units:
#   sed 's#@REPOSITORY@#%h/code/native-agent-stack-live#g' tools/claude-review-worker/systemd/claude-review-worker.service > ~/.config/systemd/user/claude-review-worker.service
#   cp tools/claude-review-worker/systemd/claude-review-worker.timer ~/.config/systemd/user/
#   systemd-analyze --user verify ~/.config/systemd/user/claude-review-worker.service ~/.config/systemd/user/claude-review-worker.timer
#
# The environment file is documented in the README and is not created by the repository. It names the ledger and the
# switches, never a key; without it the unit does not start. The key stays in the per-host store: credential_run.py
# reads it and hands it to the sandboxed claude process through that process's environment only.
#
# PATH: gh is reached through the mise shims on the workstation, and the user manager's own PATH lacks them; on another
# host use the directories that hold gh and git. A PATH set in the environment file wins over this line
# (systemd.exec(5): settings from EnvironmentFile= override Environment=).
[Unit]
Description=Claude local review worker (one tick)
Documentation=https://github.com/seathatflowsinourveins/native-agent-stack/blob/main/tools/claude-review-worker/README.md

[Service]
Type=oneshot
EnvironmentFile=%h/.config/claude-review-worker.env
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I @REPOSITORY@/tools/claude-review-worker/worker.py run
# Two reviews of at most CLAUDE_REVIEW_TIMEOUT_SECONDS each (2700 by default), one after another, plus git work.
TimeoutStartSec=2h
Nice=10
