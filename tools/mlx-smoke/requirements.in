# Recompiled with `--exclude-newer 2026-09-23T00:00:00Z` and `--no-header`
# (see .github/workflows/hardware-profile-smoke.yml, where both the committed
# lock generation and the CI diff-check recompile pass the same cutoff; the
# lock file itself carries no header comment) so CI's redundant-compile-and-diff
# check stays deterministic over time: without a cutoff, any transitive
# dependency publishing a new release after this file was generated would
# make uv resolve a different set and fail the diff on every unrelated pull
# request.
# mlx-lm 0.30.2 pinned transformers==5.0.0rc1, so the security floors below need a newer
# mlx-lm; 0.31.3 is the newest release before the cutoff. Newer mlx wheels are published only for
# macOS 14+, so both this lock and the CI diff-check compile with MACOSX_DEPLOYMENT_TARGET=14.0.
mlx-lm==0.31.3
# Security floors (Dependabot alerts 2026-09-23): transformers < 5.10.0 has GHSA-xrqw-3rrv-vx5w,
# GHSA-fgcw-684q-jj6r, GHSA-29pf-2h5f-8g72 and GHSA-69w3-r845-3855; mlx <= 0.29.3 has
# GHSA-j842-xgm4-wf88 and GHSA-w6vg-jg77-2qg6. The floors make the pinned resolver pick fixed versions.
transformers>=5.10.0
mlx>=0.29.4
