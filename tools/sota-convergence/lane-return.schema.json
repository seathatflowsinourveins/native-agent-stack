{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer-verdict lane return v1",
  "description": "One lane's (claude or codex) judgment of one catalog layer's packet, produced by tools/sota-convergence/lane_packets.py and consumed by (a later unit's) record_verdicts.py. Fully inlined (no $ref/$defs) and additionalProperties: false everywhere so this file is directly usable as a codex --output-schema file. evidence_class/disposition enum values are the sorted WINNER_EVIDENCE_CLASSES/DISPOSITIONS sets from scripts/landscape.py, duplicated here literally because a static schema file cannot import them at runtime; tests/test_lane_packets.py asserts the two stay in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lane", "catalog", "layer_id", "packet_sha256", "model", "winner_keys",
    "why_selected", "winner_evidence_class", "winner_evidence_refs", "alternatives",
    "challenger_preferred", "overturn_when", "overturn_protocol", "open_gaps", "sources_read", "limits"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "lane": {"type": "string", "enum": ["claude", "codex"]},
    "catalog": {"type": "string", "enum": ["foundation", "us-equities"]},
    "layer_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effort"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      }
    },
    "winner_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "why_selected": {"type": "string", "minLength": 60},
    "winner_evidence_class": {
      "type": "string",
      "enum": ["local_integration", "measured_comparison", "native_proven", "source_review", "synthetic"]
    },
    "winner_evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "repository", "disposition", "why_not_default", "evidence_class", "evidence_refs"],
        "properties": {
          "key": {"type": ["string", "null"]},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^https://", "minLength": 1},
          "disposition": {
            "type": "string",
            "enum": ["conditional", "measured_tradeoff", "observed_failure", "out_of_scope", "overlap", "selected", "unqualified"]
          },
          "why_not_default": {"type": "string", "minLength": 30},
          "evidence_class": {
            "type": "string",
            "enum": ["local_integration", "measured_comparison", "native_proven", "source_review", "synthetic"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "challenger_preferred": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["key", "name", "repository", "why", "required_comparison"],
      "properties": {
        "key": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "required_comparison": {"type": "string", "minLength": 1}
      }
    },
    "overturn_when": {"type": "string", "minLength": 1},
    "overturn_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_paths", "metric", "arms"],
      "properties": {
        "fixture_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "metric": {"type": "string"},
        "arms": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "open_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources_read": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
