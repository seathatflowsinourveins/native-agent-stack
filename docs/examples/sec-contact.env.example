# Template for ${XDG_CONFIG_HOME:-$HOME/.config}/native-agent-stack/sec-contact.env
# Private contact data (SEC fair-access User-Agent), not an auth secret; keep it 0600.
# Quote the value because it contains spaces.
export SEC_USER_AGENT="Your Name your.address@example.com"
export EDGAR_IDENTITY="$SEC_USER_AGENT"
