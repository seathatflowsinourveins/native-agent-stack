# DRAFT ONLY. Not installed or enabled.
# Proposed cadence, not a vendor default or measured optimum.
# systemd 259.5 systemd.timer(5): UTC calendars and bounded jitter.
[Unit]
Description=Daily native QMD lexical index refresh schedule (draft)

[Timer]
OnCalendar=*-*-* 02:45:00 UTC
RandomizedDelaySec=15min
AccuracySec=1min
Persistent=false
Unit=native-memory-qmd-update.service

[Install]
WantedBy=timers.target
