# DRAFT ONLY. Not installed or enabled.
# Proposed cadence, not a vendor default or measured optimum.
# systemd 259.5 systemd.timer(5): UTC calendars and bounded jitter.
[Unit]
Description=Weekly ai-memory retention preview schedule (draft)

[Timer]
OnCalendar=Sat *-*-* 03:30:00 UTC
RandomizedDelaySec=15min
AccuracySec=1min
Persistent=false
Unit=native-memory-ai-retention-review.service

[Install]
WantedBy=timers.target
