# DRAFT ONLY. Not installed or enabled.
# Proposed cadence, not a vendor default or measured optimum.
# systemd 259.5 systemd.timer(5): UTC calendars and bounded jitter.
[Unit]
Description=Weekly bounded codebase-memory coverage inspection schedule (draft)

[Timer]
OnCalendar=Mon *-*-* 04:15:00 UTC
RandomizedDelaySec=15min
AccuracySec=1min
Persistent=false
Unit=native-memory-codegraph-coverage.service

[Install]
WantedBy=timers.target
