# DRAFT ONLY. Not installed or enabled.
# Proposed cadence, not a vendor default or measured optimum.
# systemd 259.5 systemd.timer(5): UTC calendars and bounded jitter.
[Unit]
Description=Weekly bounded Hindsight research reflection schedule (draft)

[Timer]
OnCalendar=Sun *-*-* 03:45:00 UTC
RandomizedDelaySec=15min
AccuracySec=1min
Persistent=false
Unit=native-memory-hindsight-reflect.service

[Install]
WantedBy=timers.target
