# DRAFT ONLY. Not installed or enabled.
# Proposed cadence, not a vendor default or measured optimum.
# systemd 259.5 systemd.timer(5): UTC calendars and bounded jitter.
[Unit]
Description=Weekly native QMD cleanup preview schedule (draft)

[Timer]
OnCalendar=Sat *-*-* 04:30:00 UTC
RandomizedDelaySec=15min
AccuracySec=1min
Persistent=false
Unit=native-memory-qmd-cleanup-review.service

[Install]
WantedBy=timers.target
