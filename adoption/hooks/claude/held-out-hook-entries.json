{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/token-lanes-session-start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/token-lanes-subagent-start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
