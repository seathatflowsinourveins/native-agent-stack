# Drafted, not run: no host has loaded, enabled or started this unit. The coordinator installs it after review,
# announced to peers (docs/secret-storage.md, "Restart check (2026-09-29)").
#
# @REPOSITORY@ is the checkout that holds scripts/credential_boot_receipt.py at every boot. On the workstation that
# is the live clone, %h/code/native-agent-stack-live, the value its other installed units use; never the working
# checkout %h/code/native-agent-stack, whose revision moves, and never a build worktree, which a merge deletes.
# Substitute it before installing, as for the other @REPOSITORY@ templates in this directory, then verify the result:
#   sed 's#@REPOSITORY@#%h/code/native-agent-stack-live#g' adoption/templates/systemd/credential-boot-receipt.service > ~/.config/systemd/user/credential-boot-receipt.service
#   systemd-analyze --user verify ~/.config/systemd/user/credential-boot-receipt.service
#
# WantedBy=default.target: with linger on (loginctl enable-linger), logind starts the user manager at boot, so this
# oneshot runs at every user-manager start (on WSL, every distro start) with no login and no unlock. It is given no
# credential and reads no value: there is no Environment=, EnvironmentFile= or LoadCredential= line, and the tool
# opens no store file (lstat and names only). Its one journal line holds counts and the receipt's file name.
# UMask=0077 and NoNewPrivileges=true follow this directory's other oneshots. TimeoutStartSec= bounds a stuck git,
# systemctl or loginctl call: a oneshot has no start timeout by default (systemd.service(5)), and default.target,
# which wants this unit, is ordered after it (systemd.target(5)).
[Unit]
Description=Record a value-free receipt of the credential store at user-manager start

[Service]
Type=oneshot
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=120
ExecStart=/usr/bin/python3 -I @REPOSITORY@/scripts/credential_boot_receipt.py record

[Install]
WantedBy=default.target
