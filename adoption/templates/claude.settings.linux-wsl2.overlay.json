{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "preferredNotifChannel": "notifications_disabled",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|quota_auto_resume_stale|quota_auto_resume_disabled|worker_permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jq -nc --arg s \"$(printf '\\a')\" '{terminalSequence:$s}'"
          }
        ]
      }
    ]
  }
}
