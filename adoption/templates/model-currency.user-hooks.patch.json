{
  "schema_version": 1,
  "kind": "owner-apply-json-patch",
  "description": "CC applies once after merge, after checking for an identical command. Preserve all other settings and hook groups. Review the new Codex handler through native /hooks. The currency lane does not install this patch.",
  "targets": [
    {
      "path": "~/.codex/hooks.json",
      "format": "RFC6902",
      "patch": [
        {
          "op": "add",
          "path": "/hooks/SessionStart/-",
          "value": {
            "matcher": "startup|resume",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"$HOME/code/native-agent-stack/scripts/active_model_currency.py\" notice --root \"$HOME/code/native-agent-stack\" --host 2>/dev/null || true",
                "timeout": 30
              }
            ]
          }
        }
      ]
    },
    {
      "path": "~/.claude/settings.json",
      "format": "RFC6902",
      "patch": [
        {
          "op": "add",
          "path": "/hooks/SessionStart/-",
          "value": {
            "matcher": "startup|resume",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"$HOME/code/native-agent-stack/scripts/active_model_currency.py\" notice --root \"$HOME/code/native-agent-stack\" --host 2>/dev/null || true",
                "timeout": 30
              }
            ]
          }
        }
      ]
    }
  ],
  "inverse": "Remove only the exact added SessionStart group from each target; retain every pre-existing group and setting."
}
