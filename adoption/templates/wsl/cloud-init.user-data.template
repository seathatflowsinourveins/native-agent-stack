#cloud-config
# User-data for Ubuntu 26.04.1 default or 24.04.5 rollback WSL image: adoption/platforms/linux-wsl2-new-distro.md, step W3, renders this
# file to %USERPROFILE%\.cloud-init\<Name>.user-data, where <Name> is the --name of the install, before the instance
# first boots. The cloud-init WSL datasource reads that file at the first boot; the image's /usr/lib/wsl/wsl-setup then
# waits for cloud-init, reuses this user (the first one with uid 1000 or more), keeps the [user] default written below
# and disables cloud-init for later boots.
#
# Keys follow Canonical's "Automatic setup of Ubuntu on WSL with cloud-init" example and the cloud-init WSL datasource
# "Default user" example. The groups are the ones the image's wsl-setup gives a user it creates interactively. uid 1000
# matches defaultUid in the image's /etc/wsl-distribution.conf. The password stays locked; sudo needs none.
# [time] useWindowsTimezone=true restates WSL's default (Microsoft wsl-config, "Time settings", read 2026-10-05:
# MicrosoftDocs/WSL@7ea1c6f9 WSL/wsl-config.md:152-158; default true). It records the intent, and W5 reads it back:
# docs/decisions/2026-10-05-user-facing-local-time.md.
# P2 checks the workstation schema; W5 must validate the selected image's own schema. Full new-host acceptance is owed.
users:
- name: ${WSL_USER}
  uid: 1000
  groups: [adm, cdrom, sudo, dip, plugdev]
  sudo: "ALL=(ALL) NOPASSWD:ALL"
  shell: /bin/bash
  lock_passwd: true

write_files:
- path: /etc/wsl.conf
  append: true
  content: |
    [time]
    useWindowsTimezone=true

    [user]
    default=${WSL_USER}

# /dev/tty1 is shared across distributions in the WSL VM. Mask its getty in cloud-init's network stage,
# before systemd starts the unit. The source review, ordering and proof are in the page's W5.
bootcmd:
- [systemctl, mask, --now, getty@tty1.service]
