{
  "$$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://${OTEL_ENDPOINT}",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "1000",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_LOG_USER_PROMPTS": "false",
    "OTEL_LOG_ASSISTANT_RESPONSES": "false",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "false",
    "OTEL_LOG_RAW_API_BODIES": "false",
    "OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "PATH": "${ECO_ROOT}/bin:${HOME}/.local/bin:${HOST_PATH}",
    "RTK_TELEMETRY_DISABLED": "1",
    "MCP_AUTO_OPEN_ENABLED": "false",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "8",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "MCP_TIMEOUT": "120000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "mcp__semble__search",
      "mcp__semble__find_related"
    ],
    "deny": [
      "Agent(codex:codex-rescue)",
      "Agent(claude-code-guide)",
      "Read(~/.config/native-agent-stack/**)",
      "Read(**/.config/native-agent-stack/**)",
      "Edit(~/.config/native-agent-stack/**)",
      "Read(~/.config/ecosystem-observability/*.env)",
      "Read(**/.config/ecosystem-observability/*.env)",
      "Read(~/.config/nativestack/*.key)",
      "Read(**/.config/nativestack/*.key)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(**/.codex/auth.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(~/.cache/huggingface/token)",
      "Read(**/.cache/huggingface/token)",
      "Read(~/.cache/huggingface/stored_tokens)",
      "Read(**/.cache/huggingface/stored_tokens)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(**/.aws/**)",
      "Read(~/.azure/**)",
      "Read(**/.azure/**)",
      "Read(~/.kube/**)",
      "Read(**/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(**/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(**/.git-credentials)",
      "Read(~/.netrc)",
      "Read(**/.netrc)",
      "Read(~/.npmrc)",
      "Read(**/.npmrc)",
      "Read(~/.pypirc)",
      "Read(**/.pypirc)",
      "Read(~/.omniroute/**)",
      "Read(**/.omniroute/**)",
      "Read(~/.config/omniroute/**)",
      "Read(**/.config/omniroute/**)",
      "Read(~/.local/share/omniroute/**)",
      "Read(**/.local/share/omniroute/**)",
      "Read(~/.local/share/omniroute-fw/**)",
      "Read(**/.local/share/omniroute-fw/**)",
      "Read(~/.codex/shell_snapshots/**)",
      "Read(**/.codex/shell_snapshots/**)",
      "Read(//mnt/*/Users/*/AppData/Roaming/omniroute/**)",
      "Read(**/mnt/*/Users/*/AppData/Roaming/omniroute/**)",
      "Read(//mnt/*/Users/*/.omniroute/**)",
      "Read(**/mnt/*/Users/*/.omniroute/**)",
      "Read(~/.local/state/native-agent-stack/runtime-workers/openhands/secrets/**)",
      "Read(**/.local/state/native-agent-stack/runtime-workers/openhands/secrets/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Read(//proc/*/environ)",
      "Read(**/proc/*/environ)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(hf auth token)",
      "Bash(hf auth token *)",
      "Bash(* --show-token*)",
      "Bash(git credential fill*)",
      "Bash(gh auth git-credential *)",
      "Bash(security find-generic-password *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(rtk git push --force *)",
      "Bash(rtk git push * --force)",
      "Bash(rtk git push * --force *)",
      "Bash(rtk git push -f *)",
      "Bash(rtk git push * -f)",
      "Bash(rtk git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(skills add *)",
      "Bash(npx *skills add *)",
      "Bash(npx *skills@* add *)",
      "Bash(*bin/skills add *)",
      "Bash(skills a *)",
      "Bash(npx *skills a *)",
      "Bash(*bin/skills a *)",
      "Bash(skills i *)",
      "Bash(npx *skills i *)",
      "Bash(*bin/skills i *)",
      "Bash(skills install *)",
      "Bash(npx *skills install *)",
      "Bash(npx *skills@* install *)",
      "Bash(*bin/skills install *)",
      "Bash(skills remove *)",
      "Bash(npx *skills remove *)",
      "Bash(npx *skills@* remove *)",
      "Bash(*bin/skills remove *)",
      "Bash(skills rm *)",
      "Bash(npx *skills rm *)",
      "Bash(npx *skills@* rm *)",
      "Bash(*bin/skills rm *)",
      "Bash(skills r *)",
      "Bash(npx *skills r *)",
      "Bash(*bin/skills r *)",
      "Bash(skills check*)",
      "Bash(npx *skills check*)",
      "Bash(npx *skills@* check*)",
      "Bash(*bin/skills check*)",
      "Bash(skills update*)",
      "Bash(npx *skills update*)",
      "Bash(npx *skills@* update*)",
      "Bash(*bin/skills update*)",
      "Bash(skills upgrade*)",
      "Bash(npx *skills upgrade*)",
      "Bash(npx *skills@* upgrade*)",
      "Bash(*bin/skills upgrade*)",
      "Bash(skills experimental_*)",
      "Bash(npx *skills experimental_*)",
      "Bash(npx *skills@* experimental_*)",
      "Bash(*bin/skills experimental_*)",
      "Edit(~/.agents/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "advisorModel": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/.claude/hooks/secret_path_guard.py\"; [ ! -f \"$$f\" ] || exec python3 \"$$f\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event pre-tool-use --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event session-start --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/effort-default-guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/currency-due-notice.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event subagent-stop --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event post-tool-use --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event pre-compact --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event stop --agent claude-code --server-url http://${AI_MEMORY_URL}${AI_MEMORY_CAPTURE_ASSISTANT}"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event session-end --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/effort-default-guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${AI_MEMORY_BIN} --data-dir ${HOME}/.local/share/ai-memory hook --event subagent-start --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/token-lanes-subagent-start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=$${COLUMNS:-}; case \"$$cols\" in \"\"|*[!0-9]*) cols=$$(stty size 2>/dev/null </dev/tty | awk '\"'\"'{print $$2}'\"'\"');; esac; case \"$$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$$(ls -d \"$${CLAUDE_CONFIG_DIR:-$$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $$(NF-1) \"\\t\" $$(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"${ECO_ROOT}/bin/node\" \"$${plugin_dir}dist/index.js\"'",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "claude-hud@claude-hud": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud",
        "ref": "v0.8.0"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc",
        "ref": "v1.0.6"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "ultracode": true,
  "enableWorkflows": true,
  "showThinkingSummaries": true,
  "cleanupPeriodDays": 3650,
  "autoContinueAtUsageLimit": true,
  "switchModelsOnFlag": false,
  "syncClaudeAiSkills": false,
  "skillListingBudgetFraction": 0.05,
  "skillOverrides": {
    "typesafe-ai": "on",
    "gh-fix-ci": "on",
    "security-best-practices": "on",
    "iterative-retrieval": "on",
    "search-first": "on",
    "diagnosing-bugs": "on",
    "tdd": "on",
    "codebase-design": "on",
    "resolving-merge-conflicts": "off",
    "grill-me": "off",
    "improve-codebase-architecture": "off",
    "security-threat-model": "on",
    "gh-address-comments": "on",
    "semgrep": "off",
    "codeql": "on",
    "supply-chain-risk-auditor": "on",
    "agentic-actions-auditor": "on",
    "property-based-testing": "on",
    "modern-python": "on",
    "sarif-parsing": "on",
    "fp-check": "on",
    "mcp-builder": "on",
    "frontend-design": "on",
    "agent-browser": "on",
    "find-skills": "on",
    "variant-analysis": "on",
    "writing-for-agents": "on",
    "security-audit": "on",
    "skill-creator": "on"
  }
}
