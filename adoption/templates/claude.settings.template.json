{
  "$$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://${OTEL_ENDPOINT}",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "1000",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_LOG_USER_PROMPTS": "false",
    "OTEL_LOG_ASSISTANT_RESPONSES": "false",
    "OTEL_LOG_TOOL_DETAILS": "false",
    "OTEL_LOG_TOOL_CONTENT": "false",
    "OTEL_LOG_RAW_API_BODIES": "false",
    "OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "false",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "PATH": "${ECO_ROOT}/bin:${HOME}/.local/bin:${HOST_PATH}",
    "RTK_TELEMETRY_DISABLED": "1",
    "MCP_AUTO_OPEN_ENABLED": "false",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "8",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK": "1"
  },
  "permissions": {
    "deny": [
      "Agent(codex:codex-rescue)",
      "Read(~/.config/native-agent-stack/**)",
      "Edit(~/.config/native-agent-stack/**)",
      "Read(~/.config/ecosystem-observability/*.env)",
      "Read(~/.config/nativestack/*.key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.cache/huggingface/stored_tokens)",
      "Read(//proc/*/environ)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(hf auth token)",
      "Bash(hf auth token *)",
      "Bash(* --show-token*)",
      "Bash(git credential fill*)",
      "Bash(gh auth git-credential *)",
      "Bash(security find-generic-password *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "f=\"${HOME}/.claude/hooks/secret_path_guard.py\"; [ ! -f \"$$f\" ] || exec python3 \"$$f\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event pre-tool-use --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event session-start --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/effort-default-guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event subagent-stop --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event post-tool-use --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event pre-compact --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event stop --agent claude-code --server-url http://${AI_MEMORY_URL}${AI_MEMORY_CAPTURE_ASSISTANT}"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event session-end --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/effort-default-guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${ECO_ROOT}/tools/ai-memory-2.3.2/ai-memory --data-dir ${HOME}/.local/share/ai-memory hook --event subagent-start --agent claude-code --server-url http://${AI_MEMORY_URL}"
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=$${COLUMNS:-}; case \"$$cols\" in \"\"|*[!0-9]*) cols=$$(stty size 2>/dev/null </dev/tty | awk '\"'\"'{print $$2}'\"'\"');; esac; case \"$$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$$(ls -d \"$${CLAUDE_CONFIG_DIR:-$$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $$(NF-1) \"\\t\" $$(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"${ECO_ROOT}/bin/node\" \"$${plugin_dir}dist/index.js\"'"
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "claude-hud@claude-hud": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud",
        "ref": "v0.8.0"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc",
        "ref": "v1.0.6"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "ultracode": true,
  "enableWorkflows": true,
  "showThinkingSummaries": true,
  "cleanupPeriodDays": 3650,
  "autoContinueAtUsageLimit": true,
  "switchModelsOnFlag": false
}
