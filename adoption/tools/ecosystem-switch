def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ecosystem-switch", description=__doc__,
                                      formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    status.add_argument("--component")
    status.set_defaults(handler=cmd_status)

    adopt = sub.add_parser("adopt")
    adopt.add_argument("--baseline", action="store_true")
    adopt.add_argument("--relink", action="store_true")
    adopt.add_argument("--resync")
    adopt.add_argument("--reason")
    adopt.add_argument("--component", action="append")
    adopt.add_argument("--spec", type=Path)
    adopt.set_defaults(handler=cmd_adopt)

    plan = sub.add_parser("plan")
    plan.add_argument("component")
    plan.add_argument("--to-root", required=True)
    plan.add_argument("--receipt", required=True)
    plan.add_argument("--spec", type=Path)
    plan.set_defaults(handler=cmd_plan)

    apply_parser = sub.add_parser("apply")
    apply_parser.add_argument("component")
    apply_parser.add_argument("--to-root", required=True)
    apply_parser.add_argument("--receipt", required=True)
    apply_parser.add_argument("--window", required=True)
    apply_parser.add_argument("--plan-sha256", required=True)
    apply_parser.add_argument("--confirm-within", type=int, default=None)
    apply_parser.add_argument("--spec", type=Path)
    apply_parser.set_defaults(handler=cmd_apply)

    confirm = sub.add_parser("confirm")
    confirm.add_argument("--txn", required=True)
    confirm.set_defaults(handler=cmd_confirm)

    rollback = sub.add_parser("rollback")
    rollback.add_argument("component", nargs="?")
    rollback.add_argument("--txn")
    rollback.add_argument("--if-unconfirmed", action="store_true")
    rollback.set_defaults(handler=cmd_rollback)

    verify = sub.add_parser("verify")
    verify.add_argument("--component")
    verify.add_argument("--json", action="store_true")
    verify.add_argument("--spec", type=Path)
    verify.set_defaults(handler=cmd_verify)

    recover = sub.add_parser("recover")
    recover.set_defaults(handler=cmd_recover)

    prune = sub.add_parser("prune")
    prune.add_argument("--list", action="store_true")
    prune.add_argument("--apply")
    prune.add_argument("--reason")
    prune.set_defaults(handler=cmd_prune)

    write_versions = sub.add_parser("write-installed-versions")
    write_versions.set_defaults(handler=cmd_write_installed_versions)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except Busy as error:
        print(f"ecosystem-switch: {error}", file=sys.stderr)
        return error.exit_code
    except SwitchError as error:
        print(f"ecosystem-switch: {error}", file=sys.stderr)
        return error.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
