#!/usr/bin/env python3
"""ecosystem-switch -- one atomic switch point per adopted component.

Introduces a single indirection, ``current/<id>``, between every consumer of a
component (``bin/*`` entrypoints, systemd unit/wrapper/MCP text) and the
component's real, immutable versioned install (``tools/<root_name>``). Once
``adopt --relink`` has pointed every consumer at ``current/<id>/...`` (a
one-time migration that changes no real path: everything still resolves to
the same target it did before), every later version change is one ``apply``
that flips ``current/<id>`` to a new root, gated by a receipt, a maintenance
window, host memory and drift detection, with an append-only hash-chained
ledger, an automatic reverse-order rollback on a failed post-apply verify, and
an optional confirm-or-revert timer.

Python 3 standard library only (installed onto a host's PATH the same way as
its siblings ``ecosystem-bounded-run`` and ``gitleaks-guarded``: see
adoption/tools/README.md). Every operation is one of a fixed set of kinds
(link, text-replace, file-write, native-cli, unit-restart, data-backup,
data-restore), each with a recorded inverse; ``rollback``/``recover`` never
improvise a repair outside that set.

State lives under ``$ECO_INSTALL_ROOT`` (default ``~/.local/share/codex-ecosystem``):

  switch/switch.lock           global flock (busy -> exit 75)
  switch/components.json       the adopted component spec (see --spec)
  switch/windows/<name>.json   {name, start_utc, end_utc, allowed_components}
  switch/receipts/<RID>.json   native-rollout-receipt.schema.json-shaped receipts
  switch/ledger.jsonl          append-only, 0600, hash-chained (see Ledger)
  switch/state.json            derived from the ledger; never hand-edited
  switch/backups/<txn>/...     pre-images text-replace/file-write/data-backup keep

Tests point ``ECOSYSTEM_SWITCH_SYSTEMCTL``/``ECOSYSTEM_SWITCH_SYSTEMD_RUN`` at
stub executables instead of the real ``systemctl``/``systemd-run``.
"""

from __future__ import annotations

import argparse
import contextlib
import errno
import fcntl
import getpass
import hashlib
import json
import os
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCHEMA_VERSION = 1
EXIT_USAGE = 64
EXIT_BUSY = 75
GENESIS_HASH = "0" * 64

# unit-restart never touches these units, named literally in switch.md's Facts section,
# whether or not a pin/component spec entry exists for them yet.
DENYLISTED_UNITS = frozenset({
    "adaptive-paper-rung1x-20260923-ladder2",
    "ibkr-paper-post-20260923",
    "incentive-forward@1330",
    "mover-daily-scan-0925",
    "mover-rth-trial-20260924",
})

# Refuse a unit-restart that loads a model below this much available memory (matches the
# >=6 GiB rule docs/linux-efficiency.md and this rollout's own common brief apply to workers
# launching heavy jobs on this host). Never raised to retry; only ECOSYSTEM_SWITCH_MIN_MEMORY_KIB
# lowers it, and only a test may need to.
DEFAULT_MIN_MEMORY_KIB = 6 * 1024 * 1024

OPERATION_KINDS = ("link", "text-replace", "file-write", "native-cli", "unit-restart",
                   "data-backup", "data-restore")
ROLLBACK_CLASSES = ("safe", "restart_required", "manual_required", "not_applicable")
LEDGER_FIELDS = ("seq", "txn", "op", "component", "surface", "from", "to", "pre_sha256",
                  "post_sha256", "backup", "receipt", "window", "rollback_class", "actor",
                  "at_utc", "prev_hash", "hash")

# A window's start_utc/end_utc must be in exactly this shape for the "<= now <=" string
# comparison below to be safe (a non-Z offset or a malformed bound sorts unpredictably and
# could leave a window that looks permanently open or permanently closed).
ISO_UTC_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")


class SwitchError(Exception):
    """A refusal that should print a message and exit non-zero; never a bare traceback."""

    def __init__(self, message: str, exit_code: int = 1):
        super().__init__(message)
        self.exit_code = exit_code


class Busy(SwitchError):
    def __init__(self, message: str):
        super().__init__(message, EXIT_BUSY)


class UnitRestartAttempted(SwitchError):
    """A unit-restart that reached ``systemctl ... restart`` (a real side effect on the host)
    before failing -- either the restart command itself exited non-zero, or it exited 0 but the
    post-restart health probe rejected the result. Unlike a pre-flight refusal (denylisted unit,
    outside its window, or the memory gate: none of which ever call ``restart``), the unit is no
    longer guaranteed to be running the old build here, so the caller must still ledger this step
    (``fields``, gathered as far as the failure allowed) before re-raising: otherwise
    ``rollback_txn``'s reverse-order pass never finds it and never restarts the unit again against
    the reverted root, leaving it running the new (or a crashed) build while the ledger says
    ``rolled_back`` (major finding)."""

    def __init__(self, message: str, fields: dict):
        super().__init__(message)
        self.fields = fields


# --------------------------------------------------------------------------------------
# Small utilities
# --------------------------------------------------------------------------------------

def eco_root() -> Path:
    value = os.environ.get("ECO_INSTALL_ROOT")
    return Path(value) if value else Path.home() / ".local" / "share" / "codex-ecosystem"


def now_utc_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def actor_identity() -> str:
    override = os.environ.get("ECOSYSTEM_SWITCH_ACTOR")
    if override:
        return override
    try:
        user = getpass.getuser()
    except OSError:
        user = "unknown"
    try:
        host = socket.gethostname()
    except OSError:
        host = "unknown"
    return f"{user}@{host}"


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str | None:
    try:
        return sha256_bytes(path.read_bytes())
    except OSError:
        return None


def canonical_json(value) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")


def systemctl_argv() -> list[str]:
    override = os.environ.get("ECOSYSTEM_SWITCH_SYSTEMCTL")
    return shlex.split(override) if override else ["systemctl"]


def systemd_run_argv() -> list[str]:
    override = os.environ.get("ECOSYSTEM_SWITCH_SYSTEMD_RUN")
    return shlex.split(override) if override else ["systemd-run"]


def run_captured(argv: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, timeout=kwargs.pop("timeout", 60), **kwargs)


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600, *, preserve_mode_from: Path | None = None) -> None:
    """Temp file in the same directory, fsync, then os.replace: never a half-written file.
    ``preserve_mode_from`` (an existing file, read before this call replaces anything) overrides
    ``mode`` with that file's own current permission bits, so switching a component's version
    never silently drops an entrypoint wrapper's exec bit -- callers that must always keep a
    fixed mode regardless of what is already on disk (the ledger, state.json, the component
    spec: always 0600) never pass it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if preserve_mode_from is not None:
        with contextlib.suppress(OSError):
            mode = stat.S_IMODE(preserve_mode_from.stat().st_mode)
    fd, tmp_name = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp_name, mode)
        os.replace(tmp_name, path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def atomic_symlink(link_path: Path, target: str) -> None:
    """Point ``link_path`` at ``target`` (a string, absolute or relative to link_path's
    directory) with a rename, never ``ln -sfn``'s remove-then-create window."""
    link_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_name = tempfile.mktemp(dir=str(link_path.parent), prefix=f".{link_path.name}.")
    try:
        os.symlink(target, tmp_name)
        os.replace(tmp_name, link_path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def resolve_surface_path(root: Path, surface: str) -> Path:
    """A surface's path (pins-v2 ``surfaces[]``/``state_dirs[]``'s own ``path``): ``~`` (or
    ``~user``) expands to that user's real home directory -- a state_dirs[] path can live outside
    ``$ECO_INSTALL_ROOT`` entirely (e.g. adoption/pins-linux-x86_64.json's own pending qmd
    ``~/.cache/qmd`` and ai-memory ``~/.local/state/ai-memory`` entries; minor finding: this used
    to be treated as a literal relative path under ``root``, e.g. ``$ECO_INSTALL_ROOT/~/...``,
    which never exists). An absolute path (already covering the ``${STACK_HOME}``-resolved form
    used elsewhere) is used as-is; anything else resolves under ``root``."""
    if surface.startswith("~"):
        return Path(surface).expanduser()
    if surface.startswith("/"):
        return Path(surface)
    return root / surface


def read_link_target(link_path: Path) -> str | None:
    try:
        return os.readlink(link_path)
    except OSError:
        return None


def path_is_under(path: str | None, expected_root: str) -> bool:
    """Whether ``path`` is ``expected_root`` itself or a real descendant of it (component-wise,
    not a substring test): ``.../foo-2.0.0`` must not match ``.../foo-2.0.0-r20260925``."""
    if not path:
        return False
    root_norm = os.path.normpath(expected_root)
    path_norm = os.path.normpath(path)
    return path_norm == root_norm or path_norm.startswith(root_norm + os.sep)


def frozen_surface_issue(surface: str, target: Path) -> str | None:
    """None unless ``surface`` (its literal text or, once resolved, the real path it names)
    passes through a ``frozen/`` directory: a parent-directory symlink into ``*/frozen/*`` must
    refuse a write even when the surface string itself never mentions "frozen"."""
    if "/frozen/" in surface or surface.startswith("frozen/"):
        return f"refusing an operation on a frozen surface: {surface}"
    try:
        resolved = str(target.resolve())
    except OSError:
        resolved = str(target)
    if "/frozen/" in resolved or resolved.endswith("/frozen"):
        return f"refusing an operation on a frozen surface (resolves through frozen/): {surface} -> {resolved}"
    return None


def available_memory_kib() -> int | None:
    try:
        with open("/proc/meminfo", encoding="ascii") as handle:
            for line in handle:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        return None
    return None


# --------------------------------------------------------------------------------------
# Locking
# --------------------------------------------------------------------------------------

@contextlib.contextmanager
def held_lock(path: Path, busy_message: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(path, "a+")
    try:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as error:
            if error.errno in (errno.EACCES, errno.EAGAIN):
                raise Busy(busy_message) from None
            raise
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


@contextlib.contextmanager
def switch_locks(root: Path):
    """The tool's own lock, then the bootstrap lock bootstrap-linux.sh also takes
    (root/bootstrap.lock), so a switch operation and a bootstrap run never interleave."""
    with held_lock(root / "switch" / "switch.lock", "another ecosystem-switch operation is running"):
        with held_lock(root / "bootstrap.lock", "an ecosystem bootstrap is running"):
            yield


# --------------------------------------------------------------------------------------
# Ledger and derived state
# --------------------------------------------------------------------------------------

class Ledger:
    def __init__(self, root: Path):
        self.path = root / "switch" / "ledger.jsonl"

    def _last_hash(self) -> str:
        last = GENESIS_HASH
        if self.path.is_file():
            with open(self.path, encoding="utf-8") as handle:
                for line in handle:
                    line = line.strip()
                    if line:
                        last = json.loads(line)["hash"]
        return last

    def append(self, **fields) -> dict:
        """Append one hash-chained entry; fields not given default to None. Returns the
        entry actually written (including seq/prev_hash/hash/actor/at_utc)."""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        entries = self.all()
        seq = (entries[-1]["seq"] + 1) if entries else 1
        prev_hash = entries[-1]["hash"] if entries else GENESIS_HASH
        entry = {key: fields.get(key) for key in LEDGER_FIELDS if key not in ("seq", "prev_hash", "hash", "actor", "at_utc")}
        entry["seq"] = seq
        entry["actor"] = fields.get("actor") or actor_identity()
        entry["at_utc"] = fields.get("at_utc") or now_utc_iso()
        entry["prev_hash"] = prev_hash
        entry["hash"] = sha256_bytes(prev_hash.encode("ascii") + canonical_json(entry))
        line = canonical_json(entry) + b"\n"
        fd = os.open(self.path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
        try:
            os.write(fd, line)
            os.fsync(fd)
        finally:
            os.close(fd)
        return entry

    def all(self) -> list[dict]:
        if not self.path.is_file():
            return []
        entries = []
        with open(self.path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line:
                    entries.append(json.loads(line))
        return entries

    def verify_chain(self) -> list[str]:
        """Structural problems in the hash chain; empty when it is intact."""
        problems = []
        prev_hash = GENESIS_HASH
        for entry in self.all():
            body = {key: entry.get(key) for key in LEDGER_FIELDS if key not in ("hash",)}
            expected = sha256_bytes(entry.get("prev_hash", "").encode("ascii") + canonical_json(body))
            if entry.get("prev_hash") != prev_hash:
                problems.append(f"seq {entry.get('seq')}: prev_hash does not chain from the prior entry")
            if entry.get("hash") != expected:
                problems.append(f"seq {entry.get('seq')}: hash does not match its own recorded fields")
            prev_hash = entry.get("hash", prev_hash)
        return problems

    def for_txn(self, txn: str) -> list[dict]:
        return [entry for entry in self.all() if entry.get("txn") == txn]


def recompute_state(root: Path) -> dict:
    """Derive switch/state.json purely from the ledger: {components: {id: {current, ...}},
    txns: {txn: {status, component, ops}}}. Used by status/verify/recover; never hand-edited."""
    components: dict[str, dict] = {}
    txns: dict[str, dict] = {}
    for entry in Ledger(root).all():
        txn = entry.get("txn")
        component = entry.get("component")
        op = entry.get("op")
        if txn:
            record = txns.setdefault(txn, {"component": component, "status": "in_progress", "ops": [], "last_seq": 0})
            record["last_seq"] = max(record["last_seq"], entry.get("seq") or 0)
            if op not in ("txn_begin", "verify_pass", "verify_fail", "txn_confirm"):
                record["ops"].append(entry)
            if op == "verify_pass":
                record["status"] = "pending_confirmation" if entry.get("to") == "confirm_pending" else "applied"
            elif op == "txn_confirm":
                record["status"] = "applied"
            elif op == "verify_fail":
                record["status"] = "verify_failed"
            elif op and op.startswith("rollback:") and entry.get("surface") == "_txn_end":
                record["status"] = "rolled_back"
            elif op in ("baseline", "resync", "prune"):
                # Single-shot, non-transactional records, not a multi-step apply: they carry no
                # reversible operation (rollback_txn's OPERATION_KINDS filter empties them out),
                # so they must reach a terminal status immediately, never sit "in_progress"
                # forever -- otherwise cmd_recover would try to "roll them back" on every run.
                record["status"] = "recorded"
        # Only the component's own current/<id> switch point tracks "current"; a relink also
        # emits "link" entries for each entrypoint (e.g. surface bin/foo), which must not
        # overwrite it -- current_link is always named current/<id> by convention (enforced by
        # adoption/pins-schema-v2.json's current_link pattern), so that prefix identifies it
        # without needing the component spec here. A rollback re-emits the original op name as
        # "rollback:<op>" (e.g. "rollback:link"), which must count the same as "link" here, or a
        # rolled-back link never updates "current" and a later apply sees false drift.
        base_op = op[len("rollback:"):] if isinstance(op, str) and op.startswith("rollback:") else op
        if (component and base_op in ("link", "resync", "baseline") and entry.get("to") is not None
                and (entry.get("surface") or "").startswith("current/")):
            components.setdefault(component, {})["current"] = entry.get("to")
            components[component]["updated_txn"] = txn
            components[component]["updated_at_utc"] = entry.get("at_utc")
            components[component]["rollback_class"] = entry.get("rollback_class")
    return {"schema_version": SCHEMA_VERSION, "components": components, "txns": txns,
            "generated_at_utc": now_utc_iso()}


def load_state(root: Path) -> dict:
    return recompute_state(root)


def save_state(root: Path) -> dict:
    state = recompute_state(root)
    atomic_write_bytes(root / "switch" / "state.json", canonical_json(state) + b"\n")
    return state


# --------------------------------------------------------------------------------------
# Component spec ("adopted" registry) -- see adoption/pins-schema-v2.json for the shape
# --------------------------------------------------------------------------------------

def load_spec(root: Path, explicit: Path | None) -> dict:
    """switch/components.json (or an explicit --spec file, copied there on adopt).
    Accepts either the adopted registry's own {"components": {id: {...}}} shape or a raw
    pins-v2 file ({"tools": [{...}]}), converted to the former, keyed by id."""
    path = explicit or (root / "switch" / "components.json")
    if not path.is_file():
        raise SwitchError(f"no component spec at {path}; pass --spec PATH (a pins-v2 shaped "
                           "file or a prior switch/components.json) or run adopt --baseline first")
    document = json.loads(path.read_text(encoding="utf-8"))
    if "tools" in document:
        components = {}
        for tool in document["tools"]:
            components[tool["id"]] = {key: tool.get(key) for key in
                                       ("version", "kind", "root_name", "current_link", "entrypoints",
                                        "surfaces", "state_dirs", "window", "rollback_class")}
        return {"schema_version": SCHEMA_VERSION, "components": components}
    return document


def save_spec(root: Path, spec: dict) -> None:
    atomic_write_bytes(root / "switch" / "components.json", canonical_json(spec) + b"\n")


def component_entry(spec: dict, component_id: str) -> dict:
    entry = (spec.get("components") or {}).get(component_id)
    if entry is None:
        raise SwitchError(f"component {component_id!r} is not in the adopted spec")
    return entry


# --------------------------------------------------------------------------------------
# Windows, receipts, drift and memory gates
# --------------------------------------------------------------------------------------

def load_window(root: Path, name: str) -> dict:
    path = root / "switch" / "windows" / f"{name}.json"
    if not path.is_file():
        raise SwitchError(f"no such window {name!r} ({path})")
    return json.loads(path.read_text(encoding="utf-8"))


def window_issue(window: dict, component_id: str, at_utc: str | None = None) -> str | None:
    now = at_utc or now_utc_iso()
    start, end = window.get("start_utc"), window.get("end_utc")
    if not (isinstance(start, str) and isinstance(end, str) and ISO_UTC_RE.fullmatch(start)
            and ISO_UTC_RE.fullmatch(end)):
        return (f"window {window.get('name')!r} has a malformed start_utc/end_utc ({start!r}..{end!r}, "
                "must be YYYY-MM-DDTHH:MM:SSZ); refusing rather than comparing it as open or closed")
    if not (start <= now <= end):
        return f"window {window.get('name')!r} is not open now ({start}..{end}, now {now})"
    allowed = window.get("allowed_components")
    if not isinstance(allowed, list) or component_id not in allowed:
        return f"window {window.get('name')!r} does not allow component {component_id!r}"
    return None


def load_receipt(root: Path, rid: str) -> dict | None:
    path = root / "switch" / "receipts" / f"{rid}.json"
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


REQUIRED_PASSED_TIERS = ("T0", "T2", "T4")


def receipt_gate_issue(receipt: dict | None, component_id: str, version: str, *,
                        root: Path | None = None, to_root: str | None = None) -> str | None:
    """None when ``receipt`` (a tools/sota-convergence/native-rollout-receipt.schema.json
    document) authorizes switching ``component_id`` to ``version``: overall status passed,
    identity matches, T0/T2/T4 passed, and T1 either passed or declared unavailable. When
    ``root``/``to_root`` are both given (every real ``apply`` call; direct unit tests of the
    documented tier rule in isolation pass neither), also requires the receipt's own
    ``install.root`` (after resolving its ``${STACK_HOME}`` placeholder against ``root``) to name
    that same ``to_root``, so a receipt authorizes only the specific root it was recorded for --
    not merely a same-named version anywhere else on disk. A receipt with no (or a non-string)
    ``install.root`` fails this check rather than skipping it (minor finding: it used to fail
    open, silently authorizing any ``--to-root`` whose basename suffix happened to match
    ``version``). ``install.marker_sha256`` is not cross-checked here: no generic, per-component
    marker-file location is defined yet for ecosystem-switch to locate on its own; a future
    qualify wave may add one."""
    if receipt is None:
        return "receipt not found"
    if receipt.get("status") != "passed":
        return f"receipt status is {receipt.get('status')!r}, not \"passed\""
    identity = receipt.get("identity") if isinstance(receipt.get("identity"), dict) else {}
    if identity.get("component_id") != component_id or identity.get("version") != version:
        return (f"receipt identity ({identity.get('component_id')!r}, {identity.get('version')!r}) "
                f"does not match ({component_id!r}, {version!r})")
    if root is not None and to_root is not None:
        install = receipt.get("install") if isinstance(receipt.get("install"), dict) else {}
        declared_root = install.get("root")
        if not isinstance(declared_root, str) or not declared_root:
            return "receipt has no install.root to bind it to a specific root"
        resolved_root = declared_root.replace("${STACK_HOME}", str(root))
        if os.path.normpath(resolved_root) != os.path.normpath(to_root):
            return (f"receipt install.root {declared_root!r} (resolved {resolved_root!r}) does not match "
                    f"--to-root {to_root!r}")
    tiers = {tier.get("tier"): tier for tier in receipt.get("tiers") or [] if isinstance(tier, dict)}
    for required in REQUIRED_PASSED_TIERS:
        tier = tiers.get(required)
        if tier is None or tier.get("result") != "passed":
            return f"receipt tier {required} is not passed"
    tier_one = tiers.get("T1")
    if tier_one is None:
        return "receipt has no T1 tier (must be passed or declared unavailable)"
    if tier_one.get("result") == "passed":
        pass
    elif tier_one.get("result") == "unavailable" and (tier_one.get("unavailable_reason") or "").strip():
        pass
    else:
        return "receipt T1 tier is neither passed nor declared unavailable with a reason"
    return None


def drift_issue(root: Path, component_id: str, entry: dict) -> str | None:
    """None when the live current/<id> target still matches what the ledger last recorded;
    a mismatch means something changed the link outside this tool ('drift ⇒ refuse')."""
    current_link = entry.get("current_link")
    if not current_link:
        return None
    state = load_state(root)
    recorded = (state["components"].get(component_id) or {}).get("current")
    if recorded is None:
        return None
    live = read_link_target(root / current_link)
    if live != recorded:
        return (f"drift: {current_link} resolves to {live!r}, but the ledger's last recorded value "
                f"for {component_id!r} is {recorded!r}; run 'adopt --resync {component_id} --reason ...' "
                "to accept the live value before switching")
    return None


def memory_gate_issue(min_kib: int | None = None) -> str | None:
    """None when available memory clears the floor. ``ECOSYSTEM_SWITCH_MIN_MEMORY_KIB`` may only
    lower ``DEFAULT_MIN_MEMORY_KIB`` -- never raise a production floor via a casual env var --
    so it is clamped to the default rather than trusted outright.
    ``ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB`` has no such ceiling; it exists only so a test
    can deterministically force this gate to refuse regardless of the real host's MemAvailable,
    without also weakening the production-facing variable's one-directional guarantee."""
    if min_kib is not None:
        minimum = min_kib
    else:
        forced = os.environ.get("ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB")
        if forced is not None:
            minimum = int(forced)
        else:
            requested = os.environ.get("ECOSYSTEM_SWITCH_MIN_MEMORY_KIB")
            minimum = min(int(requested), DEFAULT_MIN_MEMORY_KIB) if requested is not None else DEFAULT_MIN_MEMORY_KIB
    available = available_memory_kib()
    if available is None:
        return "cannot read /proc/meminfo; refusing a restart that may load a model"
    if available < minimum:
        return f"only {available} KiB MemAvailable, below the {minimum} KiB floor for a model-loading restart"
    return None


# --------------------------------------------------------------------------------------
# Operation kinds: each returns (ledger_fields: dict, inverse: dict) on success, or raises
# SwitchError. ``inverse`` is itself an operation spec that undoes this one when re-applied
# by rollback (same op kind, from/to swapped, plus whatever the specific kind needs to restore
# a backup).
# --------------------------------------------------------------------------------------

def op_link(root: Path, surface: str, to: str) -> tuple[dict, dict]:
    link_path = root / surface
    before = read_link_target(link_path)
    atomic_symlink(link_path, to)
    after = read_link_target(link_path)
    if after != to:
        raise SwitchError(f"link verification failed after replace: {link_path} resolves to {after!r}, not {to!r}")
    fields = {"from": before, "to": to,
              "pre_sha256": sha256_text(before or ""), "post_sha256": sha256_text(to)}
    inverse = {"kind": "link", "surface": surface, "to": before} if before is not None else None
    return fields, inverse


def op_text_replace(root: Path, surface: str, old: str, new: str, *, backup_dir: Path,
                     expected_count: int = 1, expected_pre_sha256: str | None = None) -> tuple[dict, dict]:
    target = resolve_surface_path(root, surface)
    frozen_issue = frozen_surface_issue(surface, target)
    if frozen_issue:
        raise SwitchError(frozen_issue)
    if not target.is_file():
        raise SwitchError(f"text-replace target does not exist: {target}")
    original = target.read_bytes()
    if expected_pre_sha256 is not None and sha256_bytes(original) != expected_pre_sha256:
        raise SwitchError(f"text-replace on {target}: current contents (sha256 {sha256_bytes(original)}) do not "
                           f"match the expected pre-image ({expected_pre_sha256}); something else changed it")
    count = original.count(old.encode("utf-8"))
    if count != expected_count:
        raise SwitchError(f"text-replace on {target}: expected {old!r} to occur {expected_count} time(s), found {count}")
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup_path = backup_dir / f"{sha256_bytes(original)[:16]}-{target.name}.orig"
    if not backup_path.exists():
        atomic_write_bytes(backup_path, original)
    updated = original.replace(old.encode("utf-8"), new.encode("utf-8"))
    fd, tmp_name = tempfile.mkstemp(dir=str(target.parent), prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(updated)
            handle.flush()
            os.fsync(handle.fileno())
        if target.suffix == ".json":
            json.loads(updated.decode("utf-8"))
        elif target.suffix == ".toml":
            _parse_toml_or_raise(updated)
        os.chmod(tmp_name, stat.S_IMODE(target.stat().st_mode))
        os.replace(tmp_name, target)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise
    fields = {"from": old, "to": new, "pre_sha256": sha256_bytes(original), "post_sha256": sha256_bytes(updated),
              "backup": str(backup_path)}
    inverse = {"kind": "text-replace", "surface": surface, "old": new, "new": old,
               "expected_count": count, "restore_from_backup": str(backup_path)}
    return fields, inverse


def _parse_toml_or_raise(data: bytes) -> None:
    """Refuse a text-replace that leaves a .toml surface (e.g. a codex MCP config) unparsable.
    ``tomllib`` (stdlib) needs Python 3.11+; on an older interpreter this check is skipped rather
    than failing every .toml text-replace outright -- report-only, matching this tool's other
    best-effort re-parse checks (JSON is required everywhere it applies because it always has
    been; TOML support is new and every currently shipped pins-v2 surfaces[] entry is empty, so
    nothing exercises this in production yet)."""
    try:
        import tomllib
    except ImportError:
        return
    try:
        tomllib.loads(data.decode("utf-8"))
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
        raise ValueError(f"not valid TOML after replacement: {error}") from error


def op_file_write(root: Path, surface: str, content: bytes, *, backup_dir: Path) -> tuple[dict, dict]:
    target = resolve_surface_path(root, surface)
    frozen_issue = frozen_surface_issue(surface, target)
    if frozen_issue:
        raise SwitchError(frozen_issue)
    before = target.read_bytes() if target.is_file() else None
    backup_path = None
    if before is not None:
        backup_dir.mkdir(parents=True, exist_ok=True)
        backup_path = backup_dir / f"{sha256_bytes(before)[:16]}-{target.name}.orig"
        if not backup_path.exists():
            atomic_write_bytes(backup_path, before)
    atomic_write_bytes(target, content, preserve_mode_from=target if before is not None else None)
    fields = {"from": sha256_bytes(before) if before is not None else None, "to": sha256_bytes(content),
              "pre_sha256": sha256_bytes(before) if before is not None else None, "post_sha256": sha256_bytes(content),
              "backup": str(backup_path) if backup_path else None}
    inverse = {"kind": "file-write", "surface": surface,
               "restore_from_backup": str(backup_path) if backup_path else None, "remove_if_no_backup": before is None}
    return fields, inverse


NATIVE_CLI_ALLOWED = (("claude", "mcp"), ("claude", "plugin"), ("codex", "mcp"))


def op_native_cli(argv: list[str], inverse_argv: list[str] | None, *, read_only_check: list[str] | None = None) -> tuple[dict, dict]:
    program = Path(argv[0]).name if argv else ""
    if (program, argv[1] if len(argv) > 1 else None) not in NATIVE_CLI_ALLOWED:
        raise SwitchError(f"native-cli refuses argv {argv!r}: only claude mcp/plugin or codex mcp are switch-managed")
    before = run_captured(read_only_check) if read_only_check else None
    result = run_captured(argv)
    if result.returncode != 0:
        raise SwitchError(f"native-cli {argv!r} exited {result.returncode}: {result.stderr.strip()[:400]}")
    after = run_captured(read_only_check) if read_only_check else None
    fields = {"from": sha256_text(before.stdout) if before else None,
              "to": sha256_text(after.stdout) if after else sha256_text(" ".join(argv)),
              "pre_sha256": sha256_text(before.stdout) if before else None,
              "post_sha256": sha256_text(after.stdout) if after else sha256_text(result.stdout)}
    inverse = {"kind": "native-cli", "argv": inverse_argv, "read_only_check": read_only_check} if inverse_argv else None
    return fields, inverse


def op_unit_restart(unit: str, *, window_component_ok: bool, expected_root: str) -> tuple[dict, dict]:
    if unit in DENYLISTED_UNITS:
        raise SwitchError(f"refusing to restart denylisted unit {unit}")
    if not window_component_ok:
        raise SwitchError(f"unit-restart of {unit} refused: outside its granted window")
    memory_issue = memory_gate_issue()
    if memory_issue:
        raise SwitchError(f"unit-restart of {unit} refused: {memory_issue}")
    before = run_captured([*systemctl_argv(), "--user", "show", "--property=MainPID", "--value", unit])
    before_fields = {"from": (before.stdout or "").strip(), "pre_sha256": sha256_text(before.stdout or "")}
    run_captured([*systemctl_argv(), "--user", "daemon-reload"])
    restart = run_captured([*systemctl_argv(), "--user", "restart", unit])
    if restart.returncode != 0:
        # A real side effect (systemctl restart was actually invoked) even though it failed: the
        # unit may no longer be running the old build. UnitRestartAttempted carries what little
        # this call knows (the pre-restart MainPID; no post-restart exe to report) so the caller
        # can still ledger the attempt before re-raising (major finding).
        raise UnitRestartAttempted(
            f"systemctl --user restart {unit} exited {restart.returncode}: {restart.stderr.strip()[:400]}",
            {**before_fields, "to": None, "post_sha256": sha256_text("")})
    after_pid = run_captured([*systemctl_argv(), "--user", "show", "--property=MainPID", "--value", unit])
    pid = (after_pid.stdout or "").strip()
    exe = None
    if pid.isdigit() and pid != "0":
        exe = read_link_target(Path(f"/proc/{pid}/exe"))
    if exe is None or not path_is_under(exe, expected_root):
        # The restart command itself succeeded (returncode 0): the unit was actually restarted,
        # just not health-probed as landing under expected_root. Same reasoning as above.
        raise UnitRestartAttempted(
            f"health probe failed for {unit}: /proc/{pid}/exe is {exe!r}, expected it under {expected_root!r}",
            {**before_fields, "to": exe, "post_sha256": sha256_text(exe or "")})
    fields = {**before_fields, "to": exe, "post_sha256": sha256_text(exe)}
    inverse = None  # a unit-restart's inverse is another unit-restart after the link is rolled back; the
    # caller (apply's reverse-order rollback) re-issues op_unit_restart against the reverted root, not this dict.
    return fields, inverse


def op_data_backup(root: Path, surface: str, *, backup_dir: Path) -> tuple[dict, dict]:
    source = resolve_surface_path(root, surface)
    if not source.is_dir():
        raise SwitchError(f"data-backup source is not a directory, refusing to record an empty backup: {source}")
    manifest = sorted(str(p.relative_to(source)) for p in source.rglob("*"))
    destination = backup_dir / surface.replace("/", "__")
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(source, destination, symlinks=True)
    fields = {"from": surface, "to": str(destination), "pre_sha256": sha256_text("\n".join(manifest)),
              "post_sha256": sha256_text("\n".join(manifest)), "backup": str(destination)}
    inverse = {"kind": "data-restore", "surface": surface, "restore_from_backup": str(destination)}
    return fields, inverse


def op_data_restore(root: Path, surface: str, backup_path: str) -> tuple[dict, dict]:
    destination = resolve_surface_path(root, surface)
    source = Path(backup_path)
    if not source.is_dir():
        raise SwitchError(f"data-restore backup missing: {source}")
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(source, destination, symlinks=True)
    fields = {"from": str(source), "to": surface, "pre_sha256": None, "post_sha256": None, "backup": str(source)}
    return fields, {}


def _refuse_if_drifted_since_write(target: Path, entry: dict) -> None:
    """Refuse a blind restore-from-backup when the surface's current bytes no longer match
    ``entry``'s own recorded ``post_sha256`` (what THIS operation last wrote): something else
    changed it since, and overwriting that unnoticed change is worse than refusing."""
    expected_post = entry.get("post_sha256")
    if expected_post is None:
        return
    current = sha256_file(target)
    if current is not None and current != expected_post:
        raise SwitchError(f"refusing to roll back {target}: its current contents (sha256 {current}) no longer "
                           f"match what this operation last wrote ({expected_post}); investigate before rolling back")


def apply_inverse(root: Path, entry: dict, spec_inverse: dict, *, backup_dir: Path) -> None:
    kind = spec_inverse.get("kind")
    if kind == "link":
        op_link(root, spec_inverse["surface"], spec_inverse["to"])
    elif kind == "text-replace":
        target = root / spec_inverse["surface"]
        _refuse_if_drifted_since_write(target, entry)
        backup_path = spec_inverse.get("restore_from_backup")
        if backup_path and Path(backup_path).is_file():
            atomic_write_bytes(target, Path(backup_path).read_bytes(), preserve_mode_from=target if target.exists() else None)
        else:
            op_text_replace(root, spec_inverse["surface"], spec_inverse["old"], spec_inverse["new"],
                             backup_dir=backup_dir, expected_count=spec_inverse.get("expected_count", 1))
    elif kind == "file-write":
        target = root / spec_inverse["surface"]
        _refuse_if_drifted_since_write(target, entry)
        backup_path = spec_inverse.get("restore_from_backup")
        if backup_path and Path(backup_path).is_file():
            atomic_write_bytes(target, Path(backup_path).read_bytes(), preserve_mode_from=target if target.exists() else None)
        elif spec_inverse.get("remove_if_no_backup") and target.is_file():
            target.unlink()
    elif kind == "native-cli" and spec_inverse.get("argv"):
        op_native_cli(spec_inverse["argv"], None, read_only_check=spec_inverse.get("read_only_check"))
    elif kind == "data-restore":
        op_data_restore(root, spec_inverse["surface"], spec_inverse["restore_from_backup"])
    # unit-restart's inverse is issued by the caller directly (see op_unit_restart's note).


# --------------------------------------------------------------------------------------
# plan / apply / confirm / rollback / verify / recover
# --------------------------------------------------------------------------------------

def build_apply_plan(spec: dict, component_id: str, to_root: str, *, root: Path) -> list[dict]:
    entry = component_entry(spec, component_id)
    if not entry.get("current_link"):
        raise SwitchError(f"component {component_id!r} has no current_link; run adopt --relink first")
    if not (root / entry["current_link"]).exists():
        # Minor finding: build_apply_plan used to check only that the *spec* named a
        # current_link string, not that adopt --relink had actually pointed bin/* through it
        # yet. Applying before that left current/<id> created fresh at --to-root while every
        # entrypoint still resolved directly into the *old* real root (never redirected through
        # current/<id> in the first place) -- apply would report "applied" with the new root in
        # `status`, but bin/* stayed on the old one.
        raise SwitchError(f"component {component_id!r}'s {entry['current_link']} does not exist yet; "
                           "run 'adopt --relink' first so bin/* already resolves through it")
    if not to_root.startswith("/"):
        raise SwitchError(f"--to-root must be an absolute path (got {to_root!r}): a symlink written at "
                           "current/<id> resolves a relative target against current/'s own directory, "
                           "not ECO_INSTALL_ROOT")
    steps = []
    # A qualified (non-"pending") state_dirs[] entry must be backed up before the version that
    # will use it next takes over the link -- the ai-memory pin's own note is explicit that a
    # switch "must data-backup it". A "pending" entry (every one shipped so far: no state_dirs
    # path has been independently re-verified yet) is left for the qualify wave, not guessed at.
    for state_dir in entry.get("state_dirs") or []:
        if isinstance(state_dir, dict) and isinstance(state_dir.get("path"), str) and state_dir.get("status") != "pending":
            steps.append({"kind": "data-backup", "surface": state_dir["path"]})
    steps.append({"kind": "link", "surface": entry["current_link"], "to": to_root})
    for surface in entry.get("surfaces") or []:
        if isinstance(surface, dict) and surface.get("kind") == "unit-restart" and surface.get("path"):
            steps.append({"kind": "unit-restart", "unit": surface["path"], "expected_root": to_root})
    return steps


def plan_sha256(steps: list[dict]) -> str:
    return sha256_bytes(canonical_json(steps))


def cmd_plan(args) -> int:
    root = eco_root()
    spec = load_spec(root, args.spec)
    steps = build_apply_plan(spec, args.component, args.to_root, root=root)
    digest = plan_sha256(steps)
    print(json.dumps({"component": args.component, "to_root": args.to_root, "receipt": args.receipt,
                      "plan_sha256": digest, "steps": steps}, sort_keys=True, indent=2))
    return 0


def cmd_apply(args) -> int:
    root = eco_root()
    with switch_locks(root):
        spec = load_spec(root, args.spec)
        entry = component_entry(spec, args.component)
        steps = build_apply_plan(spec, args.component, args.to_root, root=root)
        digest = plan_sha256(steps)
        if digest != args.plan_sha256:
            raise SwitchError(f"--plan-sha256 {args.plan_sha256} does not match the live plan ({digest}); "
                               "re-run plan and review before applying")
        to_root_name = Path(args.to_root).name
        prefix = f"{args.component}-"
        if not to_root_name.startswith(prefix):
            raise SwitchError(f"--to-root basename {to_root_name!r} does not start with the expected "
                               f"{prefix!r} prefix for component {args.component!r}; refusing to guess a version")
        full_suffix = to_root_name[len(prefix):]

        # Every gate below must pass BEFORE current/<id> (or any unit) is touched: a receipt,
        # window, memory or denylist refusal must never leave a half-applied component.
        receipt = load_receipt(root, args.receipt)
        # identity.version must stay the clean upstream version throughout its life: it is what
        # record_native_rollout.py copies verbatim into a landscape winner's pin (read downstream
        # by validate_pins_v2 parity and platform_status.py's host-receipt binding against a live
        # host's plain `--version` output), never a --to-root basename. Deriving an "expected
        # version" from --to-root and forcing identity.version to equal it byte-for-byte (the old
        # design) broke exactly that for a staged bootstrap --tools-suffix root (e.g.
        # tools/rtk-0.50.0-r20260925): a receipt for the real "0.50.0" was refused, and a receipt
        # written to satisfy apply instead polluted the pin with "0.50.0-r20260925" (major
        # finding). So this reads the receipt's own claimed identity.version first and only checks
        # it is *consistent* with the root name (exactly "<component>-<version>", or that plus a
        # "-<suffix>" staging marker) -- the receipt's install.root (checked below, exact match
        # required) is what binds it to this *specific* staged root, not the version string.
        identity = receipt.get("identity") if isinstance(receipt, dict) and isinstance(receipt.get("identity"), dict) else {}
        claimed_version = identity.get("version")
        if isinstance(claimed_version, str) and claimed_version:
            if not (full_suffix == claimed_version or full_suffix.startswith(f"{claimed_version}-")):
                raise SwitchError(f"receipt gate: receipt identity.version {claimed_version!r} is not consistent "
                                   f"with --to-root basename {to_root_name!r} (expected {prefix!r} + "
                                   f"{claimed_version!r}, optionally followed by '-<staging suffix>')")
            version = claimed_version
        else:
            version = full_suffix
        receipt_issue = receipt_gate_issue(receipt, args.component, version, root=root, to_root=args.to_root)
        if receipt_issue:
            raise SwitchError(f"receipt gate: {receipt_issue}")
        window = load_window(root, args.window)
        window_issue_text = window_issue(window, args.component)
        if window_issue_text:
            raise SwitchError(f"window gate: {window_issue_text}")
        drift = drift_issue(root, args.component, entry)
        if drift:
            raise SwitchError(drift)
        for step in steps:
            if step["kind"] == "unit-restart":
                if step["unit"] in DENYLISTED_UNITS:
                    raise SwitchError(f"refusing to restart denylisted unit {step['unit']}")
                memory_issue = memory_gate_issue()
                if memory_issue:
                    raise SwitchError(f"unit-restart of {step['unit']} refused: {memory_issue}")

        ledger = Ledger(root)
        txn = f"{args.component}-{int(time.time())}-{os.getpid()}"
        backup_dir = root / "switch" / "backups" / txn
        ledger.append(txn=txn, op="txn_begin", component=args.component, surface="_txn",
                      receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"))
        try:
            for step in steps:
                if step["kind"] == "link":
                    fields, _inverse = op_link(root, step["surface"], step["to"])
                    surface = step["surface"]
                elif step["kind"] == "unit-restart":
                    surface = step["unit"]
                    try:
                        fields, _inverse = op_unit_restart(step["unit"], window_component_ok=True,
                                                           expected_root=step["expected_root"])
                    except UnitRestartAttempted as error:
                        # Major finding: a restart that reached systemctl before failing (a
                        # non-zero exit, or a health probe that rejected the result) is a real
                        # side effect rollback_txn must still be able to find. Ledger it here,
                        # before re-raising, so the reverse-order rollback below restarts the
                        # unit again against the reverted root instead of leaving it running the
                        # new (or a crashed) build while the ledger says "rolled_back".
                        ledger.append(txn=txn, op="unit-restart", component=args.component, surface=surface,
                                      receipt=args.receipt, window=args.window,
                                      rollback_class=entry.get("rollback_class"), **error.fields)
                        raise SwitchError(str(error)) from error
                elif step["kind"] == "data-backup":
                    fields, _inverse = op_data_backup(root, step["surface"], backup_dir=backup_dir)
                    surface = step["surface"]
                else:
                    raise SwitchError(f"unsupported plan step kind: {step['kind']}")
                ledger.append(txn=txn, op=step["kind"], component=args.component, surface=surface,
                              receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"), **fields)
            verify_issue = verify_component(root, args.component, spec)
            if verify_issue:
                ledger.append(txn=txn, op="verify_fail", component=args.component, surface="_txn",
                              receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"),
                              to=verify_issue)
                raise SwitchError(f"post-apply verify failed: {verify_issue}")
            confirm_target = "confirm_pending" if args.confirm_within else "applied"
            ledger.append(txn=txn, op="verify_pass", component=args.component, surface="_txn",
                          receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"),
                          to=confirm_target)
        except SwitchError as error:
            problems = rollback_txn(root, txn)
            save_state(root)
            suffix = f" (rollback also reported: {'; '.join(problems)})" if problems else ""
            raise SwitchError(f"apply failed and was automatically rolled back: {error}{suffix}") from error
        save_state(root)
        if args.confirm_within:
            schedule_confirm_or_revert(root, txn, args.confirm_within)
            print(json.dumps({"status": "pending_confirmation", "txn": txn, "confirm_within": args.confirm_within}))
        else:
            print(json.dumps({"status": "applied", "txn": txn}))
        return 0


def schedule_confirm_or_revert(root: Path, txn: str, seconds: int) -> None:
    """Ask systemd-run (or its test stub, ECOSYSTEM_SWITCH_SYSTEMD_RUN) to call this same
    executable back with `rollback --txn TXN --if-unconfirmed` after ``seconds``. If even
    *scheduling* the timer fails, a pending apply nothing will ever revert is worse than
    reverting immediately: fall back to an in-process rollback right away. ECO_INSTALL_ROOT and
    the test-stub variables are forwarded explicitly with --setenv=: a systemd --user unit does
    not inherit this process's environment on its own, so a non-default root (or a test's
    systemctl/systemd-run stub) would otherwise act on the default root once the timer fires."""
    self_path = str(Path(sys.argv[0]).resolve())
    setenv_args = []
    for name in ("ECO_INSTALL_ROOT", "ECOSYSTEM_SWITCH_SYSTEMCTL", "ECOSYSTEM_SWITCH_SYSTEMD_RUN",
                 "ECOSYSTEM_SWITCH_ACTOR", "ECOSYSTEM_SWITCH_MIN_MEMORY_KIB",
                 "ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB"):
        value = os.environ.get(name)
        if value is not None:
            setenv_args.append(f"--setenv={name}={value}")
    argv = [*systemd_run_argv(), "--user", f"--on-active={seconds}s",
            f"--unit=ecosystem-switch-revert-{txn}", *setenv_args, "--", sys.executable, self_path,
            "rollback", "--txn", txn, "--if-unconfirmed"]
    result = run_captured(argv, env=dict(os.environ))
    if result.returncode != 0:
        rollback_txn(root, txn)
        raise SwitchError(f"could not schedule the confirm-or-revert timer ({result.stderr.strip()[:200]}); "
                           "rolled back immediately instead of leaving an unrevertable pending apply")


def cmd_confirm(args) -> int:
    root = eco_root()
    with switch_locks(root):
        state = load_state(root)
        record = state["txns"].get(args.txn)
        if record is None:
            raise SwitchError(f"no such txn {args.txn!r}")
        if record.get("status") == "rolled_back":
            raise SwitchError(f"txn {args.txn!r} was already rolled back; cannot confirm it")
        if record.get("status") == "verify_failed":
            raise SwitchError(f"txn {args.txn!r} failed its post-apply verify; cannot confirm it")
        if record.get("status") == "in_progress":
            # Previously-unresolved finding: a crashed/interrupted apply never reached
            # verify_pass, so confirming it would mark a half-applied component "applied"
            # through the ledger without it ever having passed a post-apply verify -- and
            # cmd_recover only reconciles a txn still "in_progress", so it would then never see
            # this one again either. lifecycle.md: "A crashed or interrupted apply ... never
            # completes after the fact"; run `recover` (or `rollback --txn`), not `confirm`.
            raise SwitchError(f"txn {args.txn!r} is still in_progress (never reached a post-apply "
                               "verify); run 'recover' or 'rollback --txn' to reconcile it, not confirm")
        ledger = Ledger(root)
        ledger.append(txn=args.txn, op="txn_confirm", component=record.get("component"), surface="_txn", to="confirmed")
        with contextlib.suppress(SwitchError):
            run_captured([*systemctl_argv(), "--user", "stop", f"ecosystem-switch-revert-{args.txn}.timer"])
        save_state(root)
        print(json.dumps({"status": "confirmed", "txn": args.txn}))
        return 0


def rollback_txn(root: Path, txn: str) -> list[str]:
    """Reverse every operation ``txn`` recorded, in reverse-chronological order, and return a
    list of problems encountered (empty means a clean rollback). ``unit-restart`` entries are
    reversed only *after* every other kind (link/text-replace/file-write/data-backup): a service
    must be restarted against its already-reverted root, never restarted first while
    current/<id> still points at the new one, or it ends up running the new build with the link
    pointing at the old one. The unit-restart health probe compares against the matching
    ``link`` entry's own recorded ``from`` (the real old root), not the unit-restart entry's own
    ``from`` (that field is the pre-restart MainPID, not a root path, and can never match)."""
    ledger = Ledger(root)
    entries = [entry for entry in ledger.for_txn(txn) if entry.get("op") in OPERATION_KINDS]
    # Previously-unresolved finding: cmd_rollback's own "superseded" pre-check (below, for a
    # manual `rollback --txn`) never protected cmd_recover, which -- reconciling any txn still
    # in_progress after a crash -- calls this function directly, with no chance for that
    # caller-side check to run first. Duplicating the same rule here is what actually protects
    # every caller: re-pointing current/<id> back to this txn's old root after a *later*,
    # already-applied txn on the same component has since moved it on would silently clobber
    # that later apply. Safe for apply's own automatic rollback too: that call always targets the
    # txn it just began, and build_apply_plan always includes exactly one "link" step, so by the
    # time a post-apply verify can fail, this txn is necessarily still its component's own
    # updated_txn.
    component_ids = {entry.get("component") for entry in entries if entry.get("component")}
    if len(component_ids) == 1:
        (component_id,) = component_ids
        current_component_state = load_state(root)["components"].get(component_id) or {}
        superseding_txn = current_component_state.get("updated_txn")
        if superseding_txn not in (None, txn):
            raise SwitchError(f"txn {txn!r} is no longer the latest change to component {component_id!r} "
                               f"(a later txn {superseding_txn!r} already moved it on); refusing to roll "
                               "back a superseded txn and clobber that later apply")
    problems: list[str] = []
    component = None
    backup_dir = root / "switch" / "backups" / txn
    link_from_by_component: dict[str, str | None] = {
        entry.get("component"): entry.get("from") for entry in entries if entry.get("op") == "link"
    }
    non_restart_entries = [entry for entry in entries if entry.get("op") != "unit-restart"]
    unit_restart_entries = [entry for entry in entries if entry.get("op") == "unit-restart"]
    for entry in reversed(non_restart_entries):
        component = entry.get("component")
        if entry.get("op") == "link":
            if entry.get("from") is not None:
                fields, _inverse = op_link(root, entry["surface"], entry["from"])
            else:
                # The surface did not exist (or was not a symlink) before this op created it:
                # its inverse is removal, not "point it nowhere" (op_link has no such mode).
                link_path = root / entry["surface"]
                if link_path.is_symlink():
                    link_path.unlink()
                fields = {"from": entry.get("to"), "to": None}
        elif entry.get("op") == "text-replace":
            spec_inverse = {"kind": "text-replace", "surface": entry["surface"], "old": entry["to"], "new": entry["from"],
                            "restore_from_backup": entry.get("backup")}
            apply_inverse(root, entry, spec_inverse, backup_dir=backup_dir)
            fields = {"from": entry["to"], "to": entry["from"]}
        elif entry.get("op") == "file-write":
            spec_inverse = {"kind": "file-write", "surface": entry["surface"], "restore_from_backup": entry.get("backup"),
                            "remove_if_no_backup": entry.get("backup") is None}
            apply_inverse(root, entry, spec_inverse, backup_dir=backup_dir)
            fields = {"from": entry["to"], "to": entry["from"]}
        elif entry.get("op") == "data-backup":
            fields, _inverse = op_data_restore(root, entry["from"], entry["backup"])
        else:
            fields = {"from": entry.get("to"), "to": entry.get("from")}
        ledger.append(txn=txn, op=f"rollback:{entry.get('op')}", component=component, surface=entry.get("surface"),
                      rollback_class=entry.get("rollback_class"), **(fields or {}))
    for entry in reversed(unit_restart_entries):
        component = entry.get("component")
        expected_root = link_from_by_component.get(component) or ""
        try:
            fields, _inverse = op_unit_restart(entry["surface"], window_component_ok=True, expected_root=expected_root)
            op_name = "rollback:unit-restart"
        except SwitchError as error:
            fields = {"from": entry.get("to"), "to": entry.get("from")}
            op_name = "rollback:unit-restart-failed"
            problems.append(f"{entry.get('surface')}: {error}")
        ledger.append(txn=txn, op=op_name, component=component, surface=entry.get("surface"),
                      rollback_class=entry.get("rollback_class"), **fields)
    ledger.append(txn=txn, op="rollback:done", component=component, surface="_txn_end", to="rolled_back")
    save_state(root)
    return problems


def cmd_rollback(args) -> int:
    root = eco_root()
    with switch_locks(root):
        ledger = Ledger(root)
        state = load_state(root)
        if args.txn:
            txn = args.txn
        else:
            candidates = [(record.get("last_seq", 0), t) for t, record in state["txns"].items()
                          if record.get("component") == args.component
                          and any(e.get("op") in OPERATION_KINDS for e in record.get("ops") or [])]
            if not candidates:
                raise SwitchError(f"no reversible txn recorded for component {args.component!r}")
            txn = max(candidates)[1]  # highest ledger seq, i.e. most recently touched, not lexicographic txn-id order
        record = state["txns"].get(txn, {})
        if args.if_unconfirmed and record.get("status") == "applied":
            print(json.dumps({"status": "already_confirmed", "txn": txn}))
            return 0
        if record.get("status") == "rolled_back":
            print(json.dumps({"status": "already_rolled_back", "txn": txn}))
            return 0
        if not any(entry.get("op") in OPERATION_KINDS for entry in ledger.for_txn(txn)):
            raise SwitchError(f"txn {txn!r} has no reversible operations (e.g. a baseline/resync/prune "
                               "record); nothing to roll back")
        component_id = record.get("component")
        if component_id:
            current_component_state = state["components"].get(component_id) or {}
            if current_component_state.get("updated_txn") not in (None, txn):
                raise SwitchError(f"txn {txn!r} is no longer the latest change to component {component_id!r} "
                                   f"(a later txn {current_component_state.get('updated_txn')!r} already moved "
                                   "it on); refusing to roll back a superseded txn and clobber that later apply")
        problems = rollback_txn(root, txn)
        payload = {"status": "rolled_back", "txn": txn}
        if problems:
            payload["problems"] = problems
        print(json.dumps(payload))
        return 0 if not problems else 1


def verify_component(root: Path, component_id: str, spec: dict) -> str | None:
    """None when the component's live current_link target resolves and still matches what the
    ledger last recorded for it (the same comparison ``drift_issue`` makes before an ``apply``):
    a live root that no longer matches the ledger is exactly the case this must report. Used
    both by apply's automatic post-check and by the standalone `verify` command."""
    entry = component_entry(spec, component_id)
    current_link = entry.get("current_link")
    if current_link:
        target = root / current_link
        if not target.exists():
            return f"{current_link} does not resolve to an existing path"
        drift = drift_issue(root, component_id, entry)
        if drift:
            return drift
    return None


def cmd_verify(args) -> int:
    root = eco_root()
    spec = load_spec(root, args.spec)
    components = [args.component] if args.component else list((spec.get("components") or {}).keys())
    report = {}
    ok = True
    for component_id in components:
        issue = None
        try:
            issue = verify_component(root, component_id, spec)
        except SwitchError as error:
            issue = str(error)
        report[component_id] = {"ok": issue is None, "issue": issue}
        ok = ok and issue is None
    ledger_problems = Ledger(root).verify_chain()
    report["_ledger"] = {"ok": not ledger_problems, "issues": ledger_problems}
    ok = ok and not ledger_problems
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        for component_id, result in report.items():
            print(f"{component_id}: {'ok' if result.get('ok') else 'FAIL ' + str(result.get('issue') or result.get('issues'))}")
    return 0 if ok else 1


def cmd_status(args) -> int:
    root = eco_root()
