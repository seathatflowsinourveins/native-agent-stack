        atomic_write_bytes(destination, ("\n".join(lines) + "\n").encode("utf-8"), mode=0o644)
        print(str(destination))
        return 0


def _pids_referencing(needle: str) -> list[str]:
    """PIDs of this user's own processes (other than this one -- its own argv, e.g. ``prune
    --apply <target>``, would otherwise always "reference" the very target it was asked to
    check) whose /proc/<pid>/exe, cwd or cmdline names ``needle`` (a bounded stand-in for
    bin/ecosystem-wave-retention's fuller process scan on the host)."""
    hits = []
    self_pid = str(os.getpid())
    try:
        pid_dirs = [name for name in os.listdir("/proc") if name.isdigit() and name != self_pid]
    except OSError:
        return hits
    for pid in pid_dirs:
        proc_dir = Path("/proc") / pid
        try:
            if str(proc_dir.stat().st_uid) != str(os.getuid()):
                continue
        except OSError:
            continue
        matched = False
        with contextlib.suppress(OSError):
            if needle in (read_link_target(proc_dir / "exe") or ""):
                matched = True
        if not matched:
            with contextlib.suppress(OSError):
                if needle in (read_link_target(proc_dir / "cwd") or ""):
                    matched = True
        if not matched:
            with contextlib.suppress(OSError):
                if needle in (proc_dir / "cmdline").read_bytes().decode("utf-8", "replace"):
                    matched = True
        if matched:
            hits.append(pid)
    return hits


def _systemd_user_unit_files_referencing(needle: str) -> list[str]:
    """Names of this user's systemd unit files under ~/.config/systemd/user whose text names
    ``needle`` -- catches a hard-coded root such as vLLM's
    ``Environment=PATH=.../tools/vllm-0.25.0/bin`` without depending on the daemon being up."""
    hits = []
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    if not unit_dir.is_dir():
        return hits
    with contextlib.suppress(OSError):
        for unit_file in sorted(unit_dir.iterdir()):
            if unit_file.is_file():
                with contextlib.suppress(OSError, UnicodeDecodeError):
                    if needle in unit_file.read_text(encoding="utf-8"):
                        hits.append(unit_file.name)
    return hits


def wrapper_scan_dirs() -> list[Path]:
    """Directories of host-local wrapper scripts outside ``$ECO_INSTALL_ROOT`` (so none of
    prune_candidates's other scans -- PATH, bin/ symlinks, unit files, this user's own
    processes -- ever see them) whose plain script *text* can hard-code a tools/<root_name> path
    with no symlink, unit or PATH entry naming it at all: switch.md's Facts section names
    ``gitleaks-guarded``, ``mcp-inspector-2.7.0-guarded`` and ``serena-context`` under
    ``~/codex-ecosystem/bin`` as exactly this shape. ``ECOSYSTEM_SWITCH_WRAPPER_DIRS`` (a
    PATH-style, ``os.pathsep``-separated list) overrides the default, so a test never depends on
    this host's own ``~/codex-ecosystem`` and a different host's layout is not hard-coded here."""
    override = os.environ.get("ECOSYSTEM_SWITCH_WRAPPER_DIRS")
    if override is not None:
        return [Path(entry) for entry in override.split(os.pathsep) if entry]
    return [Path.home() / "codex-ecosystem" / "bin"]


def _wrapper_scripts_referencing(needle: str) -> list[str]:
    """Paths of regular (non-symlink) files under wrapper_scan_dirs() whose text names
    ``needle`` -- catches a wrapper that hard-codes a tools/<root_name> path as plain script
    text (see wrapper_scan_dirs), the one prune in-use signal switch.md's own prune scope note
    used to say this tool never checked."""
    hits = []
    for directory in wrapper_scan_dirs():
        if not directory.is_dir():
            continue
        with contextlib.suppress(OSError):
            for candidate in sorted(directory.iterdir()):
                if candidate.is_symlink() or not candidate.is_file():
                    continue
                with contextlib.suppress(OSError, UnicodeDecodeError):
                    if needle in candidate.read_text(encoding="utf-8"):
                        hits.append(str(candidate))
    return hits


def prune_candidates(root: Path) -> list[dict]:
    state = load_state(root)
    referenced_roots = {info["current"] for info in state["components"].values() if info.get("current")}
    ledger = Ledger(root)
    for txn, record in state["txns"].items():
        if record.get("status") in ("rolled_back", "superseded"):
            # A superseded txn (round 5: `recover` closes one this way rather than reversing it,
            # see close_superseded_txn) is never a live rollback target either -- both
            # rollback_txn's own guard and cmd_rollback's pre-check permanently refuse rolling one
            # back once a later txn has become its component's updated_txn, so its own "previous"
            # root can be pruned the same as an already-rolled-back txn's.
            continue
        for entry in ledger.for_txn(txn):
            # An unconfirmed or already-applied txn's *previous* root is a live rollback target
            # (the scheduled confirm-or-revert timer, or a manual `rollback`, may still need it)
            # until that txn is actually rolled back -- never merely because a later txn moved on.
            if entry.get("op") == "link" and entry.get("from"):
                referenced_roots.add(entry["from"])
    referenced_names = set()
    for value in referenced_roots:
        resolved = read_link_target(root / value) if (root / value).is_symlink() else value
        if resolved:
            referenced_names.add(Path(resolved).name)
    tools_dir = root / "tools"
    candidates = []
    if tools_dir.is_dir():
        for child in sorted(tools_dir.iterdir()):
            if not child.is_dir() or child.name in referenced_names:
                continue
            in_use_reasons = []
            for entry in os.environ.get("PATH", "").split(os.pathsep):
                if entry and str(child) in entry:
                    in_use_reasons.append(f"PATH entry {entry}")
            bin_dir = root / "bin"
            if bin_dir.is_dir():
                for link in bin_dir.iterdir():
                    if link.is_symlink() and str(child) in (read_link_target(link) or ""):
                        in_use_reasons.append(f"bin/{link.name} -> {read_link_target(link)}")
            for pid in _pids_referencing(str(child)):
                in_use_reasons.append(f"referenced by running process {pid}")
            for unit_name in _systemd_user_unit_files_referencing(str(child)):
                in_use_reasons.append(f"referenced by systemd --user unit file {unit_name}")
            for wrapper_path in _wrapper_scripts_referencing(str(child)):
                in_use_reasons.append(f"referenced by wrapper script {wrapper_path}")
            candidates.append({"path": str(child), "eligible": not in_use_reasons, "blocked_by": in_use_reasons})
    return candidates


def cmd_prune(args) -> int:
    root = eco_root()
    with switch_locks(root):
        candidates = prune_candidates(root)
        if args.list:
            print(json.dumps({
                "candidates": candidates,
                "scope_note": ("Reduced-scope in-use check relative to bin/ecosystem-wave-retention on the "
                               "host: PATH entries, bin/ symlink targets, this user's own running processes "
                               "(exe/cwd/cmdline), this user's systemd --user unit file text, and the "
                               "wrapper-script text under wrapper_scan_dirs() (default ~/codex-ecosystem/bin, "
                               "override ECOSYSTEM_SWITCH_WRAPPER_DIRS) -- e.g. gitleaks-guarded, "
                               "mcp-inspector-2.7.0-guarded -- plus every txn's previous root not yet rolled "
                               "back (a superseded txn is never a live rollback target either, so its own "
                               "previous root is excluded here the same as an already-rolled-back txn's). "
                               "No mount/symlink-hop scan, and no check of hard-coded "
                               "roots inside adoption/tools/'s own tracked wrapper copies (this tool only ever "
                               "reads $ECO_INSTALL_ROOT and wrapper_scan_dirs(), not the catalog checkout). "
                               "Treat 'eligible' as a lead, not a guarantee; a future qualify wave should reuse "
                               "bin/ecosystem-wave-retention's fuller technique."),
            }, sort_keys=True, indent=2))
            return 0
        if args.apply:
            target = Path(args.apply)
            match = next((c for c in candidates if Path(c["path"]) == target), None)
            if match is None:
                raise SwitchError(f"{target} is not a listed prune candidate under {root / 'tools'}")
            if not match["eligible"]:
                raise SwitchError(f"{target} is blocked: {match['blocked_by']}")
            if not args.reason:
                raise SwitchError("--apply requires --reason TEXT")
            manifest = sorted(str(p.relative_to(target)) for p in target.rglob("*"))
            ledger = Ledger(root)
            ledger.append(txn=f"prune-{int(time.time())}", op="prune", component=None, surface=str(target),
                          to=args.reason, pre_sha256=sha256_text("\n".join(manifest)), post_sha256=None)
            shutil.rmtree(target)
            save_state(root)
            print(json.dumps({"status": "pruned", "path": str(target), "reason": args.reason}))
            return 0
        raise SwitchError("prune requires --list or --apply ROOT --reason TEXT", EXIT_USAGE)


def cmd_adopt(args) -> int:
    root = eco_root()
    with switch_locks(root):
        if args.baseline:
            spec_path = args.spec or (root / "switch" / "components.json")
            spec = load_spec(root, args.spec) if (args.spec or spec_path.is_file()) else {"schema_version": SCHEMA_VERSION, "components": {}}
            save_spec(root, spec)
            ledger = Ledger(root)
            observed = {}
            for component_id, entry in (spec.get("components") or {}).items():
                current_link = entry.get("current_link")
                live = read_link_target(root / current_link) if current_link else None
                ledger.append(txn=f"baseline-{int(time.time())}", op="baseline", component=component_id,
                              surface=current_link or "_none", to=live, rollback_class=entry.get("rollback_class"))
                observed[component_id] = live
            save_state(root)
            print(json.dumps({"status": "baseline_recorded", "observed": observed}))
            return 0
        if args.relink:
            spec = load_spec(root, args.spec)
            ids = args.component or list((spec.get("components") or {}).keys())
            ledger = Ledger(root)
            results = {}
            for component_id in ids:
                entry = component_entry(spec, component_id)
                if not entry.get("root_name") or not entry.get("current_link"):
                    results[component_id] = "skipped (no switch-managed root; see divergence)"
                    continue
                # Coordinator decision on the txn state machine (round 5): at most one open txn
                # per component; relink refuses (busy, EXIT_BUSY) the same as apply now does (see
                # cmd_apply) while an earlier txn for this component is still in_progress (it
                # failed partway, or the process crashed -- a retry that never re-touches
                # current/<id>, since relink links it only when absent, could leave 'recover' able
                # to unwind the stale txn's own current/<id> link or entrypoints out from under
                # this retry's later work) or pending_confirmation (an `apply` awaiting its own
                # confirm-or-revert timer -- relinking on top of an unconfirmed version change is
                # exactly as unsafe as a second apply would be). 'recover' can now close an
                # in_progress txn even when a later change has since superseded it
                # (close_superseded_txn), so this refusal is never permanent the way round 4's own
                # version of it could become (major finding, round 5).
                open_txn = open_txn_for_component(root, component_id)
                if open_txn is not None:
                    open_id, open_status = open_txn
                    raise Busy(
                        f"relink refused: component {component_id!r} has an open transaction "
                        f"{open_id!r} (status {open_status!r}) left over from an earlier relink/apply; "
                        f"run 'recover' if it is in_progress after a crash, or 'confirm --txn {open_id}'/"
                        f"'rollback --txn {open_id}' to close a pending_confirmation one, before "
                        "retrying -- rather than layering a second relink on top")
                # os.getpid(), the same as apply's own txn id (cmd_apply above): two separate
                # `adopt --relink` invocations for the same component within the same wall-clock
                # second (int(time.time())'s own resolution) would otherwise collide onto one
                # ledger txn id, silently merging a second relink's entries into the first's
                # already-"applied" record instead of starting a distinct, independently
                # recoverable transaction (found while testing the superseded-refusal fix below).
                txn = f"relink-{component_id}-{int(time.time())}-{os.getpid()}"
                real_root_path = root / "tools" / entry["root_name"]
                if not real_root_path.is_dir():
                    raise SwitchError(f"relink refuses component {component_id!r}: its pinned root_name "
                                       f"{entry['root_name']!r} does not exist under {root / 'tools'} -- fix the "
                                       "component spec/pins before relinking, rather than creating a dangling "
                                       "current/<id> link")
                real_root = str(real_root_path.resolve())
                # Every entrypoint's real, resolved target is checked *before* anything is
                # touched: a mismatch aborts the whole relink for this component with nothing
                # yet written (lifecycle.md: 'before it touches anything'; README: 'aborts the
                # whole relink'). A pre-existing entrypoint that is not a symlink at all (a plain
                # regular file) is refused outright rather than silently replaced by a symlink,
                # since converting it has no recorded inverse. The prospective target is computed
                # straight from the real root, not through current/<id> (which may not exist
                # yet, on a component's very first relink, so realpath could not see through it).
                # Captured here (bin -> its pre-relink realpath) and checked again after the
                # repoint loop below actually runs: README/lifecycle.md promise "readlink -f on
                # every entrypoint before and after this command must be identical -- enforced,
                # not just documented" (minor finding: previously enforced only before, never
                # verified again after the write).
                before_resolved_by_bin: dict[str, str] = {}
                for entrypoint in entry.get("entrypoints") or []:
                    if not (isinstance(entrypoint, dict) and entrypoint.get("bin") and entrypoint.get("in_root")):
                        continue
                    link_path = root / entrypoint["bin"]
                    prospective_resolved = os.path.realpath(Path(real_root) / entrypoint["in_root"])
                    if link_path.is_symlink():
                        before_resolved = os.path.realpath(link_path)
                        if before_resolved != prospective_resolved:
                            raise SwitchError(
                                f"relink for {component_id!r} refused before changing anything: "
                                f"{entrypoint['bin']} currently resolves to {before_resolved}, but relinking it "
                                f"through {entry['current_link']!r} would resolve to {prospective_resolved} -- "
                                "the component spec's root_name/entrypoints do not match this live root")
                        before_resolved_by_bin[entrypoint["bin"]] = before_resolved
                    elif link_path.exists():
                        raise SwitchError(
                            f"relink for {component_id!r} refused before changing anything: {entrypoint['bin']} "
                            f"({link_path}) is a regular file, not a symlink; replacing it with a symlink has no "
                            "recorded inverse -- back it up and remove it manually first")
                # Minor finding ("no after-check"): the entrypoint loop above only validates each
                # bin/* entrypoint's *own* resolved target, never current/<id> itself. If
                # current/<id> already exists (e.g. apply already ran once before relink ever
                # did, or a stale prior link from a different root_name), the entrypoint loop can
                # still pass -- every bin/* still resolves directly into real_root, unredirected
                # -- while current/<id> secretly names a *different* root. The repoint loop below
                # would then blindly move every entrypoint through current/<id>, silently
                # changing what they resolve to instead of preserving it (this tool's core
                # promise). Refused here, before anything is touched, the same as every other
                # pre-check above.
                current_link_path = root / entry["current_link"]
                if current_link_path.exists():
                    if not current_link_path.is_symlink():
                        raise SwitchError(
                            f"relink for {component_id!r} refused before changing anything: "
                            f"{entry['current_link']} ({current_link_path}) exists but is not a symlink; "
                            "replacing it has no recorded inverse")
                    current_link_resolved = os.path.realpath(current_link_path)
                    if current_link_resolved != real_root:
                        raise SwitchError(
                            f"relink for {component_id!r} refused before changing anything: "
                            f"{entry['current_link']} already resolves to {current_link_resolved}, not this "
                            f"pin's real root {real_root} -- repointing every entrypoint through it would "
                            "silently move them to a different root than the one just validated above "
                            "(e.g. apply ran before relink); fix the component spec/pins or resync first")
                # Minor finding (round 7, latent -- no shipped pins-v2 surfaces[] entry does this
                # yet): rollback_txn's resume key for a forward entry is (bare op, surface), not
                # unique per entry. Two surfaces[] entries of the same kind naming the same path
                # would ledger two indistinguishable forward entries; an interrupted rollback's own
                # resume-skip (already_reversed) could then skip BOTH after reversing only the
                # later one, leaving the file half-migrated. A real fix needs a per-forward-entry
                # ledger key (a schema change, out of this round's scope); refusing the spec
                # outright here, before anything is touched, is the cheap, safe mitigation until
                # pins-v2 ever needs more than one surfaces[] entry for the same (kind, path).
                surface_keys = [(surface.get("kind"), surface.get("path")) for surface in entry.get("surfaces") or []
                               if isinstance(surface, dict) and surface.get("path")]
                duplicate_keys = sorted({key for key in surface_keys if surface_keys.count(key) > 1})
                if duplicate_keys:
                    raise SwitchError(
                        f"relink for {component_id!r} refused before changing anything: surfaces[] "
                        f"names the same (kind, path) more than once ({duplicate_keys!r}) -- rollback "
                        "cannot currently resume two indistinguishable forward entries safely; give "
                        "each surfaces[] entry for the same path a distinct kind or consolidate them")
                ledger.append(txn=txn, op="txn_begin", component=component_id, surface="_txn")
                if not current_link_path.exists():
                    fields, _inverse = op_link(root, entry["current_link"], real_root)
                    ledger.append(txn=txn, op="link", component=component_id, surface=entry["current_link"],
                                  rollback_class=entry.get("rollback_class"), **fields)
                for entrypoint in entry.get("entrypoints") or []:
                    if not (isinstance(entrypoint, dict) and entrypoint.get("bin") and entrypoint.get("in_root")):
                        continue
                    new_target = str(root / entry["current_link"] / entrypoint["in_root"])
                    fields, _inverse = op_link(root, entrypoint["bin"], new_target)
                    ledger.append(txn=txn, op="link", component=component_id, surface=entrypoint["bin"],
                                  rollback_class=entry.get("rollback_class"), **fields)
                    expected_before = before_resolved_by_bin.get(entrypoint["bin"])
                    if expected_before is not None:
                        after_resolved = os.path.realpath(root / entrypoint["bin"])
                        if after_resolved != expected_before:
                            raise SwitchError(
                                f"relink for {component_id!r}: after relinking, {entrypoint['bin']} now resolves "
                                f"to {after_resolved}, not {expected_before} as it did before -- aborting (the "
                                "readlink -f before-and-after guarantee); run 'recover' to roll back this "
                                "partial relink")
                current_link_absolute = str(root / entry["current_link"])
                backup_dir = root / "switch" / "backups" / txn
                for surface in entry.get("surfaces") or []:
                    if not isinstance(surface, dict) or not surface.get("path"):
                        continue
                    if surface.get("kind") == "text-replace":
                        old_text = surface.get("old", real_root)
                        expected_count = surface.get("expected_count", 1)
                        # Major finding: this duplicated the pre-resolve_surface_path ternary
                        # (absolute-or-under-root only, never "~"), so a ~ surface's already-
                        # migrated probe read the wrong (nonexistent) path, always found 0 bytes,
                        # and fell through to op_text_replace's own "expected 1, found 0" refusal
                        # on every re-run, even once the real file was already migrated.
                        target_path = resolve_surface_path(root, surface["path"])
                        already_migrated = False
                        with contextlib.suppress(OSError):
                            current_bytes = target_path.read_bytes()
                            already_migrated = (current_bytes.count(old_text.encode("utf-8")) == 0
                                                 and current_bytes.count(current_link_absolute.encode("utf-8")) >= expected_count)
                        if already_migrated:
                            # Idempotent re-run (minor finding): a prior relink already replaced
                            # every occurrence of old_text here and current_link_absolute is
                            # already present -- re-searching for text that is now gone would
                            # otherwise raise, contradicting README/lifecycle.md's "re-running
                            # leaves everything unchanged". A surface where old_text is genuinely
                            # absent AND the new text never landed (misconfigured, not merely
                            # already-done) still falls through to op_text_replace below, which
                            # correctly refuses with "expected N, found 0".
                            continue
                        fields, _inverse = op_text_replace(root, surface["path"], old_text, current_link_absolute,
                                                            backup_dir=backup_dir, expected_count=expected_count,
                                                            expected_pre_sha256=surface.get("expected_pre_sha256"))
                        ledger.append(txn=txn, op="text-replace", component=component_id, surface=surface["path"],
                                      rollback_class=entry.get("rollback_class"), **fields)
                    elif surface.get("kind") == "file-write" and surface.get("content_utf8") is not None:
                        fields, _inverse = op_file_write(root, surface["path"], surface["content_utf8"].encode("utf-8"),
                                                          backup_dir=backup_dir)
                        ledger.append(txn=txn, op="file-write", component=component_id, surface=surface["path"],
                                      rollback_class=entry.get("rollback_class"), **fields)
                ledger.append(txn=txn, op="verify_pass", component=component_id, surface="_txn", to="applied")
                results[component_id] = "relinked"
            save_state(root)
            print(json.dumps({"status": "relinked", "results": results}))
            return 0
        if args.resync:
            if not args.reason:
                raise SwitchError("--resync requires --reason TEXT")
            spec = load_spec(root, args.spec)
            entry = component_entry(spec, args.resync)
            current_link = entry.get("current_link")
            live = read_link_target(root / current_link) if current_link else None
            ledger = Ledger(root)
            ledger.append(txn=f"resync-{args.resync}-{int(time.time())}", op="resync", component=args.resync,
                          surface=current_link or "_none", to=live, rollback_class=entry.get("rollback_class"),
                          backup=args.reason)
            save_state(root)
            print(json.dumps({"status": "resynced", "component": args.resync, "observed": live, "reason": args.reason}))
            return 0
        raise SwitchError("adopt requires exactly one of --baseline, --relink, --resync ID --reason TEXT", EXIT_USAGE)


