SCHEMA_VERSION = 1
EXIT_USAGE = 64
EXIT_BUSY = 75
GENESIS_HASH = "0" * 64

# unit-restart never touches these units, named literally in switch.md's Facts section,
# whether or not a pin/component spec entry exists for them yet.
DENYLISTED_UNITS = frozenset({
    "adaptive-paper-rung1x-20260923-ladder2",
    "ibkr-paper-post-20260923",
    "incentive-forward@1330",
    "mover-daily-scan-0925",
    "mover-rth-trial-20260924",
})

# Refuse a unit-restart that loads a model below this much available memory (matches the
# >=6 GiB rule docs/linux-efficiency.md and this rollout's own common brief apply to workers
# launching heavy jobs on this host). Never lowered via a casual override to force a restart
# through; ECOSYSTEM_SWITCH_MIN_MEMORY_KIB may only raise it (a stricter floor is always safe),
# and only the test-only, unbounded ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB can loosen it.
DEFAULT_MIN_MEMORY_KIB = 6 * 1024 * 1024

OPERATION_KINDS = ("link", "text-replace", "file-write", "native-cli", "unit-restart",
                   "data-backup", "data-restore")
ROLLBACK_CLASSES = ("safe", "restart_required", "manual_required", "not_applicable")
LEDGER_FIELDS = ("seq", "txn", "op", "component", "surface", "from", "to", "pre_sha256",
                  "post_sha256", "backup", "receipt", "window", "rollback_class", "actor",
                  "at_utc", "prev_hash", "hash")

# A window's start_utc/end_utc must be in exactly this shape for the "<= now <=" string
# comparison below to be safe (a non-Z offset or a malformed bound sorts unpredictably and
# could leave a window that looks permanently open or permanently closed).
ISO_UTC_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")


class SwitchError(Exception):
    """A refusal that should print a message and exit non-zero; never a bare traceback."""

    def __init__(self, message: str, exit_code: int = 1):
        super().__init__(message)
        self.exit_code = exit_code


class Busy(SwitchError):
    def __init__(self, message: str):
        super().__init__(message, EXIT_BUSY)


class UnitRestartAttempted(SwitchError):
    """A unit-restart that reached ``systemctl ... restart`` (a real side effect on the host)
    before failing -- either the restart command itself exited non-zero, or it exited 0 but the
    post-restart health probe rejected the result. Unlike a pre-flight refusal (denylisted unit,
    outside its window, or the memory gate: none of which ever call ``restart``), the unit is no
    longer guaranteed to be running the old build here, so the caller must still ledger this step
    (``fields``, gathered as far as the failure allowed) before re-raising: otherwise
    ``rollback_txn``'s reverse-order pass never finds it and never restarts the unit again against
    the reverted root, leaving it running the new (or a crashed) build while the ledger says
    ``rolled_back`` (major finding)."""

    def __init__(self, message: str, fields: dict):
        super().__init__(message)
        self.fields = fields


# --------------------------------------------------------------------------------------
# Small utilities
# --------------------------------------------------------------------------------------

def eco_root() -> Path:
    value = os.environ.get("ECO_INSTALL_ROOT")
    return Path(value) if value else Path.home() / ".local" / "share" / "codex-ecosystem"


def now_utc_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def actor_identity() -> str:
    override = os.environ.get("ECOSYSTEM_SWITCH_ACTOR")
    if override:
        return override
    try:
        user = getpass.getuser()
    except OSError:
        user = "unknown"
    try:
        host = socket.gethostname()
    except OSError:
        host = "unknown"
    return f"{user}@{host}"


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str | None:
    try:
        return sha256_bytes(path.read_bytes())
    except OSError:
        return None


def canonical_json(value) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")


def systemctl_argv() -> list[str]:
    override = os.environ.get("ECOSYSTEM_SWITCH_SYSTEMCTL")
    return shlex.split(override) if override else ["systemctl"]


def systemd_run_argv() -> list[str]:
    override = os.environ.get("ECOSYSTEM_SWITCH_SYSTEMD_RUN")
    return shlex.split(override) if override else ["systemd-run"]


def run_captured(argv: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, timeout=kwargs.pop("timeout", 60), **kwargs)


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600, *, preserve_mode_from: Path | None = None) -> None:
    """Temp file in the same directory, fsync, then os.replace: never a half-written file.
    ``preserve_mode_from`` (an existing file, read before this call replaces anything) overrides
    ``mode`` with that file's own current permission bits, so switching a component's version
    never silently drops an entrypoint wrapper's exec bit -- callers that must always keep a
    fixed mode regardless of what is already on disk (the ledger, state.json, the component
    spec: always 0600) never pass it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if preserve_mode_from is not None:
        with contextlib.suppress(OSError):
            mode = stat.S_IMODE(preserve_mode_from.stat().st_mode)
    fd, tmp_name = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp_name, mode)
        os.replace(tmp_name, path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def atomic_symlink(link_path: Path, target: str) -> None:
    """Point ``link_path`` at ``target`` (a string, absolute or relative to link_path's
    directory) with a rename, never ``ln -sfn``'s remove-then-create window."""
    link_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_name = tempfile.mktemp(dir=str(link_path.parent), prefix=f".{link_path.name}.")
    try:
        os.symlink(target, tmp_name)
        os.replace(tmp_name, link_path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def resolve_surface_path(root: Path, surface: str) -> Path:
    """A surface's path (pins-v2 ``surfaces[]``/``state_dirs[]``'s own ``path``): ``~`` (or
    ``~user``) expands to that user's real home directory -- a state_dirs[] path can live outside
    ``$ECO_INSTALL_ROOT`` entirely (e.g. adoption/pins-linux-x86_64.json's own pending qmd
    ``~/.cache/qmd`` and ai-memory ``~/.local/state/ai-memory`` entries; minor finding: this used
    to be treated as a literal relative path under ``root``, e.g. ``$ECO_INSTALL_ROOT/~/...``,
    which never exists). An absolute path (already covering the ``${STACK_HOME}``-resolved form
    used elsewhere) is used as-is; anything else resolves under ``root``."""
    if surface.startswith("~"):
        return Path(surface).expanduser()
    if surface.startswith("/"):
        return Path(surface)
    return root / surface


def read_link_target(link_path: Path) -> str | None:
    try:
        return os.readlink(link_path)
    except OSError:
        return None


def path_is_under(path: str | None, expected_root: str) -> bool:
    """Whether ``path`` is ``expected_root`` itself or a real descendant of it (component-wise,
    not a substring test): ``.../foo-2.0.0`` must not match ``.../foo-2.0.0-r20260925``."""
    if not path:
        return False
    root_norm = os.path.normpath(expected_root)
    path_norm = os.path.normpath(path)
    return path_norm == root_norm or path_norm.startswith(root_norm + os.sep)


def frozen_surface_issue(surface: str, target: Path) -> str | None:
    """None unless ``surface`` (its literal text or, once resolved, the real path it names)
    passes through a ``frozen/`` directory: a parent-directory symlink into ``*/frozen/*`` must
    refuse a write even when the surface string itself never mentions "frozen"."""
    if "/frozen/" in surface or surface.startswith("frozen/"):
        return f"refusing an operation on a frozen surface: {surface}"
    try:
        resolved = str(target.resolve())
    except OSError:
        resolved = str(target)
    if "/frozen/" in resolved or resolved.endswith("/frozen"):
        return f"refusing an operation on a frozen surface (resolves through frozen/): {surface} -> {resolved}"
    return None


def available_memory_kib() -> int | None:
    try:
        with open("/proc/meminfo", encoding="ascii") as handle:
            for line in handle:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        return None
    return None


# --------------------------------------------------------------------------------------
# Locking
# --------------------------------------------------------------------------------------

@contextlib.contextmanager
def held_lock(path: Path, busy_message: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = open(path, "a+")
    try:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as error:
            if error.errno in (errno.EACCES, errno.EAGAIN):
                raise Busy(busy_message) from None
            raise
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


@contextlib.contextmanager
def switch_locks(root: Path):
    """The tool's own lock, then the bootstrap lock bootstrap-linux.sh also takes
    (root/bootstrap.lock), so a switch operation and a bootstrap run never interleave."""
    with held_lock(root / "switch" / "switch.lock", "another ecosystem-switch operation is running"):
        with held_lock(root / "bootstrap.lock", "an ecosystem bootstrap is running"):
            yield


# --------------------------------------------------------------------------------------
# Ledger and derived state
# --------------------------------------------------------------------------------------

class Ledger:
    def __init__(self, root: Path):
        self.path = root / "switch" / "ledger.jsonl"

    def _last_hash(self) -> str:
        last = GENESIS_HASH
        if self.path.is_file():
            with open(self.path, encoding="utf-8") as handle:
                for line in handle:
                    line = line.strip()
                    if line:
                        last = json.loads(line)["hash"]
        return last

    def append(self, **fields) -> dict:
        """Append one hash-chained entry; fields not given default to None. Returns the
        entry actually written (including seq/prev_hash/hash/actor/at_utc)."""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        entries = self.all()
        seq = (entries[-1]["seq"] + 1) if entries else 1
        prev_hash = entries[-1]["hash"] if entries else GENESIS_HASH
        entry = {key: fields.get(key) for key in LEDGER_FIELDS if key not in ("seq", "prev_hash", "hash", "actor", "at_utc")}
        entry["seq"] = seq
        entry["actor"] = fields.get("actor") or actor_identity()
        entry["at_utc"] = fields.get("at_utc") or now_utc_iso()
        entry["prev_hash"] = prev_hash
        entry["hash"] = sha256_bytes(prev_hash.encode("ascii") + canonical_json(entry))
        line = canonical_json(entry) + b"\n"
        fd = os.open(self.path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
        try:
            os.write(fd, line)
            os.fsync(fd)
        finally:
            os.close(fd)
        return entry

    def all(self) -> list[dict]:
        if not self.path.is_file():
            return []
        entries = []
        with open(self.path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if line:
                    entries.append(json.loads(line))
        return entries

    def verify_chain(self) -> list[str]:
        """Structural problems in the hash chain; empty when it is intact."""
        problems = []
        prev_hash = GENESIS_HASH
        for entry in self.all():
            body = {key: entry.get(key) for key in LEDGER_FIELDS if key not in ("hash",)}
            expected = sha256_bytes(entry.get("prev_hash", "").encode("ascii") + canonical_json(body))
            if entry.get("prev_hash") != prev_hash:
                problems.append(f"seq {entry.get('seq')}: prev_hash does not chain from the prior entry")
            if entry.get("hash") != expected:
                problems.append(f"seq {entry.get('seq')}: hash does not match its own recorded fields")
            prev_hash = entry.get("hash", prev_hash)
        return problems

    def for_txn(self, txn: str) -> list[dict]:
        return [entry for entry in self.all() if entry.get("txn") == txn]


def recompute_state(root: Path) -> dict:
    """Derive switch/state.json purely from the ledger: {components: {id: {current, ...}},
    txns: {txn: {status, component, ops}}}. Used by status/verify/recover; never hand-edited."""
    components: dict[str, dict] = {}
    txns: dict[str, dict] = {}
    for entry in Ledger(root).all():
        txn = entry.get("txn")
        component = entry.get("component")
        op = entry.get("op")
        if txn:
            record = txns.setdefault(txn, {"component": component, "status": "in_progress", "ops": [], "last_seq": 0})
            record["last_seq"] = max(record["last_seq"], entry.get("seq") or 0)
            if op not in ("txn_begin", "verify_pass", "verify_fail", "txn_confirm"):
                record["ops"].append(entry)
            if op == "verify_pass":
                record["status"] = "pending_confirmation" if entry.get("to") == "confirm_pending" else "applied"
            elif op == "txn_confirm":
                record["status"] = "applied"
            elif op == "verify_fail":
                record["status"] = "verify_failed"
            elif op and op.startswith("rollback:") and entry.get("surface") == "_txn_end":
                record["status"] = "rolled_back"
            elif op == "recover:superseded" and entry.get("surface") == "_txn_end":
                # Coordinator decision on the txn state machine (round 5): recover must be able to
                # close an in_progress txn it can prove superseded by a later, already-committed
                # txn for the same component -- accepting that later state as authoritative ("roll
                # forward") rather than physically reversing this one's own partial operations,
                # which would clobber it (see close_superseded_txn). A terminal status distinct
                # from "rolled_back" (nothing here was actually reversed) and "applied" (this txn's
                # own post-apply verify never ran) -- but never "in_progress" either, so recover
                # never revisits it and open_txn_for_component's guard never blocks on it again.
                record["status"] = "superseded"
            elif op in ("baseline", "resync", "prune"):
                # Single-shot, non-transactional records, not a multi-step apply: they carry no
                # reversible operation (rollback_txn's OPERATION_KINDS filter empties them out),
                # so they must reach a terminal status immediately, never sit "in_progress"
                # forever -- otherwise cmd_recover would try to "roll them back" on every run.
                record["status"] = "recorded"
        # Only the component's own current/<id> switch point tracks "current"; a relink also
        # emits "link" entries for each entrypoint (e.g. surface bin/foo), which must not
        # overwrite it -- current_link is always named current/<id> by convention (enforced by
        # adoption/pins-schema-v2.json's current_link pattern), so that prefix identifies it
        # without needing the component spec here. A rollback re-emits the original op name as
        # "rollback:<op>" (e.g. "rollback:link"), which must count the same as "link" here, or a
        # rolled-back link never updates "current" and a later apply sees false drift.
        base_op = op[len("rollback:"):] if isinstance(op, str) and op.startswith("rollback:") else op
        if (component and base_op in ("link", "resync", "baseline") and entry.get("to") is not None
                and (entry.get("surface") or "").startswith("current/")):
            components.setdefault(component, {})["current"] = entry.get("to")
            components[component]["updated_at_utc"] = entry.get("at_utc")
            components[component]["rollback_class"] = entry.get("rollback_class")
            if base_op != "baseline":
                # Minor finding (round 4, previously unresolved): adopt --baseline is documented
                # (adoption/tools/README.md) as "the read-only counterpart ... without changing
                # anything" -- it only re-observes the live current/<id> target, it never writes
                # anything -- so it must never become the txn a pending/in-progress rollback's own
                # superseded-txn refusal compares itself against. It used to: a bare `adopt
                # --baseline` run between `apply --confirm-within` and its own scheduled revert
                # timer re-records the SAME live value apply just set, under a brand-new txn id,
                # which this dict then reported as updated_txn -- so the timer's own `rollback
                # --txn T --if-unconfirmed` refused T as "superseded" by an observation that
                # changed nothing on disk at all. `resync` is deliberately different: an operator
                # names it explicitly to accept a real, out-of-band drifted value, so it
                # legitimately supersedes a still-pending rollback of an older txn.
                components[component]["updated_txn"] = txn
    return {"schema_version": SCHEMA_VERSION, "components": components, "txns": txns,
            "generated_at_utc": now_utc_iso()}


def load_state(root: Path) -> dict:
    return recompute_state(root)


def save_state(root: Path) -> dict:
    state = recompute_state(root)
    atomic_write_bytes(root / "switch" / "state.json", canonical_json(state) + b"\n")
    return state


OPEN_TXN_STATUSES = ("in_progress", "pending_confirmation")


def open_txn_for_component(root: Path, component_id: str) -> tuple[str, str] | None:
    """The (txn id, status) of a transaction already recorded for ``component_id`` whose status is
    still OPEN -- ``in_progress`` (a relink that failed partway, or a crashed/interrupted apply) or
    ``pending_confirmation`` (an apply that passed its own post-apply verify but has not yet been
    confirmed or rolled back) -- or None.

    Coordinator decision on the txn state machine (round 5, replacing the round-4
    in_progress-only, relink-only guard this function used to be): at most one open txn per
    component. Both `apply` and `adopt --relink` refuse (a busy-style EXIT_BUSY refusal, not a
    silent proceed) to start a second one while either state holds. Two concrete failures this
    closes:

    - Major finding (round 4): relink only (re-)links current/<id> when it is absent, so a second,
      "fixed" relink attempt never re-ledgers its own current/<id> link -- recompute_state's
      updated_txn still names the FIRST (stale) txn -- and a later `recover` reversing that stale
      in_progress txn could unlink current/<id> or revert entrypoints/surfaces out from under the
      second attempt's own, already-terminal work, while every command involved kept exiting 0.
    - Major finding (round 5): nothing refused a second `apply` while an earlier one on the same
      component was still `pending_confirmation`, defeating confirm-or-revert outright (apply A1
      v1->v2 --confirm-within, then A2 v2->v3 with nothing refusing it; once A2 itself reverts,
      A1's old root is unrecoverable through either `rollback --txn A1` -- refused as superseded --
      or `rollback foo`, which keeps re-selecting A2).

    The operator closes the existing open txn with `confirm --txn` (pending_confirmation only),
    `rollback --txn`/`rollback <component>` (either state), or -- for an in_progress txn left by a
    crash -- `recover`, which can now close it (see close_superseded_txn) whether or not a later
    txn has since superseded it, so no component is ever left permanently unable to relink/apply
    (the round-5 regression this function's round-4 version introduced: recover could refuse a
    superseded in_progress txn forever, and that refusal itself then blocked relink permanently)."""
    state = load_state(root)
    for txn, record in state["txns"].items():
        if record.get("component") == component_id and record.get("status") in OPEN_TXN_STATUSES:
            return txn, record["status"]
    return None


# --------------------------------------------------------------------------------------
# Component spec ("adopted" registry) -- see adoption/pins-schema-v2.json for the shape
# --------------------------------------------------------------------------------------

def load_spec(root: Path, explicit: Path | None) -> dict:
    """switch/components.json (or an explicit --spec file, copied there on adopt).
    Accepts either the adopted registry's own {"components": {id: {...}}} shape or a raw
    pins-v2 file ({"tools": [{...}]}), converted to the former, keyed by id."""
    path = explicit or (root / "switch" / "components.json")
    if not path.is_file():
        raise SwitchError(f"no component spec at {path}; pass --spec PATH (a pins-v2 shaped "
                           "file or a prior switch/components.json) or run adopt --baseline first")
    document = json.loads(path.read_text(encoding="utf-8"))
    if "tools" in document:
        components = {}
        for tool in document["tools"]:
            components[tool["id"]] = {key: tool.get(key) for key in
                                       ("version", "kind", "root_name", "current_link", "entrypoints",
                                        "surfaces", "state_dirs", "window", "rollback_class")}
        return {"schema_version": SCHEMA_VERSION, "components": components}
    return document


def save_spec(root: Path, spec: dict) -> None:
    atomic_write_bytes(root / "switch" / "components.json", canonical_json(spec) + b"\n")


def component_entry(spec: dict, component_id: str) -> dict:
    entry = (spec.get("components") or {}).get(component_id)
    if entry is None:
        raise SwitchError(f"component {component_id!r} is not in the adopted spec")
    return entry


# --------------------------------------------------------------------------------------
# Windows, receipts, drift and memory gates
# --------------------------------------------------------------------------------------

def load_window(root: Path, name: str) -> dict:
    path = root / "switch" / "windows" / f"{name}.json"
    if not path.is_file():
        raise SwitchError(f"no such window {name!r} ({path})")
    return json.loads(path.read_text(encoding="utf-8"))


def window_issue(window: dict, component_id: str, at_utc: str | None = None) -> str | None:
    now = at_utc or now_utc_iso()
    start, end = window.get("start_utc"), window.get("end_utc")
    if not (isinstance(start, str) and isinstance(end, str) and ISO_UTC_RE.fullmatch(start)
            and ISO_UTC_RE.fullmatch(end)):
        return (f"window {window.get('name')!r} has a malformed start_utc/end_utc ({start!r}..{end!r}, "
                "must be YYYY-MM-DDTHH:MM:SSZ); refusing rather than comparing it as open or closed")
    if not (start <= now <= end):
        return f"window {window.get('name')!r} is not open now ({start}..{end}, now {now})"
    allowed = window.get("allowed_components")
    if not isinstance(allowed, list) or component_id not in allowed:
        return f"window {window.get('name')!r} does not allow component {component_id!r}"
    return None


def load_receipt(root: Path, rid: str) -> dict | None:
    path = root / "switch" / "receipts" / f"{rid}.json"
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


REQUIRED_PASSED_TIERS = ("T0", "T2", "T4")


def receipt_gate_issue(receipt: dict | None, component_id: str, version: str, *,
                        root: Path | None = None, to_root: str | None = None) -> str | None:
    """None when ``receipt`` (a tools/sota-convergence/native-rollout-receipt.schema.json
    document) authorizes switching ``component_id`` to ``version``: overall status passed,
    identity matches, T0/T2/T4 passed, and T1 either passed or declared unavailable. When
    ``root``/``to_root`` are both given (every real ``apply`` call; direct unit tests of the
    documented tier rule in isolation pass neither), also requires the receipt's own
    ``install.root`` (after resolving its ``${STACK_HOME}`` placeholder against ``root``) to name
    that same ``to_root``, so a receipt authorizes only the specific root it was recorded for --
    not merely a same-named version anywhere else on disk. A receipt with no (or a non-string)
    ``install.root`` fails this check rather than skipping it (minor finding: it used to fail
    open, silently authorizing any ``--to-root`` whose basename suffix happened to match
    ``version``). ``install.marker_sha256`` is not cross-checked here: no generic, per-component
    marker-file location is defined yet for ecosystem-switch to locate on its own; a future
    qualify wave may add one."""
    if receipt is None:
        return "receipt not found"
    if receipt.get("status") != "passed":
        return f"receipt status is {receipt.get('status')!r}, not \"passed\""
    identity = receipt.get("identity") if isinstance(receipt.get("identity"), dict) else {}
    if identity.get("component_id") != component_id or identity.get("version") != version:
        return (f"receipt identity ({identity.get('component_id')!r}, {identity.get('version')!r}) "
                f"does not match ({component_id!r}, {version!r})")
    if root is not None and to_root is not None:
        install = receipt.get("install") if isinstance(receipt.get("install"), dict) else {}
        declared_root = install.get("root")
        if not isinstance(declared_root, str) or not declared_root:
            return "receipt has no install.root to bind it to a specific root"
        resolved_root = declared_root.replace("${STACK_HOME}", str(root))
        if os.path.normpath(resolved_root) != os.path.normpath(to_root):
            return (f"receipt install.root {declared_root!r} (resolved {resolved_root!r}) does not match "
                    f"--to-root {to_root!r}")
    tiers = {tier.get("tier"): tier for tier in receipt.get("tiers") or [] if isinstance(tier, dict)}
    for required in REQUIRED_PASSED_TIERS:
        tier = tiers.get(required)
        if tier is None or tier.get("result") != "passed":
            return f"receipt tier {required} is not passed"
    tier_one = tiers.get("T1")
    if tier_one is None:
        return "receipt has no T1 tier (must be passed or declared unavailable)"
    if tier_one.get("result") == "passed":
        pass
    elif tier_one.get("result") == "unavailable" and (tier_one.get("unavailable_reason") or "").strip():
        pass
    else:
        return "receipt T1 tier is neither passed nor declared unavailable with a reason"
    return None


def drift_issue(root: Path, component_id: str, entry: dict) -> str | None:
    """None when the live current/<id> target still matches what the ledger last recorded;
    a mismatch means something changed the link outside this tool ('drift ⇒ refuse')."""
    current_link = entry.get("current_link")
    if not current_link:
        return None
    state = load_state(root)
    recorded = (state["components"].get(component_id) or {}).get("current")
    if recorded is None:
        return None
    live = read_link_target(root / current_link)
    if live != recorded:
        return (f"drift: {current_link} resolves to {live!r}, but the ledger's last recorded value "
                f"for {component_id!r} is {recorded!r}; run 'adopt --resync {component_id} --reason ...' "
                "to accept the live value before switching")
    return None


def memory_gate_issue(min_kib: int | None = None) -> str | None:
    """None when available memory clears the floor. ``ECOSYSTEM_SWITCH_MIN_MEMORY_KIB`` may only
    RAISE ``DEFAULT_MIN_MEMORY_KIB`` -- never lower this safety floor (meant to prevent an OOM
    during a model-loading restart) via a casual env var -- so a request below the default is
    clamped back up to it rather than trusted outright. Minor finding: the clamp direction used
    to be inverted (``min(requested, DEFAULT)``), letting this var silently disable the gate down
    to 0 while a request to make it *stricter* was the one silently ignored -- backwards for a
    floor whose purpose is preventing an OOM, where loosening is the dangerous direction (a
    restart proceeds with too little memory) and tightening is always safe (at worst, an
    unnecessarily refused restart). ``ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB`` has no such
    floor; it exists only so a test can deterministically force this gate to refuse regardless of
    the real host's MemAvailable, without also loosening the production-facing variable's own
    one-directional guarantee."""
    if min_kib is not None:
        minimum = min_kib
    else:
        forced = os.environ.get("ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB")
        if forced is not None:
            minimum = int(forced)
        else:
            requested = os.environ.get("ECOSYSTEM_SWITCH_MIN_MEMORY_KIB")
            minimum = max(int(requested), DEFAULT_MIN_MEMORY_KIB) if requested is not None else DEFAULT_MIN_MEMORY_KIB
    available = available_memory_kib()
    if available is None:
        return "cannot read /proc/meminfo; refusing a restart that may load a model"
    if available < minimum:
        return f"only {available} KiB MemAvailable, below the {minimum} KiB floor for a model-loading restart"
    return None


# --------------------------------------------------------------------------------------
# Operation kinds: each returns (ledger_fields: dict, inverse: dict) on success, or raises
# SwitchError. ``inverse`` is itself an operation spec that undoes this one when re-applied
# by rollback (same op kind, from/to swapped, plus whatever the specific kind needs to restore
# a backup).
# --------------------------------------------------------------------------------------

def op_link(root: Path, surface: str, to: str) -> tuple[dict, dict]:
    link_path = root / surface
    before = read_link_target(link_path)
    atomic_symlink(link_path, to)
    after = read_link_target(link_path)
    if after != to:
        raise SwitchError(f"link verification failed after replace: {link_path} resolves to {after!r}, not {to!r}")
    fields = {"from": before, "to": to,
              "pre_sha256": sha256_text(before or ""), "post_sha256": sha256_text(to)}
    inverse = {"kind": "link", "surface": surface, "to": before} if before is not None else None
    return fields, inverse


def op_text_replace(root: Path, surface: str, old: str, new: str, *, backup_dir: Path,
                     expected_count: int = 1, expected_pre_sha256: str | None = None) -> tuple[dict, dict]:
    target = resolve_surface_path(root, surface)
    frozen_issue = frozen_surface_issue(surface, target)
    if frozen_issue:
        raise SwitchError(frozen_issue)
    if not target.is_file():
        raise SwitchError(f"text-replace target does not exist: {target}")
    original = target.read_bytes()
    if expected_pre_sha256 is not None and sha256_bytes(original) != expected_pre_sha256:
        raise SwitchError(f"text-replace on {target}: current contents (sha256 {sha256_bytes(original)}) do not "
                           f"match the expected pre-image ({expected_pre_sha256}); something else changed it")
    count = original.count(old.encode("utf-8"))
    if count != expected_count:
        raise SwitchError(f"text-replace on {target}: expected {old!r} to occur {expected_count} time(s), found {count}")
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup_path = backup_dir / f"{sha256_bytes(original)[:16]}-{target.name}.orig"
    if not backup_path.exists():
        atomic_write_bytes(backup_path, original)
    updated = original.replace(old.encode("utf-8"), new.encode("utf-8"))
    fd, tmp_name = tempfile.mkstemp(dir=str(target.parent), prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(updated)
            handle.flush()
            os.fsync(handle.fileno())
        if target.suffix == ".json":
            json.loads(updated.decode("utf-8"))
        elif target.suffix == ".toml":
            _parse_toml_or_raise(updated)
        os.chmod(tmp_name, stat.S_IMODE(target.stat().st_mode))
        os.replace(tmp_name, target)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise
    fields = {"from": old, "to": new, "pre_sha256": sha256_bytes(original), "post_sha256": sha256_bytes(updated),
              "backup": str(backup_path)}
    inverse = {"kind": "text-replace", "surface": surface, "old": new, "new": old,
               "expected_count": count, "restore_from_backup": str(backup_path)}
    return fields, inverse


def _parse_toml_or_raise(data: bytes) -> None:
    """Refuse a text-replace that leaves a .toml surface (e.g. a codex MCP config) unparsable.
    ``tomllib`` (stdlib) needs Python 3.11+; on an older interpreter this check is skipped rather
    than failing every .toml text-replace outright -- report-only, matching this tool's other
    best-effort re-parse checks (JSON is required everywhere it applies because it always has
    been; TOML support is new and every currently shipped pins-v2 surfaces[] entry is empty, so
    nothing exercises this in production yet)."""
    try:
        import tomllib
    except ImportError:
        return
    try:
        tomllib.loads(data.decode("utf-8"))
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
        raise ValueError(f"not valid TOML after replacement: {error}") from error


def op_file_write(root: Path, surface: str, content: bytes, *, backup_dir: Path) -> tuple[dict, dict]:
    target = resolve_surface_path(root, surface)
    frozen_issue = frozen_surface_issue(surface, target)
    if frozen_issue:
        raise SwitchError(frozen_issue)
    before = target.read_bytes() if target.is_file() else None
    backup_path = None
    if before is not None:
        backup_dir.mkdir(parents=True, exist_ok=True)
        backup_path = backup_dir / f"{sha256_bytes(before)[:16]}-{target.name}.orig"
        if not backup_path.exists():
            atomic_write_bytes(backup_path, before)
    atomic_write_bytes(target, content, preserve_mode_from=target if before is not None else None)
    fields = {"from": sha256_bytes(before) if before is not None else None, "to": sha256_bytes(content),
              "pre_sha256": sha256_bytes(before) if before is not None else None, "post_sha256": sha256_bytes(content),
              "backup": str(backup_path) if backup_path else None}
    inverse = {"kind": "file-write", "surface": surface,
               "restore_from_backup": str(backup_path) if backup_path else None, "remove_if_no_backup": before is None}
    return fields, inverse


NATIVE_CLI_ALLOWED = (("claude", "mcp"), ("claude", "plugin"), ("codex", "mcp"))


def op_native_cli(argv: list[str], inverse_argv: list[str] | None, *, read_only_check: list[str] | None = None) -> tuple[dict, dict]:
    program = Path(argv[0]).name if argv else ""
    if (program, argv[1] if len(argv) > 1 else None) not in NATIVE_CLI_ALLOWED:
        raise SwitchError(f"native-cli refuses argv {argv!r}: only claude mcp/plugin or codex mcp are switch-managed")
    before = run_captured(read_only_check) if read_only_check else None
    result = run_captured(argv)
    if result.returncode != 0:
        raise SwitchError(f"native-cli {argv!r} exited {result.returncode}: {result.stderr.strip()[:400]}")
    after = run_captured(read_only_check) if read_only_check else None
    fields = {"from": sha256_text(before.stdout) if before else None,
              "to": sha256_text(after.stdout) if after else sha256_text(" ".join(argv)),
              "pre_sha256": sha256_text(before.stdout) if before else None,
              "post_sha256": sha256_text(after.stdout) if after else sha256_text(result.stdout)}
    inverse = {"kind": "native-cli", "argv": inverse_argv, "read_only_check": read_only_check} if inverse_argv else None
    return fields, inverse


def op_unit_restart(unit: str, *, window_component_ok: bool, expected_root: str) -> tuple[dict, dict]:
    if unit in DENYLISTED_UNITS:
        raise SwitchError(f"refusing to restart denylisted unit {unit}")
    if not window_component_ok:
        raise SwitchError(f"unit-restart of {unit} refused: outside its granted window")
    memory_issue = memory_gate_issue()
    if memory_issue:
        raise SwitchError(f"unit-restart of {unit} refused: {memory_issue}")
    # Minor finding: unlike the restart/post-restart-show timeouts below (both of which follow a
    # real `systemctl ... restart` attempt, so a timeout there must still be ledgered via
    # UnitRestartAttempted before re-raising), this pre-restart probe and the daemon-reload call
    # right after it both run BEFORE systemctl is ever asked to restart anything -- nothing about
    # what is actually running has changed yet, so a timeout here is a plain refusal (the same
    # SwitchError shape as the denylist/window/memory gates above), not a side effect rollback_txn
    # would ever need to find and re-apply.
    try:
        before = run_captured([*systemctl_argv(), "--user", "show", "--property=MainPID", "--value", unit])
    except subprocess.TimeoutExpired as error:
        raise SwitchError(f"pre-restart status check for {unit} timed out after {error.timeout}s; "
                           "refusing rather than restarting without a known prior MainPID") from error
    except OSError as error:
        # Minor finding (round 5): a missing/misconfigured systemctl (FileNotFoundError via
        # ECOSYSTEM_SWITCH_SYSTEMCTL or PATH; PermissionError if it exists but is not executable)
        # never even spawns -- nothing about what is running has changed, so this is a plain
        # refusal too, the same as the timeout case above (never UnitRestartAttempted: unlike a
        # client-side timeout, a spawn failure means systemctl was never actually invoked at all).
        raise SwitchError(f"pre-restart status check for {unit} could not run systemctl: {error}") from error
    before_fields = {"from": (before.stdout or "").strip(), "pre_sha256": sha256_text(before.stdout or "")}
    try:
        run_captured([*systemctl_argv(), "--user", "daemon-reload"])
    except subprocess.TimeoutExpired as error:
        raise SwitchError(f"systemctl --user daemon-reload timed out after {error.timeout}s before "
                           f"restarting {unit}; refusing rather than restarting against possibly "
                           "stale unit definitions") from error
    except OSError as error:
        raise SwitchError(f"systemctl --user daemon-reload could not run before restarting "
                           f"{unit}: {error}") from error
    try:
        restart = run_captured([*systemctl_argv(), "--user", "restart", unit])
    except subprocess.TimeoutExpired as error:
        # Minor finding: a bare subprocess.TimeoutExpired is not a SwitchError, so cmd_apply's
        # step loop (which only catches UnitRestartAttempted/SwitchError) used to let it escape as
        # an uncaught traceback -- skipping both this step's ledger entry and the automatic
        # rollback. Treated the same as a real side effect (UnitRestartAttempted, not re-raised
        # as-is): the systemctl *client* timed out, but systemd itself completes the queued
        # restart job independent of that client (its default TimeoutStopSec, 90s, already exceeds
        # run_captured's 60s), so the unit may no longer be running the old build either way.
        raise UnitRestartAttempted(
            f"systemctl --user restart {unit} timed out after {error.timeout}s; systemd may have "
            "completed the restart after the client that requested it was abandoned",
            {**before_fields, "to": None, "post_sha256": sha256_text("")}) from error
    except OSError as error:
        # Unlike the timeout above, a spawn failure here (round 5 minor finding) means systemctl
        # never ran at all, so systemd was never asked to restart anything -- a plain refusal, not
        # UnitRestartAttempted (nothing was attempted).
        raise SwitchError(f"systemctl --user restart {unit} could not run: {error}") from error
    if restart.returncode != 0:
        # A real side effect (systemctl restart was actually invoked) even though it failed: the
        # unit may no longer be running the old build. UnitRestartAttempted carries what little
        # this call knows (the pre-restart MainPID; no post-restart exe to report) so the caller
        # can still ledger the attempt before re-raising (major finding).
        raise UnitRestartAttempted(
            f"systemctl --user restart {unit} exited {restart.returncode}: {restart.stderr.strip()[:400]}",
            {**before_fields, "to": None, "post_sha256": sha256_text("")})
    try:
        after_pid = run_captured([*systemctl_argv(), "--user", "show", "--property=MainPID", "--value", unit])
    except subprocess.TimeoutExpired as error:
        # Same reasoning as the restart timeout above: the restart itself already succeeded, so
        # this is purely a health-probe failure, not an unattempted restart.
        raise UnitRestartAttempted(
            f"post-restart status check for {unit} timed out after {error.timeout}s",
            {**before_fields, "to": None, "post_sha256": sha256_text("")}) from error
    except OSError as error:
        # The restart itself already succeeded (returncode 0, reached this line), so systemctl
        # plainly runs -- a spawn failure only now is still a real side effect either way (round 5
        # minor finding), the same as the timeout case just above.
        raise UnitRestartAttempted(
            f"post-restart status check for {unit} could not run: {error}",
            {**before_fields, "to": None, "post_sha256": sha256_text("")}) from error
    pid = (after_pid.stdout or "").strip()
    exe = None
    if pid.isdigit() and pid != "0":
        exe = read_link_target(Path(f"/proc/{pid}/exe"))
    if exe is None or not path_is_under(exe, expected_root):
        # The restart command itself succeeded (returncode 0): the unit was actually restarted,
        # just not health-probed as landing under expected_root. Same reasoning as above.
        raise UnitRestartAttempted(
            f"health probe failed for {unit}: /proc/{pid}/exe is {exe!r}, expected it under {expected_root!r}",
            {**before_fields, "to": exe, "post_sha256": sha256_text(exe or "")})
    fields = {**before_fields, "to": exe, "post_sha256": sha256_text(exe)}
    inverse = None  # a unit-restart's inverse is another unit-restart after the link is rolled back; the
    # caller (apply's reverse-order rollback) re-issues op_unit_restart against the reverted root, not this dict.
    return fields, inverse


def op_data_backup(root: Path, surface: str, *, backup_dir: Path) -> tuple[dict, dict]:
    source = resolve_surface_path(root, surface)
    if not source.is_dir():
        raise SwitchError(f"data-backup source is not a directory, refusing to record an empty backup: {source}")
    manifest = sorted(str(p.relative_to(source)) for p in source.rglob("*"))
    destination = backup_dir / surface.replace("/", "__")
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(source, destination, symlinks=True)
    fields = {"from": surface, "to": str(destination), "pre_sha256": sha256_text("\n".join(manifest)),
              "post_sha256": sha256_text("\n".join(manifest)), "backup": str(destination)}
    inverse = {"kind": "data-restore", "surface": surface, "restore_from_backup": str(destination)}
    return fields, inverse


def op_data_restore(root: Path, surface: str, backup_path: str) -> tuple[dict, dict]:
    destination = resolve_surface_path(root, surface)
    source = Path(backup_path)
    if not source.is_dir():
        raise SwitchError(f"data-restore backup missing: {source}")
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(source, destination, symlinks=True)
    fields = {"from": str(source), "to": surface, "pre_sha256": None, "post_sha256": None, "backup": str(source)}
    return fields, {}


def _write_reversal_issue(target: Path, entry: dict) -> str | None:
    """None when reversing a text-replace/file-write ``entry`` against ``target`` right now would
    succeed (or is already a verified no-op); otherwise the refusal message. The surface's current
    bytes must match either ``entry``'s own recorded ``post_sha256`` (what THIS operation itself
    last wrote -- the ordinary, not-yet-rolled-back case) or its ``pre_sha256`` (what reversing it
    would restore). Coordinator decision (round 6): a live target already matching the pre-image is
    "already reverted", not drift -- e.g. an earlier, interrupted rollback attempt already
    performed this exact restore but was killed before it could ledger it, or a second `rollback`
    call after the first already finished. Re-running the restore against bytes that already match
    it is a safe no-op (restore-from-backup, the path a text-replace/file-write reversal always
    takes when a backup exists, simply rewrites the identical bytes again). Only a third,
    unexplained value is refused. Split from a raising ``_refuse_if_drifted_since_write`` (round 7)
    so ``rollback_txn``'s own all-entries pre-check can ask the same question for every entry
    before mutating any of them, not just the one about to be reversed."""
    expected_post = entry.get("post_sha256")
    if expected_post is None:
        return None
    current = sha256_file(target)
    if current is None or current == expected_post or current == entry.get("pre_sha256"):
        return None
    return (f"refusing to roll back {target}: its current contents (sha256 {current}) no longer "
            f"match what this operation last wrote ({expected_post}); investigate before rolling back")


def _refuse_if_drifted_since_write(target: Path, entry: dict) -> None:
    """Raising wrapper over ``_write_reversal_issue``, used by ``apply_inverse``'s own
    text-replace/file-write reversal (the mutating path); see that function for the actual check."""
    issue = _write_reversal_issue(target, entry)
    if issue:
        raise SwitchError(issue)


def apply_inverse(root: Path, entry: dict, spec_inverse: dict, *, backup_dir: Path) -> None:
    kind = spec_inverse.get("kind")
    if kind == "link":
        op_link(root, spec_inverse["surface"], spec_inverse["to"])
    elif kind == "text-replace":
        # Major finding: this used to build the rollback target as root / spec_inverse["surface"],
        # never expanding a "~" surface the forward path (op_text_replace, via resolve_surface_path)
        # already handles. A ~-rooted surface (e.g. a user unit or ~/codex-ecosystem/bin wrapper,
        # the only way such a consumer can be committed at all -- validate.py's personal-home-path
        # scan rejects a literal /home/<user> path in a tracked file) would then have its pre-image
        # written to $ECO_INSTALL_ROOT/~/..., leaving the real file untouched while current/<id> was
        # already unlinked: the real consumer is left pointing at nothing, and a relink re-run on
        # that surface fails since the real file was never actually rolled back.
        target = resolve_surface_path(root, spec_inverse["surface"])
        _refuse_if_drifted_since_write(target, entry)
        backup_path = spec_inverse.get("restore_from_backup")
        if backup_path and Path(backup_path).is_file():
            atomic_write_bytes(target, Path(backup_path).read_bytes(), preserve_mode_from=target if target.exists() else None)
        else:
            op_text_replace(root, spec_inverse["surface"], spec_inverse["old"], spec_inverse["new"],
                             backup_dir=backup_dir, expected_count=spec_inverse.get("expected_count", 1))
    elif kind == "file-write":
        target = resolve_surface_path(root, spec_inverse["surface"])
        _refuse_if_drifted_since_write(target, entry)
        backup_path = spec_inverse.get("restore_from_backup")
        if backup_path and Path(backup_path).is_file():
            atomic_write_bytes(target, Path(backup_path).read_bytes(), preserve_mode_from=target if target.exists() else None)
        elif spec_inverse.get("remove_if_no_backup") and target.is_file():
            target.unlink()
    elif kind == "native-cli" and spec_inverse.get("argv"):
        op_native_cli(spec_inverse["argv"], None, read_only_check=spec_inverse.get("read_only_check"))
    elif kind == "data-restore":
        op_data_restore(root, spec_inverse["surface"], spec_inverse["restore_from_backup"])
    # unit-restart's inverse is issued by the caller directly (see op_unit_restart's note).


# --------------------------------------------------------------------------------------
# plan / apply / confirm / rollback / verify / recover
# --------------------------------------------------------------------------------------

def build_apply_plan(spec: dict, component_id: str, to_root: str, *, root: Path) -> list[dict]:
    entry = component_entry(spec, component_id)
    if not entry.get("current_link"):
        raise SwitchError(f"component {component_id!r} has no current_link; run adopt --relink first")
    if not (root / entry["current_link"]).exists():
        # Minor finding: build_apply_plan used to check only that the *spec* named a
        # current_link string, not that adopt --relink had actually pointed bin/* through it
        # yet. Applying before that left current/<id> created fresh at --to-root while every
        # entrypoint still resolved directly into the *old* real root (never redirected through
        # current/<id> in the first place) -- apply would report "applied" with the new root in
        # `status`, but bin/* stayed on the old one.
        raise SwitchError(f"component {component_id!r}'s {entry['current_link']} does not exist yet; "
                           "run 'adopt --relink' first so bin/* already resolves through it")
    if not to_root.startswith("/"):
        raise SwitchError(f"--to-root must be an absolute path (got {to_root!r}): a symlink written at "
                           "current/<id> resolves a relative target against current/'s own directory, "
                           "not ECO_INSTALL_ROOT")
    steps = []
    # A qualified (non-"pending") state_dirs[] entry must be backed up before the version that
    # will use it next takes over the link -- the ai-memory pin's own note is explicit that a
    # switch "must data-backup it". A "pending" entry (every one shipped so far: no state_dirs
    # path has been independently re-verified yet) is left for the qualify wave, not guessed at.
    for state_dir in entry.get("state_dirs") or []:
        if isinstance(state_dir, dict) and isinstance(state_dir.get("path"), str) and state_dir.get("status") != "pending":
            steps.append({"kind": "data-backup", "surface": state_dir["path"]})
    steps.append({"kind": "link", "surface": entry["current_link"], "to": to_root})
    for surface in entry.get("surfaces") or []:
        if isinstance(surface, dict) and surface.get("kind") == "unit-restart" and surface.get("path"):
            steps.append({"kind": "unit-restart", "unit": surface["path"], "expected_root": to_root})
    return steps


def plan_sha256(steps: list[dict]) -> str:
    return sha256_bytes(canonical_json(steps))


def cmd_plan(args) -> int:
    root = eco_root()
    spec = load_spec(root, args.spec)
    steps = build_apply_plan(spec, args.component, args.to_root, root=root)
    digest = plan_sha256(steps)
    print(json.dumps({"component": args.component, "to_root": args.to_root, "receipt": args.receipt,
                      "plan_sha256": digest, "steps": steps}, sort_keys=True, indent=2))
    return 0


def cmd_apply(args) -> int:
    root = eco_root()
    with switch_locks(root):
        spec = load_spec(root, args.spec)
        entry = component_entry(spec, args.component)
        # Coordinator decision on the txn state machine (round 5), superseding round 4's
        # deliberate omission of this guard here (evidence: the round-4 fix task record's own
        # reasoning, now stale -- see open_txn_for_component and close_superseded_txn for why it no
        # longer applies): at most one open txn per component. apply refuses (busy, EXIT_BUSY, not
        # a silent proceed) while an earlier txn on the same component is still in_progress
        # (crashed) or pending_confirmation (awaiting its own confirm-or-revert timer). The
        # pending_confirmation case is the major finding this closes: nothing used to stop a second
        # apply on top of an unconfirmed one (apply A1 v1->v2 --confirm-within, then A2 v2->v3),
        # which defeated confirm-or-revert outright -- once A2 itself reverted, A1's old root was
        # unrecoverable through either `rollback --txn A1` (refused as superseded by A2) or
        # `rollback foo` (which kept re-selecting A2). The in_progress case no longer needs
        # round 4's carve-out either: `recover` can now close a superseded in_progress txn instead
        # of only ever refusing to reverse it (close_superseded_txn), so refusing a stacked apply
        # here never creates the permanent-block round 4 was avoiding.
        open_txn = open_txn_for_component(root, args.component)
        if open_txn is not None:
            open_id, open_status = open_txn
            raise Busy(
                f"apply refused: component {args.component!r} already has an open transaction "
                f"{open_id!r} (status {open_status!r}) -- run 'confirm --txn {open_id}' (if "
                f"pending_confirmation) or 'rollback --txn {open_id}' to close it, or 'recover' if "
                "it is in_progress after a crash, before retrying")
        steps = build_apply_plan(spec, args.component, args.to_root, root=root)
        digest = plan_sha256(steps)
        if digest != args.plan_sha256:
            raise SwitchError(f"--plan-sha256 {args.plan_sha256} does not match the live plan ({digest}); "
                               "re-run plan and review before applying")
        to_root_name = Path(args.to_root).name
        prefix = f"{args.component}-"
        if not to_root_name.startswith(prefix):
            raise SwitchError(f"--to-root basename {to_root_name!r} does not start with the expected "
                               f"{prefix!r} prefix for component {args.component!r}; refusing to guess a version")
        full_suffix = to_root_name[len(prefix):]

        # Every gate below must pass BEFORE current/<id> (or any unit) is touched: a receipt,
        # window, memory or denylist refusal must never leave a half-applied component.
        receipt = load_receipt(root, args.receipt)
        # identity.version must stay the clean upstream version throughout its life: it is what
        # record_native_rollout.py copies verbatim into a landscape winner's pin (read downstream
        # by validate_pins_v2 parity and platform_status.py's host-receipt binding against a live
        # host's plain `--version` output), never a --to-root basename. Deriving an "expected
        # version" from --to-root and forcing identity.version to equal it byte-for-byte (the old
        # design) broke exactly that for a staged bootstrap --tools-suffix root (e.g.
        # tools/rtk-0.50.0-r20260925): a receipt for the real "0.50.0" was refused, and a receipt
        # written to satisfy apply instead polluted the pin with "0.50.0-r20260925" (major
        # finding). So this reads the receipt's own claimed identity.version first and only checks
        # it is *consistent* with the root name (exactly "<component>-<version>", or that plus a
        # "-<suffix>" staging marker) -- the receipt's install.root (checked below, exact match
        # required) is what binds it to this *specific* staged root, not the version string.
        identity = receipt.get("identity") if isinstance(receipt, dict) and isinstance(receipt.get("identity"), dict) else {}
        claimed_version = identity.get("version")
        if isinstance(claimed_version, str) and claimed_version:
            if not (full_suffix == claimed_version or full_suffix.startswith(f"{claimed_version}-")):
                raise SwitchError(f"receipt gate: receipt identity.version {claimed_version!r} is not consistent "
                                   f"with --to-root basename {to_root_name!r} (expected {prefix!r} + "
                                   f"{claimed_version!r}, optionally followed by '-<staging suffix>')")
            version = claimed_version
        else:
            version = full_suffix
        receipt_issue = receipt_gate_issue(receipt, args.component, version, root=root, to_root=args.to_root)
        if receipt_issue:
            raise SwitchError(f"receipt gate: {receipt_issue}")
        window = load_window(root, args.window)
        window_issue_text = window_issue(window, args.component)
        if window_issue_text:
            raise SwitchError(f"window gate: {window_issue_text}")
        drift = drift_issue(root, args.component, entry)
        if drift:
            raise SwitchError(drift)
        for step in steps:
            if step["kind"] == "unit-restart":
                if step["unit"] in DENYLISTED_UNITS:
                    raise SwitchError(f"refusing to restart denylisted unit {step['unit']}")
                memory_issue = memory_gate_issue()
                if memory_issue:
                    raise SwitchError(f"unit-restart of {step['unit']} refused: {memory_issue}")

        ledger = Ledger(root)
        txn = f"{args.component}-{int(time.time())}-{os.getpid()}"
        backup_dir = root / "switch" / "backups" / txn
        ledger.append(txn=txn, op="txn_begin", component=args.component, surface="_txn",
                      receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"))
        try:
            for step in steps:
                if step["kind"] == "link":
                    fields, _inverse = op_link(root, step["surface"], step["to"])
                    surface = step["surface"]
                elif step["kind"] == "unit-restart":
                    surface = step["unit"]
                    try:
                        fields, _inverse = op_unit_restart(step["unit"], window_component_ok=True,
                                                           expected_root=step["expected_root"])
                    except UnitRestartAttempted as error:
                        # Major finding: a restart that reached systemctl before failing (a
                        # non-zero exit, or a health probe that rejected the result) is a real
                        # side effect rollback_txn must still be able to find. Ledger it here,
                        # before re-raising, so the reverse-order rollback below restarts the
                        # unit again against the reverted root instead of leaving it running the
                        # new (or a crashed) build while the ledger says "rolled_back".
                        ledger.append(txn=txn, op="unit-restart", component=args.component, surface=surface,
                                      receipt=args.receipt, window=args.window,
                                      rollback_class=entry.get("rollback_class"), **error.fields)
                        raise SwitchError(str(error)) from error
                elif step["kind"] == "data-backup":
                    fields, _inverse = op_data_backup(root, step["surface"], backup_dir=backup_dir)
                    surface = step["surface"]
                else:
                    raise SwitchError(f"unsupported plan step kind: {step['kind']}")
                ledger.append(txn=txn, op=step["kind"], component=args.component, surface=surface,
                              receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"), **fields)
            verify_issue = verify_component(root, args.component, spec)
            if verify_issue:
                ledger.append(txn=txn, op="verify_fail", component=args.component, surface="_txn",
                              receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"),
                              to=verify_issue)
                raise SwitchError(f"post-apply verify failed: {verify_issue}")
            confirm_target = "confirm_pending" if args.confirm_within else "applied"
            ledger.append(txn=txn, op="verify_pass", component=args.component, surface="_txn",
                          receipt=args.receipt, window=args.window, rollback_class=entry.get("rollback_class"),
                          to=confirm_target)
        except SwitchError as error:
            problems = rollback_txn(root, txn)
            save_state(root)
            suffix = f" (rollback also reported: {'; '.join(problems)})" if problems else ""
            raise SwitchError(f"apply failed and was automatically rolled back: {error}{suffix}") from error
        save_state(root)
        if args.confirm_within:
            schedule_confirm_or_revert(root, txn, args.confirm_within)
            print(json.dumps({"status": "pending_confirmation", "txn": txn, "confirm_within": args.confirm_within}))
        else:
            print(json.dumps({"status": "applied", "txn": txn}))
        return 0


def schedule_confirm_or_revert(root: Path, txn: str, seconds: int) -> None:
    """Ask systemd-run (or its test stub, ECOSYSTEM_SWITCH_SYSTEMD_RUN) to call this same
    executable back with `rollback --txn TXN --if-unconfirmed` after ``seconds``. If even
    *scheduling* the timer fails, a pending apply nothing will ever revert is worse than
    reverting immediately: fall back to an in-process rollback right away. ECO_INSTALL_ROOT and
    the test-stub variables are forwarded explicitly with --setenv=: a systemd --user unit does
    not inherit this process's environment on its own, so a non-default root (or a test's
    systemctl/systemd-run stub) would otherwise act on the default root once the timer fires."""
    self_path = str(Path(sys.argv[0]).resolve())
    setenv_args = []
    for name in ("ECO_INSTALL_ROOT", "ECOSYSTEM_SWITCH_SYSTEMCTL", "ECOSYSTEM_SWITCH_SYSTEMD_RUN",
                 "ECOSYSTEM_SWITCH_ACTOR", "ECOSYSTEM_SWITCH_MIN_MEMORY_KIB",
                 "ECOSYSTEM_SWITCH_TEST_FORCE_MIN_MEMORY_KIB"):
        value = os.environ.get(name)
        if value is not None:
            setenv_args.append(f"--setenv={name}={value}")
    argv = [*systemd_run_argv(), "--user", f"--on-active={seconds}s",
            f"--unit=ecosystem-switch-revert-{txn}", *setenv_args, "--", sys.executable, self_path,
            "rollback", "--txn", txn, "--if-unconfirmed"]
    try:
        result = run_captured(argv, env=dict(os.environ))
    except subprocess.TimeoutExpired as error:
        # Minor finding (round 4): unlike the clean non-zero-exit case just below (already
        # handled by rolling back immediately rather than leaving a pending apply nothing will
        # ever revert), a bare subprocess.TimeoutExpired here used to escape this function
        # uncaught: cmd_apply's own try/except has already closed by the time this runs (its
        # verify_pass was already ledgered), so main()'s generic timeout catch is the only thing
        # that stops a raw traceback, and it neither rolls back nor mentions `recover`. Whether
        # systemd-run itself actually scheduled the timer before its own client timed out is
        # unknown either way -- treated the same as a confirmed scheduling failure, for the same
        # reason: an apply nothing will ever revert is worse than reverting immediately (and if
        # the timer WAS scheduled despite the timeout, its later `--if-unconfirmed` fire is a
        # harmless no-op against an already-`rolled_back` txn).
        rollback_txn(root, txn)
        raise SwitchError(f"could not confirm the confirm-or-revert timer was scheduled (systemd-run "
                           f"timed out after {error.timeout}s); rolled back immediately instead of "
                           "leaving an unrevertable pending apply") from error
    except OSError as error:
        # Minor finding (round 5): a missing/misconfigured systemd-run (FileNotFoundError via
        # ECOSYSTEM_SWITCH_SYSTEMD_RUN or PATH; PermissionError) used to escape this function
        # uncaught the same way the timeout case above did before its own round-4 fix -- same
        # remedy: the timer was definitely never scheduled (the spawn itself failed), so roll back
        # immediately rather than leave an apply nothing will ever revert.
        rollback_txn(root, txn)
        raise SwitchError(f"could not schedule the confirm-or-revert timer (systemd-run could not "
                           f"run: {error}); rolled back immediately instead of leaving an "
                           "unrevertable pending apply") from error
    if result.returncode != 0:
        rollback_txn(root, txn)
        raise SwitchError(f"could not schedule the confirm-or-revert timer ({result.stderr.strip()[:200]}); "
                           "rolled back immediately instead of leaving an unrevertable pending apply")


def cmd_confirm(args) -> int:
    root = eco_root()
    with switch_locks(root):
        state = load_state(root)
        record = state["txns"].get(args.txn)
        if record is None:
            raise SwitchError(f"no such txn {args.txn!r}")
        if record.get("status") == "rolled_back":
            raise SwitchError(f"txn {args.txn!r} was already rolled back; cannot confirm it")
        if record.get("status") == "verify_failed":
            raise SwitchError(f"txn {args.txn!r} failed its post-apply verify; cannot confirm it")
        if record.get("status") == "superseded":
            # A txn `recover` closed as superseded (round 5) never itself reached verify_pass with
            # confirm_target "confirm_pending" -- there is nothing pending_confirmation about it to
            # confirm, and it is not this component's current state either.
            raise SwitchError(f"txn {args.txn!r} was closed as superseded by a later change on its "
                               "component (see 'recover'); cannot confirm it")
        if record.get("status") == "in_progress":
            # Previously-unresolved finding: a crashed/interrupted apply never reached
            # verify_pass, so confirming it would mark a half-applied component "applied"
            # through the ledger without it ever having passed a post-apply verify -- and
            # cmd_recover only reconciles a txn still "in_progress", so it would then never see
            # this one again either. lifecycle.md: "A crashed or interrupted apply ... never
            # completes after the fact"; run `recover` (or `rollback --txn`), not `confirm`.
            raise SwitchError(f"txn {args.txn!r} is still in_progress (never reached a post-apply "
                               "verify); run 'recover' or 'rollback --txn' to reconcile it, not confirm")
        if any(entry.get("op") == "rollback:intent" for entry in record.get("ops") or []):
            # Minor finding (round 7): a rollback (manual, or the confirm-or-revert timer's own
            # `--if-unconfirmed` call) that got as far as writing `rollback:intent` before being
            # interrupted leaves this txn's status exactly where it was before that attempt began
            # -- only a completed `rollback:done` flips it to "rolled_back" (recompute_state), so
            # neither the "rolled_back" check above nor `recover` (which only ever revisits a txn
            # still "in_progress" -- a DIFFERENT, crashed-apply case, not this one) ever catches an
            # in-flight or interrupted rollback of a txn that had already reached applied/
            # pending_confirmation/verify_failed. The Busy message a stacked `apply` gets names
            # exactly this `confirm --txn` as one way to close an open transaction; confirming here
            # despite that unfinished, possibly half-reverted rollback would mark it "applied"
            # through the ledger alone, with no post-confirm verify of its own to catch it.
            raise SwitchError(f"txn {args.txn!r} has a rollback recorded against it that never "
                               "reached 'rollback:done' (an interrupted or in-flight `rollback`); "
                               "run 'rollback --txn' again to resume and finish reversing it before "
                               "confirming -- confirming now could record a half-reverted txn as applied")
        ledger = Ledger(root)
        ledger.append(txn=args.txn, op="txn_confirm", component=record.get("component"), surface="_txn", to="confirmed")
        # Minor finding (round 5): a best-effort stop of the now-irrelevant revert timer must
        # never fail a confirm that has already been recorded in the ledger -- suppress()
        # previously caught only SwitchError, so a subprocess.TimeoutExpired or an OSError (a
        # missing/misconfigured systemctl) still escaped uncaught here and made an already-
        # confirmed txn's own `confirm` command exit 1. If the timer does fire later regardless,
        # `rollback --txn ... --if-unconfirmed` is already a documented no-op against a confirmed
        # txn.
        with contextlib.suppress(SwitchError, subprocess.TimeoutExpired, OSError):
            run_captured([*systemctl_argv(), "--user", "stop", f"ecosystem-switch-revert-{args.txn}.timer"])
        save_state(root)
        print(json.dumps({"status": "confirmed", "txn": args.txn}))
        return 0


def _txn_sets_current_link(entries: list[dict]) -> bool:
    """Whether any of ``entries`` (a txn's own OPERATION_KINDS-filtered ledger entries) is a
    ``link`` whose surface names a component's ``current/<id>`` switch point -- the same
    predicate ``recompute_state`` uses to decide whether an entry updates a component's
    ``updated_txn``. The single source of truth both ``rollback_txn`` and ``cmd_rollback``'s own
    pre-check gate their "superseded" refusal on: a txn that never became its component's own
    current-link setter cannot have been superseded by one, whatever ``updated_txn`` currently
    names (minor finding; see rollback_txn's comment)."""
    return any(entry.get("op") == "link" and (entry.get("surface") or "").startswith("current/")
              for entry in entries)


# A txn in one of these statuses is still "standing" for its component: its own forward effect
# has not been reversed (rolled_back) or accepted-and-closed by recover's roll-forward
# (superseded), and it is not a non-transactional record (baseline/resync/prune all close
# immediately as "recorded", never reaching any of these) either -- applied and confirmed, applied
# but still awaiting a confirm-or-revert timer ("pending_confirmation", the coordinator's
# "unconfirmed"), or still open after a crash (in_progress).
STANDING_TXN_STATUSES = ("applied", "pending_confirmation", "in_progress")


def _txn_first_seq(ledger_entries: list[dict], txn: str, ops: tuple[str, ...]) -> int | None:
    """The seq of ``txn``'s own earliest ledger entry whose op is in ``ops``. Unlike
    state.json's ``last_seq`` (the MAX seq over every entry a txn ever accumulates, including a
    later confirm or rollback attempt on that SAME txn), this value never moves once ``ops``
    entries exist, so comparing it across two DIFFERENT txns for the same component gives a
    reliable creation order even after one of them has an interrupted or resumed rollback of its
    own -- last_seq would misreport that txn as "later" than one that actually applied afterward."""
    seqs = [e.get("seq") for e in ledger_entries
            if e.get("txn") == txn and e.get("op") in ops and e.get("seq") is not None]
    return min(seqs) if seqs else None


def _superseding_txn(root: Path, component_id: str, txn: str, own_entries: list[dict]) -> str | None:
    """Name of a later txn for ``component_id`` that ``rollback_txn``/``cmd_rollback`` must refuse
    to roll ``txn`` back underneath, or None when none exists.

    Coordinator decision (round 7, simple and safe): a later txn blocks ``txn``'s rollback
    whenever it is still STANDING (``STANDING_TXN_STATUSES``) -- full stop, regardless of what the
    live current/<id> link (or anything else on disk) happens to read right now, and regardless of
    whether that later txn itself ever touched current/<id>. "Later" is ``txn``'s own earliest
    forward (``OPERATION_KINDS``) ledger entry versus the candidate's: ledger order and recorded
    status, never a value read off the filesystem. The operator must roll back every later
    standing txn first, newest first, before an earlier one is reachable again (see
    test_rollback_by_txn_succeeds_after_the_apply_that_superseded_it_was_itself_rolled_back and the
    A-B-A tests next to it).

    Round 6 read the live current/<id> link directly and accepted it as proof ``txn`` was not
    superseded whenever it merely matched ``txn``'s OWN recorded ``to``/``from`` -- fine for two
    txns, but blind to a THIRD, still-standing txn whose own value coincidentally lands back on
    one of those same two (an A-B-A history: v1->v2, v2->v3, v3->v2 again): the live read matched
    ``txn``'s own ``to`` again by coincidence, this returned None, and ``rollback --txn`` on the
    OLDEST of the three exited 0 and clobbered the still-applied newest one (round 7 major finding).
    Ledger identity, order and recorded status can't be fooled by a value coincidence like that.

    A ``resync`` is a separate case: not reversible, and recompute_state always closes it
    "recorded" immediately (never one of ``STANDING_TXN_STATUSES``), but it is a deliberate,
    permanent, out-of-band acceptance the operator named explicitly (see cmd_adopt's ``--resync``
    branch) -- round 4 intended it to go on superseding an older txn's rollback forever, which a
    bare status-set membership test would otherwise silently drop. Checked the same way (ledger
    order only, never a live value) so it cannot reopen the same coincidence bug for resync."""
    ledger_entries = Ledger(root).all()
    own_seq = _txn_first_seq(ledger_entries, txn, OPERATION_KINDS)
    if own_seq is None:
        return None
    later: list[tuple[int, str]] = []
    for other_txn, record in load_state(root)["txns"].items():
        if other_txn == txn or record.get("component") != component_id:
            continue
        if record.get("status") in STANDING_TXN_STATUSES:
            other_seq = _txn_first_seq(ledger_entries, other_txn, OPERATION_KINDS)
        elif any(e.get("op") == "resync" for e in record.get("ops") or []):
            other_seq = _txn_first_seq(ledger_entries, other_txn, ("resync",))
        else:
            continue
        if other_seq is not None and other_seq > own_seq:
            later.append((other_seq, other_txn))
    if not later:
        return None
    later.sort()
    return later[-1][1]


def _link_reversal_issue(root: Path, entry: dict) -> str | None:
    """None when reversing this ``link`` entry right now is safe; otherwise the refusal message.
    A relaxed compare-and-swap (round 5, relaxed round 6): the live target must equal either what
    this operation last set it to (``to``, not yet reversed) or what reversing it would restore
    (``from``, already reversed -- an earlier interrupted attempt, or a second redundant call).
    Split out (round 7) so ``rollback_txn``'s all-entries pre-check can ask the same question for
    every link entry before mutating any of them, not just the one about to be reversed."""
    live_target = read_link_target(root / entry["surface"])
    if live_target != entry.get("to") and live_target != entry.get("from"):
        return (f"refusing to roll back {entry['surface']}: its current target ({live_target!r}) "
                f"no longer matches what this operation last set it to ({entry.get('to')!r}) or "
                f"what rolling it back would restore ({entry.get('from')!r}); something else "
                "changed it since (e.g. an out-of-band relink/bootstrap) -- investigate and "
                "resync/fix it by hand before rolling back")
    return None


def rollback_txn(root: Path, txn: str) -> list[str]:
    """Reverse every operation ``txn`` recorded, in reverse-chronological order, and return a
    list of problems encountered (empty means a clean rollback). ``unit-restart`` entries are
    reversed only *after* every other kind (link/text-replace/file-write/data-backup): a service
    must be restarted against its already-reverted root, never restarted first while
    current/<id> still points at the new one, or it ends up running the new build with the link
    pointing at the old one. The unit-restart health probe compares against the matching
    ``link`` entry's own recorded ``from`` (the real old root), not the unit-restart entry's own
    ``from`` (that field is the pre-restart MainPID, not a root path, and can never match).

    Coordinator decision (round 6): rollback is idempotent and resumable, so this same function is
    also how `recover` resumes an interrupted rollback (see cmd_recover), and how a second,
    redundant `rollback` call on an already-rolled-back txn becomes a clean no-op instead of an
    error. Writes a ``rollback:intent`` marker first, then -- for each forward entry, in reverse
    order -- skips one a matching ``rollback:<op>`` ledger entry already reverses (an earlier
    attempt got that far before being interrupted, or already finished), and treats a live target
    that already matches what reversing this entry would restore as "already reverted", not drift
    (a relaxed compare-and-swap: see ``_refuse_if_drifted_since_write`` above and the ``link``
    branch below). Only a live value matching NEITHER this entry's own forward nor reverted state
    is still refused as unexplained drift.

    Residual of round 6's major, closed round 7: current/<id> is always a relink's FIRST forward
    entry (build_apply_plan/cmd_adopt), so it was always reversed LAST here -- an all-entries
    pre-check now asks every not-yet-reversed link/text-replace/file-write entry's own drift
    question (``_link_reversal_issue``/``_write_reversal_issue``) up front, before touching
    anything, so a doomed rollback (its current/<id> link's own CAS would refuse) is refused
    whole, never leaving entrypoints or surfaces already reversed while current/<id> alone was
    left drifted and unreachable except by hand."""
    ledger = Ledger(root)
    entries = [entry for entry in ledger.for_txn(txn) if entry.get("op") in OPERATION_KINDS]
    # Previously-unresolved finding: cmd_rollback's own "superseded" pre-check (below, for a
    # manual `rollback --txn`) never protected cmd_recover, which -- reconciling any txn still
    # in_progress after a crash -- calls this function directly, with no chance for that
    # caller-side check to run first. Duplicating the same rule here is what actually protects
    # every caller: re-pointing current/<id> back to this txn's old root after a *later*,
    # already-applied txn on the same component has since moved it on would silently clobber
    # that later apply. Safe for apply's own automatic rollback too: that call always targets the
    # txn it just began, and build_apply_plan always includes exactly one "link" step, so by the
    # time a post-apply verify can fail, this txn is necessarily still its component's own
    # updated_txn.
    component_ids = {entry.get("component") for entry in entries if entry.get("component")}
    # Minor finding: this used to run whenever exactly one component was touched, even when this
    # txn itself never became that component's own "current" setter (recompute_state only updates
    # updated_txn from a link/resync/baseline entry whose surface starts with "current/"). Two
    # concrete cases: a relink that fails partway *after* current/<id> already existed (so this
    # txn only links entrypoints/surfaces, never current/<id> itself -- relink links it only when
    # absent), and an apply that fails at a data-backup step before its own link step ever runs.
    # In both, updated_txn still names whatever EARLIER txn last set current/<id>, and the old
    # unconditional check misread that as "a later txn already moved it on", permanently refusing
    # recover/rollback and leaving the txn in_progress forever. Gated on whether this txn's own
    # entries actually include a current/<id>-setting "link" (the only OPERATION_KINDS member that
    # can be one; resync/baseline are not reversible and never reach `entries`): only then can a
    # different current updated_txn mean a genuinely later change this rollback would clobber.
    if len(component_ids) == 1 and _txn_sets_current_link(entries):
        (component_id,) = component_ids
        superseding_txn = _superseding_txn(root, component_id, txn, entries)
        if superseding_txn is not None:
            raise SwitchError(f"txn {txn!r} is no longer the latest change to component {component_id!r} "
                               f"(a later txn {superseding_txn!r} already moved it on); refusing to roll "
                               "back a superseded txn and clobber that later apply")
    # Coordinator decision (round 6): write the rollback-intent marker before touching anything, so
    # the ledger itself records that a reversal of this txn began (an audit trail across a possible
    # interruption below) -- inert for recompute_state's own "current"/status derivation: surface
    # "_txn_start" never starts with "current/", and this op is explicitly excluded from the
    # "already reversed" scan a few lines down and from the terminal-status check in
    # recompute_state, both of which look only for "_txn_end".
    ledger.append(txn=txn, op="rollback:intent", component=next(iter(component_ids), None), surface="_txn_start")
    problems: list[str] = []
    component = None
    backup_dir = root / "switch" / "backups" / txn
    link_from_by_component: dict[str, str | None] = {
        entry.get("component"): entry.get("from") for entry in entries if entry.get("op") == "link"
    }
    non_restart_entries = [entry for entry in entries if entry.get("op") != "unit-restart"]
    unit_restart_entries = [entry for entry in entries if entry.get("op") == "unit-restart"]
    # Coordinator decision (round 6): (bare forward op, surface) pairs an earlier rollback_txn call
    # already reversed and ledgered -- read fresh from the ledger (not carried in memory), so a
    # resumed process (after being killed mid-loop) or a second, redundant call sees exactly what
    # an earlier attempt already finished and skips it, rather than reversing it again or (for
    # link/text-replace/file-write, whose reversal below now also tolerates a live value that
    # already matches it) raising on what would otherwise look like drift. unit-restart's own
    # soft-failed reversal (``rollback:<op>-failed``) also counts as "already handled": retrying a
    # restart that already failed once is not this resumability fix's job -- but (round 7 minor
    # finding) a resumed/redundant call must still re-surface that outstanding failure in
    # ``problems`` rather than silently reporting a clean result, so ``already_reversed_failed``
    # keeps track of exactly which already-handled keys were a soft failure, not a success.
    already_reversed: set[tuple[str, str | None]] = set()
    already_reversed_failed: set[tuple[str, str | None]] = set()
    for candidate in ledger.for_txn(txn):
        candidate_op = candidate.get("op")
        if (not isinstance(candidate_op, str) or not candidate_op.startswith("rollback:")
                or candidate_op in ("rollback:done", "rollback:intent")):
            continue
        bare_op = candidate_op[len("rollback:"):]
        failed = bare_op.endswith("-failed")
        if failed:
            bare_op = bare_op[: -len("-failed")]
        key = (bare_op, candidate.get("surface"))
        already_reversed.add(key)
        if failed:
            already_reversed_failed.add(key)
    # Residual of round 6's major, closed round 7: current/<id> is always a relink's FIRST forward
    # entry (see build_apply_plan/cmd_adopt), so its own reversal -- below -- always runs LAST,
    # after every entrypoint/surface reversal has already mutated and ledgered its own change.
    # Without this pre-check, a drifted current/<id> (out-of-band, or a resync accepted in the
    # meantime) used to only be caught by that LAST reversal's own CAS, leaving every entry ordered
    # before it already reversed -- a permanently half-migrated component the "resync/fix it by
    # hand" advice could never actually finish reversing (a resync makes it superseded; a
    # superseded txn is never physically touched again). Asks every not-yet-reversed link/
    # text-replace/file-write entry's own drift question up front, before mutating any of them, so
    # a doomed rollback refuses whole instead of partway. data-backup/data-restore and unit-restart
    # (deliberately reversed last, and not a value-drift question in the same sense -- see below)
    # are unaffected.
    precheck_issues: list[str] = []
    for entry in non_restart_entries:
        if (entry.get("op"), entry.get("surface")) in already_reversed:
            continue
        if entry.get("op") == "link":
            issue = _link_reversal_issue(root, entry)
        elif entry.get("op") in ("text-replace", "file-write"):
            issue = _write_reversal_issue(resolve_surface_path(root, entry["surface"]), entry)
        else:
            issue = None
        if issue:
            precheck_issues.append(issue)
    if precheck_issues:
        if len(precheck_issues) == 1:
            raise SwitchError(precheck_issues[0])
        raise SwitchError(
            f"refusing to roll back txn {txn!r}: {len(precheck_issues)} of its own operations can "
            "no longer be safely reversed without leaving it half-reversed -- " + " | ".join(precheck_issues))
    for entry in reversed(non_restart_entries):
        component = entry.get("component")
        if (entry.get("op"), entry.get("surface")) in already_reversed:
            continue
        if entry.get("op") == "link":
            # Minor finding (round 5): every other reversible kind has a compare-and-swap
            # precondition before rollback overwrites it -- text-replace/file-write's
            # _refuse_if_drifted_since_write above, apply's own forward-path drift_issue -- but a
            # link's reversal used to re-point current/<id> or bin/* straight to the recorded
            # "from" with no check that the live target still equals what this same entry last set
            # it to. An out-of-band repoint since (e.g. a plain, unguarded bootstrap-linux.sh
            # re-run's bare `ln -sfn`, before a stale relink/apply txn is recovered) would then be
            # silently overwritten rather than refused, the "drift ⇒ refuse" rule the brief
            # requires for every operation kind, unaddressed for links specifically until now.
            # Round 6: also accepts the live target already equalling ``from`` (this entry's own
            # reversed value) as "already reverted", not drift -- the already_reversed ledger scan
            # above usually catches this case first, but only once its own rollback:link entry
            # made it out; a crash between op_link's own write and that append still leaves the
            # live symlink already correct with no ledger record yet, and re-running op_link
            # against a target it already names is a safe, verified no-op. The pre-check above
            # already proved this exact condition holds for every entry reaching this loop, so this
            # re-check is only ever hit if something changes the live target in the narrow window
            # between the pre-check and this entry's own turn (e.g. a concurrent process outside
            # this tool's own flock) -- kept as the real, still-authoritative guard either way.
            issue = _link_reversal_issue(root, entry)
            if issue:
                raise SwitchError(issue)
            if entry.get("from") is not None:
                fields, _inverse = op_link(root, entry["surface"], entry["from"])
            else:
                # The surface did not exist (or was not a symlink) before this op created it:
                # its inverse is removal, not "point it nowhere" (op_link has no such mode).
                link_path = root / entry["surface"]
                if link_path.is_symlink():
                    link_path.unlink()
                fields = {"from": entry.get("to"), "to": None}
        elif entry.get("op") == "text-replace":
            spec_inverse = {"kind": "text-replace", "surface": entry["surface"], "old": entry["to"], "new": entry["from"],
                            "restore_from_backup": entry.get("backup")}
            apply_inverse(root, entry, spec_inverse, backup_dir=backup_dir)
            fields = {"from": entry["to"], "to": entry["from"]}
        elif entry.get("op") == "file-write":
            spec_inverse = {"kind": "file-write", "surface": entry["surface"], "restore_from_backup": entry.get("backup"),
                            "remove_if_no_backup": entry.get("backup") is None}
            apply_inverse(root, entry, spec_inverse, backup_dir=backup_dir)
            fields = {"from": entry["to"], "to": entry["from"]}
        elif entry.get("op") == "data-backup":
            fields, _inverse = op_data_restore(root, entry["from"], entry["backup"])
        else:
            fields = {"from": entry.get("to"), "to": entry.get("from")}
        ledger.append(txn=txn, op=f"rollback:{entry.get('op')}", component=component, surface=entry.get("surface"),
                      rollback_class=entry.get("rollback_class"), **(fields or {}))
    for entry in reversed(unit_restart_entries):
        component = entry.get("component")
        key = (entry.get("op"), entry.get("surface"))
        if key in already_reversed:
            if key in already_reversed_failed:
                # Minor finding (round 7): an earlier attempt's soft-failed restart used to be
                # skipped here exactly like a success, so a resumed/redundant rollback (or
                # `recover`) reported a clean result even though that unit never actually came
                # back on its old root. Re-surfacing it keeps the outstanding problem visible on
                # every subsequent call until an operator actually fixes and restarts it by hand
                # (this function never retries a restart that already failed once).
                problems.append(f"{entry.get('surface')}: a previous rollback attempt already "
                                 "recorded a failed restart for this unit; it was not retried")
            continue
        expected_root = link_from_by_component.get(component) or ""
        try:
            fields, _inverse = op_unit_restart(entry["surface"], window_component_ok=True, expected_root=expected_root)
            op_name = "rollback:unit-restart"
        except SwitchError as error:
            fields = {"from": entry.get("to"), "to": entry.get("from")}
            op_name = "rollback:unit-restart-failed"
            problems.append(f"{entry.get('surface')}: {error}")
        ledger.append(txn=txn, op=op_name, component=component, surface=entry.get("surface"),
                      rollback_class=entry.get("rollback_class"), **fields)
    ledger.append(txn=txn, op="rollback:done", component=component, surface="_txn_end", to="rolled_back")
    save_state(root)
    return problems


def close_superseded_txn(root: Path, txn: str) -> bool:
    """True (and closes ``txn`` with a terminal "superseded" ledger entry, touching nothing else)
    when ``txn`` is provably superseded by a later txn that already became its component's own
    updated_txn -- the same underlying signal ``_superseding_txn`` (used by ``rollback_txn``/
    ``cmd_rollback`` to REFUSE a manual rollback of a superseded txn) derives from the live link
    directly, reused here by ``cmd_recover`` to instead CLOSE one automatically. Reads
    ``updated_txn`` itself rather than calling ``_superseding_txn``: this only ever runs against a
    txn that crashed before its own post-apply verify, so it was never itself authoritative and has
    no confirmed live state of its own to compare a live link against the way a txn being manually
    rolled back always does (each op is ledgered only after it runs, never write-ahead, so
    ``updated_txn`` here can only ever name a later change that already finished being ledgered
    itself). False (the caller should fall back to a normal ``rollback_txn`` reversal) when ``txn``
    never set a current/<id> link at all, or nothing later has superseded it -- the ordinary
    crash-recovery case, unaffected by this function.

    Coordinator decision on the txn state machine (round 5): recover must be able to close every
    in_progress txn it can prove superseded (roll FORWARD: accept the later, already-verified
    state as authoritative, matching what a fresh ``adopt --relink``/``apply`` would already
    observe as "current" -- never physically reverse a superseded txn's own operations, which would
    silently clobber the later one) or abandoned (roll BACK: the ordinary case, handled by the
    caller's own ``rollback_txn`` fallback). Before this existed, ``recover`` could only refuse a
    superseded in_progress txn (reporting it as a problem, never closing it) -- and since nothing
    else ever transitions a txn out of "in_progress" except a rollback, that refusal left the txn
    permanently stuck, which in turn left ``open_txn_for_component``'s guard permanently refusing
    every later `apply`/`adopt --relink` on that component (the exact major-finding regression this
    function exists to close: a safety fix, at-most-one-open-txn, that had turned into a permanent
    denial-of-service against the very component it was protecting)."""
    entries = [entry for entry in Ledger(root).for_txn(txn) if entry.get("op") in OPERATION_KINDS]
    component_ids = {entry.get("component") for entry in entries if entry.get("component")}
    if len(component_ids) != 1 or not _txn_sets_current_link(entries):
        return False
    (component_id,) = component_ids
    superseding_txn = (load_state(root)["components"].get(component_id) or {}).get("updated_txn")
    if superseding_txn in (None, txn):
        return False
    superseded_fields = {"from": superseding_txn, "to": "superseded"}
    Ledger(root).append(txn=txn, op="recover:superseded", component=component_id, surface="_txn_end",
                        **superseded_fields)
    save_state(root)
    return True


def cmd_rollback(args) -> int:
    root = eco_root()
    with switch_locks(root):
        ledger = Ledger(root)
        state = load_state(root)
        if args.txn:
            txn = args.txn
        else:
            # Minor finding (round 7): last_seq (state.json) is the MAX seq over EVERY entry a txn
            # ever accumulates, including its own later rollback:* attempts -- so a txn already
            # rolled back (or merely refused partway, e.g. on drift, which still ledgers a
            # rollback:intent) could out-rank a genuinely more recent, still-standing apply here,
            # just because ITS OWN rollback attempt happened to be ledgered after that other apply
            # ran, and this had no status filter at all (a rolled_back/superseded txn was still a
            # "candidate"). Restricted to STANDING txns (the same set _superseding_txn treats as a
            # real, not-yet-reversed change) and ordered by each candidate's own earliest forward
            # entry (_txn_first_seq), which a later attempt on that SAME txn can never move forward.
            ledger_entries = ledger.all()
            candidates = [(_txn_first_seq(ledger_entries, t, OPERATION_KINDS), t)
                          for t, record in state["txns"].items()
                          if record.get("component") == args.component
                          and record.get("status") in STANDING_TXN_STATUSES
                          and any(e.get("op") in OPERATION_KINDS for e in record.get("ops") or [])]
            candidates = [(seq, t) for seq, t in candidates if seq is not None]
            if not candidates:
                raise SwitchError(f"no reversible txn recorded for component {args.component!r}")
            txn = max(candidates)[1]  # highest opening seq, i.e. most recently applied
        record = state["txns"].get(txn, {})
        if args.if_unconfirmed and record.get("status") == "applied":
            print(json.dumps({"status": "already_confirmed", "txn": txn}))
            return 0
        if record.get("status") == "rolled_back":
            print(json.dumps({"status": "already_rolled_back", "txn": txn}))
            return 0
        if record.get("status") == "superseded":
            # Same terminal outcome the generic superseded-refusal check below would reach anyway
            # (a superseded txn's own updated_txn never names it) -- reported directly here for a
            # clean, non-error result, the same courtesy already_rolled_back/already_confirmed get,
            # since `recover` closing a txn this way (round 5) is itself a normal outcome, not a
            # user mistake to refuse with an error exit.
            print(json.dumps({"status": "already_superseded", "txn": txn}))
            return 0
        txn_entries = [entry for entry in ledger.for_txn(txn) if entry.get("op") in OPERATION_KINDS]
        if not txn_entries:
            raise SwitchError(f"txn {txn!r} has no reversible operations (e.g. a baseline/resync/prune "
                               "record); nothing to roll back")
        component_id = record.get("component")
        # Minor finding: this used to fire whenever *any* other txn had since become the
        # component's updated_txn, even one this txn never was itself (e.g. a relink that fails
        # partway after current/<id> already existed, or an apply that fails before its own link
        # step) -- see rollback_txn's matching gate and _txn_sets_current_link for the full
        # reasoning; both pre-checks must agree, since cmd_recover calls rollback_txn directly and
        # never goes through this one.
        if component_id and _txn_sets_current_link(txn_entries):
            superseding_txn = _superseding_txn(root, component_id, txn, txn_entries)
            if superseding_txn is not None:
                raise SwitchError(f"txn {txn!r} is no longer the latest change to component {component_id!r} "
                                   f"(a later txn {superseding_txn!r} already moved it on); refusing to roll "
                                   "back a superseded txn and clobber that later apply")
        problems = rollback_txn(root, txn)
        payload = {"status": "rolled_back", "txn": txn}
        if problems:
            payload["problems"] = problems
        print(json.dumps(payload))
        return 0 if not problems else 1


def verify_component(root: Path, component_id: str, spec: dict) -> str | None:
    """None when the component's live current_link target resolves and still matches what the
    ledger last recorded for it (the same comparison ``drift_issue`` makes before an ``apply``):
    a live root that no longer matches the ledger is exactly the case this must report. Used
    both by apply's automatic post-check and by the standalone `verify` command.

    Also checks every entrypoints[] symlink still routes THROUGH current/<id>, not merely that
    current/<id> itself still matches the ledger (minor finding): a plain (no --no-link/--link-dir)
    bootstrap-linux.sh re-run, or a manual `ln -sfn`, repoints bin/* straight back at
    tools/<name>-<version> and silently undoes adopt --relink's indirection -- current/<id> still
    flips correctly on the next apply and this function used to report "ok" throughout, while
    bin/* kept running whatever build it was last pointed at directly, unrelated to current/<id>.

    Only checks an entrypoint that also declares ``in_root`` (minor finding, round 4): `adopt
    --relink`'s own repoint loop only ever migrates an entrypoint that has both `bin` and
    `in_root` (an `in_root`-less entry is intentionally left wherever it already points,
    unmanaged) -- requiring `bin` alone here used to demand every such unmanaged entrypoint also
    route through current/<id>, which relink itself would never arrange, so a component mixing a
    managed and an unmanaged entrypoint failed this check (and any apply's own post-apply verify,
    costing a real unit-restart and its automatic rollback) forever on the unmanaged one, however
    correctly the managed one was routed."""
    entry = component_entry(spec, component_id)
    current_link = entry.get("current_link")
    if current_link:
        target = root / current_link
        if not target.exists():
            return f"{current_link} does not resolve to an existing path"
        drift = drift_issue(root, component_id, entry)
        if drift:
            return drift
        current_link_prefix = str(target) + os.sep
        for entrypoint in entry.get("entrypoints") or []:
            if not (isinstance(entrypoint, dict) and entrypoint.get("bin") and entrypoint.get("in_root")):
                continue
            bin_surface = entrypoint["bin"]
            live_target = read_link_target(root / bin_surface)
            if live_target is None:
                return f"{bin_surface} is not a symlink (expected it to route through {current_link})"
            if not (live_target == str(target) or live_target.startswith(current_link_prefix)):
                return (f"{bin_surface} resolves to {live_target!r}, not through {current_link} -- "
                        "adopt --relink's indirection was undone (e.g. by a plain bootstrap-linux.sh "
                        "re-run without --no-link/--link-dir, or a manual ln -sfn)")
    return None


def cmd_verify(args) -> int:
    root = eco_root()
    spec = load_spec(root, args.spec)
    components = [args.component] if args.component else list((spec.get("components") or {}).keys())
    report = {}
    ok = True
    for component_id in components:
        issue = None
        try:
            issue = verify_component(root, component_id, spec)
        except SwitchError as error:
            issue = str(error)
        report[component_id] = {"ok": issue is None, "issue": issue}
        ok = ok and issue is None
    ledger_problems = Ledger(root).verify_chain()
    report["_ledger"] = {"ok": not ledger_problems, "issues": ledger_problems}
    ok = ok and not ledger_problems
    if args.json:
        print(json.dumps(report, sort_keys=True))
    else:
        for component_id, result in report.items():
            print(f"{component_id}: {'ok' if result.get('ok') else 'FAIL ' + str(result.get('issue') or result.get('issues'))}")
    return 0 if ok else 1


def cmd_status(args) -> int:
    root = eco_root()
    state = load_state(root)
    if args.component:
        result = {args.component: state["components"].get(args.component, {"current": None})}
    else:
        result = state["components"]
    if args.json:
        print(json.dumps({"components": result, "txns": state["txns"]}, sort_keys=True))
    else:
        for component_id, info in sorted(result.items()):
            print(f"{component_id}: current={info.get('current')} rollback_class={info.get('rollback_class')}")
    return 0


def cmd_recover(args) -> int:
    """Reconcile every txn a crash left unfinished: each one must reach a terminal status, never
    stay stuck. Two DIFFERENT crash shapes, not one -- a previously-unresolved finding this round
    separates rather than conflating (see the second branch below): a crash mid-apply/mid-relink
    (the txn never reached its own post-apply verify, so recompute_state leaves it "in_progress"),
    or a crash mid-rollback of one that HAD already reached applied/pending_confirmation/
    verify_failed (a manual `rollback`, or the confirm-or-revert timer's own `--if-unconfirmed`
    call, interrupted before its own `rollback:done` -- recompute_state leaves THAT status exactly
    where it was, never "in_progress", since only `rollback:done` is a terminal-status entry).

    Coordinator decision on the txn state machine (round 5): an in_progress txn (the first shape)
    is closed either by rolling it BACK (the ordinary case -- nothing later touched its component,
    so reverse it exactly as a manual `rollback` would) or, when a later txn already became the
    component's own updated_txn (provable from the ledger's own recorded entries -- each op is
    ledgered only after it runs, never write-ahead, so this can only see a later change that
    already finished being ledgered itself; a check that agrees with rollback_txn/cmd_rollback's
    own for every txn this function ever evaluates, though it is not the identical code: see
    close_superseded_txn), by rolling FORWARD -- closing it as `superseded` without touching
    anything, since a physical reversal at that point would clobber the later, already-verified
    apply/relink. Before this split existed, the superseded case was only ever refused (never
    closed), which left the txn in_progress forever and, with it, `open_txn_for_component`'s guard
    permanently refusing every later `apply`/`adopt --relink` on that component -- the major-finding
    regression this closes. Never 'completes' an interrupted apply/relink as if it had itself
    succeeded, either way.

    Coordinator decision (round 6): the ordinary "roll it BACK" branch above calls rollback_txn,
    which is now itself idempotent and resumable -- so an in_progress txn whose OWN rollback was
    previously interrupted (a crashed `rollback`/`recover` process, not a crashed apply) is resumed
    the same way here, picking up from whichever of its forward entries the ledger already shows
    reversed instead of refusing on what used to look like drift."""
    root = eco_root()
    with switch_locks(root):
        state = load_state(root)
        recovered = []
        superseded = []
        rollback_problems: list[str] = []
        for txn, record in state["txns"].items():
            has_incomplete_rollback = record.get("status") != "rolled_back" and any(
                entry.get("op") == "rollback:intent" for entry in record.get("ops") or [])
            if record.get("status") == "in_progress":
                try:
                    # Never attempt close_superseded_txn once THIS txn's own rollback has already
                    # started (round 7): that function's whole premise is a txn that crashed before
                    # its own post-apply verify ever ran and has no partial reversal of its own to
                    # protect -- no longer true once even one of ITS forward entries may already be
                    # physically reversed, which "closing as superseded without touching anything"
                    # would then misdescribe.
                    if not has_incomplete_rollback and close_superseded_txn(root, txn):
                        superseded.append(txn)
                    else:
                        rollback_problems.extend(rollback_txn(root, txn))
                        recovered.append(txn)
                except SwitchError as error:
                    # Neither branch above is expected to raise in practice (close_superseded_txn
                    # never touches a live surface, and a txn that is not superseded has already
                    # been proven safe to reverse) -- kept as a last-resort safety net, the same as
                    # before this split: report it and keep reconciling every other in_progress txn
                    # in this run instead of aborting the whole recover on the first problem.
                    rollback_problems.append(f"{txn}: {error}")
            elif has_incomplete_rollback:
                # Previously-unresolved finding (round 7): the second crash shape above -- this txn
                # itself is applied/pending_confirmation/verify_failed, not in_progress, so the
                # branch above never visits it at all, and it silently stayed half-reverted forever
                # (docs used to claim recover reconciles a crash "mid-rollback" unconditionally,
                # which was never true for this shape). rollback_txn's own resumability finishes it
                # the same idempotent way a repeated manual `rollback --txn` would.
                try:
                    rollback_problems.extend(rollback_txn(root, txn))
                    recovered.append(txn)
                except SwitchError as error:
                    rollback_problems.append(f"{txn}: {error}")
        problems = Ledger(root).verify_chain()
        print(json.dumps({"recovered_txns": recovered, "superseded_txns": superseded,
                          "ledger_chain_ok": not problems, "ledger_problems": problems,
                          "rollback_problems": rollback_problems}))
        return 0 if not problems and not rollback_problems else 1


def cmd_write_installed_versions(args) -> int:
    root = eco_root()
    with switch_locks(root):
        state = load_state(root)
        lines = [f"ecosystem-switch state at {now_utc_iso()}"]
        for component_id, info in sorted(state["components"].items()):
            current = info.get("current")
            version_guess = Path(current).name if current else None
