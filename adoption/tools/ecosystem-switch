def cmd_recover(args) -> int:
    """Reconcile any txn left in_progress (a crash mid-apply): roll it back rather than
    leaving a half-applied component. Never 'completes' an interrupted apply."""
    root = eco_root()
    with switch_locks(root):
        state = load_state(root)
        recovered = []
        rollback_problems: list[str] = []
        for txn, record in state["txns"].items():
            if record.get("status") == "in_progress":
                try:
                    rollback_problems.extend(rollback_txn(root, txn))
                    recovered.append(txn)
                except SwitchError as error:
                    # rollback_txn's own superseded-txn refusal (a later, already-applied txn on
                    # the same component moved it on since this one crashed): report it and keep
                    # reconciling every other in_progress txn in this run instead of aborting the
                    # whole recover on the first one that is unsafe to blindly reverse.
                    rollback_problems.append(f"{txn}: {error}")
        problems = Ledger(root).verify_chain()
        print(json.dumps({"recovered_txns": recovered, "ledger_chain_ok": not problems, "ledger_problems": problems,
                          "rollback_problems": rollback_problems}))
        return 0 if not problems and not rollback_problems else 1


def cmd_write_installed_versions(args) -> int:
